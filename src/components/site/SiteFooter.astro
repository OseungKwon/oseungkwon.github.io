---
interface Props {
  container?: 'default' | 'wide';
}

const { container = 'default' } = Astro.props;
const BASE = import.meta.env.BASE_URL;
---

<!-- 본문과 같은 폭에 맞춰 저작권은 왼쪽, 구독 링크는 오른쪽 끝에 둔다. -->
<footer class="border-t border-token-primary bg-token-secondary">
  <div
    class:list={[
      'mx-auto flex w-full items-center justify-between gap-4 px-4 py-6 text-[13px] text-token-tertiary sm:px-6 lg:px-8',
      container === 'wide' ? 'max-w-6xl' : 'max-w-5xl',
    ]}
  >
    <p>&copy; {new Date().getFullYear()} 오승의 기술블로그</p>
    <a
      href={`${BASE}rss.xml`}
      class="-mr-2 inline-flex items-center gap-1.5 rounded-full px-2 py-1 font-semibold text-token-secondary transition-colors hover:bg-token-hover hover:text-token-link"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="6" cy="18" r="2.2"></circle>
        <path d="M4 10.5a9.5 9.5 0 0 1 9.5 9.5h-2.6A6.9 6.9 0 0 0 4 13.1z"></path>
        <path d="M4 4.5A15.5 15.5 0 0 1 19.5 20h-2.6A12.9 12.9 0 0 0 4 7.1z"></path>
      </svg>
      RSS 구독
    </a>
  </div>
</footer>
