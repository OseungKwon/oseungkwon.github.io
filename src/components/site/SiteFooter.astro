---
const BASE = import.meta.env.BASE_URL;
---

<footer class="border-t border-token-primary bg-token-secondary py-8 text-center text-sm text-token-tertiary">
  <a
    href={`${BASE}rss.xml`}
    class="press mb-3 inline-flex items-center gap-1.5 rounded-full border border-token-primary px-3 py-1.5 font-mono text-xs font-semibold text-token-secondary transition-colors hover:border-token-accent hover:text-token-link"
  >
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="6" cy="18" r="2.2"></circle>
      <path d="M4 10.5a9.5 9.5 0 0 1 9.5 9.5h-2.6A6.9 6.9 0 0 0 4 13.1z"></path>
      <path d="M4 4.5A15.5 15.5 0 0 1 19.5 20h-2.6A12.9 12.9 0 0 0 4 7.1z"></path>
    </svg>
    RSS
  </a>
  <p>&copy; {new Date().getFullYear()} 오승의 기술블로그. All rights reserved.</p>
</footer>
