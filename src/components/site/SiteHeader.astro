---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  container?: 'default' | 'wide';
}

const { container = 'default' } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/$/, '');
const base = BASE.replace(/\/$/, '');
const isHome = path === base;
const isTags = path === `${base}/tags` || path.startsWith(`${base}/tags/`);
const isAlgorithm = path === `${base}/algorithm` || path.startsWith(`${base}/algorithm/`);
const isAbout = path === `${base}/about`;
---

<header class:list={['sticky z-50 mx-auto w-full px-4 sm:px-6 lg:px-8 top-3 sm:top-4', container === 'wide' ? 'max-w-6xl' : 'max-w-5xl']}>
  <nav class="surface vt-navbar flex items-center justify-between gap-2 rounded-full py-2 pr-2 pl-3.5 sm:gap-3 sm:pl-6">
    <a href={BASE} class="flex items-center gap-2 text-token-primary" aria-label="오승의 기술블로그 홈">
      <svg class="h-[22px] w-[22px] shrink-0" viewBox="0 0 128 128" aria-hidden="true">
        <defs>
          <linearGradient id="hdr-mark" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3d97ff"></stop>
            <stop offset="1" stop-color="#006fff"></stop>
          </linearGradient>
          <clipPath id="hdr-round">
            <rect width="128" height="128" rx="30"></rect>
          </clipPath>
        </defs>
        <g clip-path="url(#hdr-round)">
          <rect width="128" height="128" fill="url(#hdr-mark)"></rect>
          <path d="M0 0 H128 V60 Q66 28 0 72 Z" fill="#fff" opacity="0.2"></path>
        </g>
      </svg>
      <span class="hidden text-[15px] font-semibold tracking-tight min-[520px]:inline sm:text-base"> 오승의 기술블로그 </span>
    </a>

    <div class="flex items-center gap-0.5 sm:gap-1">
      <div class="flex items-center gap-0.5 sm:gap-1">
        <a
          href={BASE}
          aria-current={isHome ? 'page' : undefined}
          class:list={[
            'relative isolate whitespace-nowrap rounded-full px-2 py-2 text-[13px] font-semibold transition-colors sm:px-3.5 sm:text-sm',
            isHome ? 'text-token-link' : 'text-token-nav hover:bg-token-hover hover:text-token-primary',
          ]}
        >
          {isHome && <span class="nav-pill-bg" aria-hidden="true" />}홈
        </a>
        <a
          href={`${BASE}tags/`}
          aria-current={isTags ? 'page' : undefined}
          class:list={[
            'relative isolate whitespace-nowrap rounded-full px-2 py-2 text-[13px] font-semibold transition-colors sm:px-3.5 sm:text-sm',
            isTags ? 'text-token-link' : 'text-token-nav hover:bg-token-hover hover:text-token-primary',
          ]}
        >
          {isTags && <span class="nav-pill-bg" aria-hidden="true" />}
          주제
        </a>
        <a
          href={`${BASE}algorithm/`}
          aria-current={isAlgorithm ? 'page' : undefined}
          class:list={[
            'relative isolate whitespace-nowrap rounded-full px-2 py-2 text-[13px] font-semibold transition-colors sm:px-3.5 sm:text-sm',
            isAlgorithm ? 'text-token-link' : 'text-token-nav hover:bg-token-hover hover:text-token-primary',
          ]}
        >
          {isAlgorithm && <span class="nav-pill-bg" aria-hidden="true" />}
          알고리즘
        </a>
        <a
          href={`${BASE}about/`}
          aria-current={isAbout ? 'page' : undefined}
          class:list={[
            'relative isolate whitespace-nowrap rounded-full px-2 py-2 text-[13px] font-semibold transition-colors sm:px-3.5 sm:text-sm',
            isAbout ? 'text-token-link' : 'text-token-nav hover:bg-token-hover hover:text-token-primary',
          ]}
        >
          {isAbout && <span class="nav-pill-bg" aria-hidden="true" />}
          About
        </a>
      </div>
      <ThemeToggle />
    </div>
  </nav>
</header>
