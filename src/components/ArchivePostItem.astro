---
interface Props {
  title: string;
  description: string;
  date: string;
  datetime: string;
  href: string;
}

const { title, description, date, datetime, href } = Astro.props;
---

<article>
  <a href={href} class="archive-link">
    <h2>{title}</h2>
    <p>{description}</p>
    <time datetime={datetime}>{date}</time>
  </a>
</article>

<style>
  .archive-link {
    position: relative;
    isolation: isolate;
    display: block;
    padding-block: 20px;
    border-radius: 4px;
  }
  .archive-link::before,
  .archive-link::after {
    content: '';
    position: absolute;
    inset: 5px -12px;
    z-index: -1;
    pointer-events: none;
    border-radius: 22px;
    opacity: 0;
  }
  .archive-link::before {
    background:
      radial-gradient(ellipse at var(--glass-x, 25%) var(--glass-y, 0%), rgba(255, 255, 255, 0.92), transparent 65%),
      linear-gradient(135deg, rgba(214, 230, 255, 0.48), rgba(255, 255, 255, 0.18) 45%, rgba(199, 222, 255, 0.32));
    backdrop-filter: blur(16px) saturate(1.8);
    -webkit-backdrop-filter: blur(16px) saturate(1.8);
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.95),
      inset 1px 0 2px rgba(255, 255, 255, 0.8),
      inset 0 -2px 4px rgba(116, 158, 210, 0.2),
      0 2px 3px rgba(35, 65, 105, 0.06),
      0 10px 26px -8px rgba(35, 65, 105, 0.24);
  }
  .archive-link::after {
    padding: 1px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 1), rgba(156, 186, 227, 0.3) 35%, rgba(255, 255, 255, 0.95) 65%, rgba(120, 164, 223, 0.4));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }
  :global(.dark) .archive-link::before {
    background:
      radial-gradient(ellipse at var(--glass-x, 25%) var(--glass-y, 0%), rgba(178, 208, 255, 0.17), transparent 65%),
      linear-gradient(135deg, rgba(111, 151, 211, 0.13), rgba(255, 255, 255, 0.025) 45%, rgba(105, 148, 213, 0.09));
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.18),
      inset 1px 0 2px rgba(255, 255, 255, 0.07),
      inset 0 -2px 4px rgba(139, 181, 243, 0.08),
      0 10px 26px -8px rgba(0, 0, 0, 0.5);
  }
  :global(.dark) .archive-link::after {
    background: linear-gradient(135deg, rgba(224, 239, 255, 0.55), rgba(156, 186, 227, 0.06) 35%, rgba(224, 239, 255, 0.25) 65%, rgba(120, 164, 223, 0.08));
  }
  time {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-text-date);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  h2 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.025em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  p {
    overflow: hidden;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  @media (hover: hover) and (pointer: fine) {
    .archive-link:hover::before,
    .archive-link:hover::after {
      opacity: 1;
    }
  }
  .archive-link:focus-visible::before,
  .archive-link:focus-visible::after {
    opacity: 1;
  }
  .archive-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .archive-link::before,
    .archive-link::after {
      transition: opacity 180ms ease;
    }
  }
  @media (max-width: 639px) {
    .archive-link {
      padding-block: 18px;
    }
    h2 {
      font-size: 18px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.archive-link').forEach((link) => {
    link.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const bounds = link.getBoundingClientRect();
      link.style.setProperty('--glass-x', `${((event.clientX - bounds.left) / bounds.width) * 100}%`);
      link.style.setProperty('--glass-y', `${((event.clientY - bounds.top) / bounds.height) * 100}%`);
    });
    link.addEventListener('pointerleave', () => {
      link.style.removeProperty('--glass-x');
      link.style.removeProperty('--glass-y');
    });
  });
</script>
