---
interface Props {
  title: string;
  description: string;
  date: string;
  datetime: string;
  href: string;
}

const { title, description, date, datetime, href } = Astro.props;
---

<article>
  <a href={href} class="archive-link">
    <h2>{title}</h2>
    <p>{description}</p>
    <time datetime={datetime}>{date}</time>
  </a>
</article>

<style>
  article + article {
    border-top: 1px solid var(--color-border-primary);
  }
  .archive-link {
    position: relative;
    isolation: isolate;
    display: block;
    padding-block: 20px;
    border-radius: 4px;
  }
  .archive-link::before {
    content: '';
    position: absolute;
    inset: 5px -12px;
    z-index: -1;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(255, 255, 255, 0.45),
      0 4px 18px rgba(25, 45, 80, 0.07);
    opacity: 0;
  }
  :global(.dark) .archive-link::before {
    border-color: rgba(255, 255, 255, 0.13);
    background: rgba(255, 255, 255, 0.045);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      inset 0 -1px 0 rgba(255, 255, 255, 0.025),
      0 6px 22px rgba(0, 0, 0, 0.18);
  }
  time {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-text-date);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  h2 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.025em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  p {
    overflow: hidden;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  @media (hover: hover) and (pointer: fine) {
    .archive-link:hover::before {
      opacity: 1;
    }
  }
  .archive-link:focus-visible::before {
    opacity: 1;
  }
  .archive-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .archive-link::before {
      transition: opacity 160ms ease;
    }
  }
  @media (max-width: 639px) {
    .archive-link {
      padding-block: 18px;
    }
    h2 {
      font-size: 18px;
    }
  }
</style>
