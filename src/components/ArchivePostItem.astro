---
interface Props {
  title: string;
  description: string;
  date: string;
  datetime: string;
  href: string;
}

const { title, description, date, datetime, href } = Astro.props;
---

<article>
  <a href={href} class="archive-link">
    <h2>{title}</h2>
    <p>{description}</p>
    <time datetime={datetime}>{date}</time>
  </a>
</article>

<style>
  .archive-link {
    position: relative;
    isolation: isolate;
    display: block;
    padding-block: 20px;
    border-radius: 4px;
  }
  .archive-link::before {
    content: '';
    position: absolute;
    inset: 4px -12px;
    z-index: -1;
    pointer-events: none;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.85),
      inset 0 -1px 1px rgba(0, 0, 0, 0.035),
      0 4px 16px rgba(0, 0, 0, 0.045);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
  }
  :global(.dark) .archive-link::before {
    background: rgba(255, 255, 255, 0.025);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.12),
      inset 0 -1px 1px rgba(255, 255, 255, 0.025),
      0 4px 16px rgba(0, 0, 0, 0.12);
  }
  h2 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.025em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  p {
    overflow: hidden;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  time {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-text-date);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .archive-link:hover::before {
      opacity: 1;
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .archive-link:hover {
      transform: scale(1.01);
    }
  }
  .archive-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .archive-link {
      transition: transform 180ms ease;
    }
    .archive-link::before {
      transition: opacity 180ms ease;
    }
  }
  @media (max-width: 639px) {
    .archive-link {
      padding-block: 18px;
    }
    h2 {
      font-size: 18px;
    }
  }
</style>
