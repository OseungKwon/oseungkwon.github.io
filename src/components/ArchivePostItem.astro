---
interface Props {
  title: string;
  description: string;
  date: string;
  datetime: string;
  href: string;
}

const { title, description, date, datetime, href } = Astro.props;
---

<article>
  <a href={href} class="archive-link">
    <time datetime={datetime}>{date}</time>
    <div class="post-copy">
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
  </a>
</article>

<style>
  .archive-link {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    align-items: baseline;
    gap: 28px;
    padding-block: 22px;
    border-radius: 4px;
  }
  time {
    font-size: 12px;
    color: var(--color-text-date);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  h2 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.025em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  p {
    overflow: hidden;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .archive-link:hover h2 {
    color: var(--color-link);
  }
  .archive-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 6px;
  }
  @media (max-width: 639px) {
    .archive-link {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding-block: 18px;
    }
    h2 {
      font-size: 18px;
    }
  }
</style>
