---
interface Props {
  title: string;
  description: string;
  date: string;
  datetime: string;
  href: string;
}

const { title, description, date, datetime, href } = Astro.props;
---

<article class="featured-post">
  <div class="featured-meta">
    <span>최신 글</span>
    <time datetime={datetime}>{date}</time>
  </div>
  <a href={href} class="featured-link">
    <h2>{title}</h2>
    <p>{description}</p>
  </a>
</article>

<style>
  .featured-post {
    padding-block: 48px 52px;
  }
  .featured-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }
  .featured-meta > span {
    font-weight: 600;
  }
  time {
    color: var(--color-text-date);
    font-variant-numeric: tabular-nums;
  }
  .featured-link {
    display: block;
    border-radius: 4px;
  }
  h2 {
    max-width: 720px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.035em;
    word-break: keep-all;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  p {
    max-width: 660px;
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.85;
    color: var(--color-text-secondary);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .featured-link:hover h2 {
    color: var(--color-link);
  }
  .featured-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 8px;
  }
  @media (max-width: 639px) {
    .featured-post {
      padding-block: 32px 36px;
    }
    .featured-meta {
      margin-bottom: 18px;
    }
    h2 {
      font-size: 28px;
      line-height: 1.45;
    }
    p {
      margin-top: 14px;
      font-size: 15px;
    }
  }
</style>
