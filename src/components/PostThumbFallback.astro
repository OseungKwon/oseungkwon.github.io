---
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = '' } = Astro.props;

// 짧은 태그는 크게, 긴 태그는 작게 잡아 64px 틀을 고르게 채운다.
const size = label.length <= 4 ? 'text-[15px]' : label.length <= 7 ? 'text-[12.5px]' : 'text-[10.5px]';
---

<div class:list={['flex h-full w-full items-center justify-center rounded-xl border border-token-primary px-1', className]}>
  <span class:list={['text-center font-semibold leading-[1.2] tracking-tight text-token-secondary', size]}>{label}</span>
</div>
