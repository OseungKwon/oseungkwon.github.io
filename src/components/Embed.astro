---
/**
 * Embed — 자체 완결 HTML(주로 AI가 생성한 시각화)을 iframe으로 격리해 삽입한다.
 *
 * 왜 iframe인가: AI가 만든 HTML은 자체 style/script 태그를 가진 완결 문서라
 * 본문에 인라인하면 블로그 전역 스타일(prose/tailwind)과 충돌한다. iframe은
 * 스타일·스크립트를 완전히 격리하므로 AI 결과물을 손대지 않고 그대로 쓸 수 있다.
 *
 * 사용법 (.mdx 본문에서):
 *   import Embed from '@components/Embed.astro';
 *   <Embed src="/embeds/zustand-flow.html" title="Zustand 상태 흐름" />
 *
 * public/embeds/ 에 저장한 파일은 사이트 루트(/embeds/...)로 서빙된다.
 */
interface Props {
  /** public/ 기준 경로. 예: "/embeds/foo.html" */
  src: string;
  /** 본문과 연결되는 테두리 없는 시각화 */
  seamless?: boolean;
  /** 캡션 겸 iframe 접근성 제목 */
  title?: string;
  /** aspect 미지정 시 초기/고정 높이(px). auto=false면 이 높이로 고정 */
  height?: number;
  /** "16/9" 같은 종횡비. 지정하면 높이 자동조절 대신 비율 고정 */
  aspect?: string;
  /** 본문 폭을 넘어 넓게 표시 */
  wide?: boolean;
  /** 콘텐츠 높이에 맞춰 자동 리사이즈 (aspect 미지정 시 기본 true) */
  auto?: boolean;
}

const { src, seamless = false, title, height = 460, aspect, wide = false, auto = aspect ? false : true } = Astro.props;
---

<figure class:list={['grape-embed not-prose', { 'grape-embed--wide': wide, 'grape-embed--seamless': seamless }]}>
  <div class="grape-embed__frame" style={aspect ? `aspect-ratio:${aspect}` : `height:${height}px`}>
    <iframe src={src} title={title ?? '임베드 시각화'} loading="lazy" data-auto={auto ? 'true' : 'false'} referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
  </div>
  {title && <figcaption class="grape-embed__caption">{title}</figcaption>}
</figure>

<style>
  .grape-embed {
    margin: 2.5rem 0;
  }

  .grape-embed--wide {
    width: min(60rem, calc(100vw - 2rem));
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .grape-embed__frame {
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--color-border-primary);
    background-color: var(--color-bg-secondary);
  }

  .grape-embed--seamless .grape-embed__frame {
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .grape-embed__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .grape-embed__caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--color-text-tertiary);
  }
</style>

<script>
  // 같은 오리진(자체 사이트)에서 서빙되므로 iframe.contentDocument에 접근 가능.
  // → AI가 만든 HTML을 수정하지 않고도 높이 자동조절 + 다크모드 동기화가 된다.
  function initEmbeds() {
    const frames = document.querySelectorAll<HTMLIFrameElement>('.grape-embed__frame iframe[data-auto="true"]');

    const syncTheme = (iframe: HTMLIFrameElement) => {
      try {
        const idoc = iframe.contentDocument;
        if (!idoc) return;
        const dark = document.documentElement.classList.contains('dark');
        idoc.documentElement.classList.toggle('dark', dark);
        if (iframe.closest('.grape-embed--seamless')) {
          const style = getComputedStyle(iframe.closest('article') ?? document.body);
          idoc.documentElement.style.setProperty('--embed-font', style.fontFamily);
          idoc.documentElement.style.setProperty('--embed-text', style.color);
          idoc.documentElement.style.setProperty('--embed-size', style.fontSize);
        }
      } catch {
        /* 크로스 오리진 등 접근 불가 시 무시 */
      }
    };

    frames.forEach((iframe) => {
      const frame = iframe.parentElement as HTMLElement;
      let observer: ResizeObserver | undefined;
      let pending = 0;

      const resize = () => {
        pending = 0;
        try {
          const doc = iframe.contentDocument;
          const view = iframe.contentWindow;
          if (!doc?.body || !view) return;
          // html.scrollHeight는 iframe의 현재 높이보다 작아지지 않습니다.
          // 일반 문서 흐름의 body 크기를 측정해야 콘텐츠가 줄 때도 축소됩니다.
          const body = doc.body;
          const style = view.getComputedStyle(body);
          const height = Math.ceil(body.getBoundingClientRect().height + (parseFloat(style.marginTop) || 0) + (parseFloat(style.marginBottom) || 0));
          const frameStyle = getComputedStyle(frame);
          const border = (parseFloat(frameStyle.borderTopWidth) || 0) + (parseFloat(frameStyle.borderBottomWidth) || 0);
          const next = `${height + border}px`;
          if (height > 0 && frame.style.height !== next) frame.style.height = next;
        } catch {
          /* 외부 문서는 초기 높이를 유지합니다. */
        }
      };
      const scheduleResize = () => {
        if (!pending) pending = requestAnimationFrame(resize);
      };
      const connect = () => {
        observer?.disconnect();
        syncTheme(iframe);
        try {
          const doc = iframe.contentDocument;
          if (!doc?.body) return;
          observer = new ResizeObserver(scheduleResize);
          observer.observe(doc.body);
          // 폰트·이미지 로딩, 너비 변경에 따른 줄바꿈도 body 관찰로 반영합니다.
          void doc.fonts.ready.then(scheduleResize);
          scheduleResize();
        } catch {
          /* 외부 문서는 자동 측정할 수 없습니다. */
        }
      };
      iframe.addEventListener('load', connect);
      // 스크립트 실행 전에 로드가 끝난 iframe도 연결합니다.
      if (iframe.contentDocument?.readyState === 'complete') connect();
      window.addEventListener('resize', scheduleResize);
    });

    // 부모 문서의 다크모드 토글을 감지해 모든 임베드에 반영
    const allFrames = document.querySelectorAll<HTMLIFrameElement>('.grape-embed__frame iframe');
    const themeObserver = new MutationObserver(() => {
      allFrames.forEach(syncTheme);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmbeds);
  } else {
    initEmbeds();
  }
</script>
