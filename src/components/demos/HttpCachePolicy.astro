---
import Demo from './Demo.astro';
---

<Demo title="만료 뒤에 기다릴지, 이전 응답을 받을지" hint="시간을 진행한 뒤 요청하고, 갱신을 완료해 비교합니다." caption="설명용 모형 · 원본 v2, 캐시 v1에서 시작합니다.">
  <Fragment slot="controls">
    <div class="demo-seg" role="group" aria-label="만료 후 정책">
      <button type="button" class="demo-seg__opt" data-mode="blocking" aria-pressed="false">재검증 대기</button>
      <button type="button" class="demo-seg__opt" data-mode="swr" aria-pressed="true">SWR 30초</button>
    </div>
    <button type="button" class="demo-btn" data-el="advance">시간 +30초</button>
    <button type="button" class="demo-btn demo-btn--primary" data-el="request">요청</button>
    <button type="button" class="demo-btn" data-el="finish" disabled>갱신 완료</button>
    <button type="button" class="demo-btn" data-el="reset">처음으로</button>
  </Fragment>
  <div class="hcp" data-demo="http-cache-policy">
    <code class="hcp-header" data-el="header">Cache-Control: max-age=60, stale-while-revalidate=30</code>
    <div class="hcp-track" aria-hidden="true"><span>신선 · 0–60초 미만</span><span data-el="zone">SWR · 60–90초 미만</span></div>
    <div class="hcp-grid">
      <div><span>캐시 나이</span><strong data-el="age">0초</strong></div>
      <div><span>저장된 버전</span><strong data-el="version">v1</strong></div>
      <div><span>원본 조회 횟수</span><strong data-el="count">0</strong></div>
    </div>
    <div class="hcp-flow"><span>요청</span><span aria-hidden="true">→</span><span data-el="cache">신선한 캐시</span><span aria-hidden="true">→</span><span data-el="origin">원본 v2 · 대기</span></div>
    <p class="hcp-result" data-el="result" aria-live="polite">60초 미만에서는 v1을 재사용합니다.</p>
  </div>
</Demo>
<style>
  .hcp {
    font-size: 13px;
  }
  .hcp-header {
    display: block;
    overflow-wrap: anywhere;
    color: var(--color-text-secondary);
    font-size: 12px;
    margin-bottom: 18px;
  }
  .hcp-track {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3px;
    font-size: 11px;
  }
  .hcp-track span {
    background: var(--demo-a-soft);
    border-radius: 6px;
    padding: 10px;
  }
  .hcp-track span:last-child {
    background: var(--color-bg-tertiary);
  }
  .hcp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 20px 0;
    gap: 10px;
  }
  .hcp-grid span {
    display: block;
    color: var(--color-text-secondary);
    font-size: 11px;
  }
  .hcp-grid strong {
    display: block;
    font-size: 24px;
    font-variant-numeric: tabular-nums;
  }
  .hcp-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .hcp-flow span:not([aria-hidden]) {
    border: 1px solid var(--color-border-primary);
    border-radius: 8px;
    padding: 8px;
  }
  .hcp-result {
    margin: 14px 0 0;
    color: var(--color-text-primary);
  }
  .hcp [data-active='true'] {
    color: var(--demo-a);
    background: var(--demo-a-soft);
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-demo="http-cache-policy"]').forEach((root) => {
    const frame = root.closest('.demo')!;
    const el = (name: string) => frame.querySelector<HTMLElement>(`[data-el="${name}"]`)!;
    let mode = 'swr';
    let age = 0;
    let version = 1;
    let count = 0;
    let pending: 'none' | 'background' | 'blocking' = 'none';
    const paint = () => {
      el('age').textContent = `${age}초`;
      el('version').textContent = `v${version}`;
      el('count').textContent = String(count);
      el('cache').textContent = age < 60 ? '신선한 캐시' : mode === 'swr' && age < 90 ? 'SWR 허용 구간' : '재검증 필요';
      el('origin').textContent = pending === 'none' ? '원본 v2 · 대기' : '원본 v2 · 조회 중';
      el('origin').dataset.active = String(pending !== 'none');
      (el('finish') as HTMLButtonElement).disabled = pending === 'none';
      (el('advance') as HTMLButtonElement).disabled = pending !== 'none';
      (el('request') as HTMLButtonElement).disabled = pending !== 'none';
      el('header').textContent = mode === 'swr' ? 'Cache-Control: max-age=60, stale-while-revalidate=30' : 'Cache-Control: max-age=60, must-revalidate';
      el('zone').textContent = mode === 'swr' ? 'SWR · 60–90초 미만' : '60초부터 재검증 대기';
      frame.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mode === mode)));
    };
    const reset = () => {
      age = 0;
      version = 1;
      count = 0;
      pending = 'none';
      el('result').textContent = '60초 미만에서는 v1을 재사용합니다.';
      paint();
    };
    frame.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) =>
      button.addEventListener('click', () => {
        mode = button.dataset.mode!;
        reset();
      }),
    );
    el('advance').addEventListener('click', () => {
      age += 30;
      el('result').textContent = '시간만 경과 · 원본 조회는 없습니다.';
      paint();
    });
    el('request').addEventListener('click', () => {
      if (age < 60) el('result').textContent = `v${version} 응답 · 원본 조회 없음`;
      else {
        count++;
        pending = mode === 'swr' && age < 90 ? 'background' : 'blocking';
        el('result').textContent = pending === 'background' ? `v${version} 먼저 응답 · 백그라운드 갱신 중` : '새 응답을 기다립니다. 갱신을 완료해 보세요.';
      }
      paint();
    });
    el('finish').addEventListener('click', () => {
      const wasBackground = pending === 'background';
      pending = 'none';
      age = 0;
      version = 2;
      el('result').textContent = wasBackground ? '캐시가 v2로 갱신됐습니다. 다음 요청부터 사용합니다.' : 'v2 응답 완료 · 캐시도 v2로 갱신됐습니다.';
      paint();
    });
    el('reset').addEventListener('click', () => {
      mode = 'swr';
      reset();
    });
    paint();
  });
</script>
