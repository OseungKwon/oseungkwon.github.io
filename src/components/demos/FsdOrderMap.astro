---
import Demo from './Demo.astro';
const nodes = [
  ['app', 'routes', '화면 라우팅'],
  ['pages/menu', 'ui', 'MenuPage'],
  ['pages/cart', 'ui', 'CartPage'],
  ['pages/order', 'ui', 'OrderPage'],
  ['features/add-to-cart', 'ui', 'AddToCartButton'],
  ['pages/cart', 'model', 'useCheckout'],
  ['pages/order', 'model', 'useOrder'],
  ['features/add-to-cart', 'model', 'addToCart'],
  ['entities/menu', 'api', 'getMenu'],
  ['entities/cart', 'model', 'cartStore · 담기 조건'],
  ['entities/order', 'api', 'createOrder · getOrder'],
  ['shared', 'ui', 'Button'],
  ['shared', 'api', 'HTTP client'],
];
const edges = [
  [0, 1, true],
  [0, 2, true],
  [0, 3, true],
  [1, 4, true],
  [1, 8, true],
  [2, 5, false],
  [3, 6, false],
  [4, 7, false],
  [4, 11, true],
  [5, 9, true],
  [5, 10, true],
  [6, 10, true],
  [7, 9, true],
  [8, 12, true],
  [10, 12, true],
];
const scenarios = [
  { id: 'menu', label: '메뉴 탐색·담기', edges: [0, 3, 4, 7, 8, 12, 13] },
  { id: 'checkout', label: '결제', edges: [1, 5, 9, 10, 14] },
  { id: 'order', label: '주문 확인', edges: [2, 6, 11, 14] },
];
const layouts = [
  {
    name: 'wide',
    width: 780,
    height: 1340,
    box: 200,
    positions: [
      [290, 60],
      [30, 260],
      [290, 260],
      [550, 260],
      [30, 650],
      [290, 400],
      [550, 400],
      [30, 790],
      [30, 1010],
      [290, 1010],
      [550, 1010],
      [30, 1230],
      [550, 1230],
    ],
    bands: [
      ['app', '앱 연결', 10, 145],
      ['pages', '화면과 전용 흐름', 200, 335],
      ['features', '재사용할 사용자 행동', 590, 300],
      ['entities', '업무 개체의 상태와 API', 950, 160],
      ['shared', '공통 기반', 1170, 160],
    ],
  },
  {
    name: 'narrow',
    width: 360,
    height: 1800,
    box: 140,
    positions: [
      [110, 60],
      [30, 260],
      [190, 260],
      [190, 540],
      [30, 850],
      [190, 400],
      [190, 680],
      [30, 990],
      [30, 1210],
      [190, 1210],
      [190, 1350],
      [30, 1650],
      [190, 1650],
    ],
    bands: [
      ['app', '앱 연결', 10, 145],
      ['pages', '화면과 전용 흐름', 200, 565],
      ['features', '재사용 행동', 800, 300],
      ['entities', '상태와 API', 1160, 310],
      ['shared', '공통 기반', 1590, 160],
    ],
  },
];
function route(layout: (typeof layouts)[number], from: number, to: number, i: number) {
  const [sx, sy] = layout.positions[from];
  const [tx, ty] = layout.positions[to];
  const w = layout.box;
  if (sx === tx && (ty - sy <= 160 || i === 3)) return `M${sx + w / 2} ${sy + 80} V${ty}`;
  if (from === 0) return `M${sx + w / 2} ${sy + 80} V${175 + i * 6} H${tx + w / 2} V${ty}`;
  // 화면별로 필요한 선만 표시하고, 긴 참조는 전용 우회 경로로 분리합니다.
  const right = i === 4 || i === 8 ? false : sx < layout.width / 2;
  const offset = i === 4 ? 10 : i === 8 ? 20 : 6 + (i % 3) * 4;
  const lane = right ? sx + w + offset : sx - offset;
  const enter = ty - 16 - (i % 5) * 7;
  return `M${right ? sx + w : sx} ${sy + 40} H${lane} V${enter} H${tx + w / 2} V${ty}`;
}
---

<Demo
  title="주문 앱을 책임에 따라 펼치면"
  hint="화면별로 참조하는 세그먼트를 선택해 확인합니다."
  caption="화살표는 import 방향입니다. 실선은 같은 슬라이스 내부, 파선은 공개 API를 통한 외부 참조를 나타냅니다."
  frameless
>
  <div slot="controls" class="demo-seg" role="group" aria-label="확인할 주문 앱 기능">
    {
      scenarios.map((scenario, i) => (
        <button type="button" class="demo-seg__opt" data-fom-scenario={scenario.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {scenario.label}
        </button>
      ))
    }
  </div>
  <div class="fom-graph" data-fom-graph>
    {
      layouts.map((layout) => (
        <svg
          class={`fom-svg fom-svg--${layout.name}`}
          viewBox={`0 0 ${layout.width} ${layout.height}`}
          role="img"
          aria-label="앱 라우팅에서 메뉴판·장바구니·주문 확인 페이지로, 각 페이지와 담기 피처의 세그먼트에서 엔티티와 shared의 세그먼트로 이어지는 의존 그래프"
        >
          <defs>
            <marker id={`fom-arrow-${layout.name}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0 0 L10 5 L0 10 z" fill="var(--demo-a)" />
            </marker>
          </defs>
          {layout.bands.map(([name, role, y, height]) => (
            <g class="fom-band">
              <rect x="1" y={y} width={layout.width - 2} height={height} rx="12" />
              <text x="15" y={Number(y) + 26} class="fom-layer-name">
                {name}
              </text>
              <text x={layout.width - 15} y={Number(y) + 26} text-anchor="end" class="fom-layer-role">
                {role}
              </text>
            </g>
          ))}
          {edges.map(([from, to, external], i) => (
            <path
              data-fom-edge={i}
              hidden={!scenarios[0].edges.includes(i)}
              class:list={['fom-edge', external && 'fom-edge--public']}
              d={route(layout, Number(from), Number(to), i)}
              marker-end={`url(#fom-arrow-${layout.name})`}
            />
          ))}
          {nodes.map((node, i) => (
            <g
              data-fom-node={i}
              data-active={scenarios[0].edges.some((index) => edges[index][0] === i || edges[index][1] === i) ? 'true' : 'false'}
              transform={`translate(${layout.positions[i][0]} ${layout.positions[i][1]})`}
              class="fom-node"
            >
              <rect width={layout.box} height="80" rx="9" />
              <text x="10" y="22" class="fom-path">
                {node[0]}
              </text>
              <text x="10" y="45" class="fom-segment">
                {node[1]}
              </text>
              <text x="10" y="66" class="fom-symbol">
                {node[2]}
              </text>
            </g>
          ))}
        </svg>
      ))
    }
    <div class="fom-legend"><span>실선: 슬라이스 내부</span><span>파선: 외부 공개 API 경유</span></div>
  </div>
</Demo>
<style>
  .fom-band rect {
    fill: var(--color-bg-secondary);
    stroke: var(--color-border-primary);
  }
  .fom-band text {
    font-family: var(--font-sans);
    fill: var(--color-text-secondary);
  }
  .fom-layer-name {
    font-size: 16px;
    font-weight: 700;
  }
  .fom-layer-role {
    font-size: 11px;
  }
  .fom-node[data-active='false'] {
    opacity: 0.38;
  }
  .fom-edge[hidden] {
    display: none;
  }
  .fom-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .fom-svg--narrow {
    display: none;
  }
  .fom-node rect {
    fill: var(--surface-bg);
    stroke: var(--color-border-primary);
  }
  .fom-node[data-active='true'] rect {
    fill: var(--demo-a-soft);
    stroke: var(--demo-a);
  }
  .fom-node text {
    font-family: var(--font-sans);
    fill: var(--color-text-primary);
  }
  .fom-path {
    font-size: 11px;
  }
  .fom-segment {
    font-size: 17px;
    font-weight: 700;
  }
  .fom-symbol {
    font-size: 11px;
    fill: var(--color-text-secondary) !important;
  }
  .fom-edge {
    fill: none;
    stroke: var(--demo-a);
    stroke-width: 1.4;
  }
  .fom-edge--public {
    stroke-dasharray: 5 4;
  }
  .fom-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  @media (max-width: 34rem) {
    .fom-svg--wide {
      display: none;
    }
    .fom-svg--narrow {
      display: block;
    }
  }
</style>

<script>
  const scenarios: Record<string, number[]> = {
    menu: [0, 3, 4, 7, 8, 12, 13],
    checkout: [1, 5, 9, 10, 14],
    order: [2, 6, 11, 14],
  };
  const endpoints = [
    [0, 1],
    [0, 2],
    [0, 3],
    [1, 4],
    [1, 8],
    [2, 5],
    [3, 6],
    [4, 7],
    [4, 11],
    [5, 9],
    [5, 10],
    [6, 10],
    [7, 9],
    [8, 12],
    [10, 12],
  ];
  document.querySelectorAll<HTMLElement>('[data-fom-graph]').forEach((root) => {
    const figure = root.closest('figure')!;
    figure.querySelectorAll<HTMLButtonElement>('[data-fom-scenario]').forEach((button) => {
      button.addEventListener('click', () => {
        const active = scenarios[button.dataset.fomScenario!];
        figure.querySelectorAll('[data-fom-scenario]').forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
        root.querySelectorAll<SVGElement>('[data-fom-edge]').forEach((edge) => {
          edge.toggleAttribute('hidden', !active.includes(Number(edge.dataset.fomEdge)));
        });
        root.querySelectorAll<SVGElement>('[data-fom-node]').forEach((node) => {
          node.dataset.active = String(active.some((index) => endpoints[index].includes(Number(node.dataset.fomNode))));
        });
      });
    });
  });
</script>
