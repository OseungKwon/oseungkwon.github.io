---
/**
 * 이벤트 루프 블로킹 — 대조 토글 + 재생형 데모.
 *
 * 글(nodejs-runtime-anatomy)의 "콜 스택이 비지 않으면 다른 요청도 처리되지
 * 않는다. 기다리는 작업은 같은 2초여도 다른 요청을 막지 않는다"를 보여준다.
 *
 * 100ms마다 가벼운 요청 블록이 도착해 콜 스택을 거쳐 나간다. 1초 시점에 무거운
 * 요청(회색 블록)이 들어오는데, /block이면 콜 스택에 2초 동안 눌러앉아 가벼운
 * 블록이 도착 대기 레인에 쌓이고, /slow면 대기 레인으로 비켜서서 흐름이 그대로다.
 * 처리된 요청은 아래 막대(응답 시간)로 남는다.
 *
 * 값은 글의 측정 결과(가벼운 요청 39개 중 19개가 100ms 초과, 최대 1,995ms)가
 * 나오도록 규칙으로 재구성한 것이다.
 */
import Demo from './Demo.astro';

const LIGHTS = Array.from({ length: 39 }, (_, i) => i); // 0초부터 100ms 간격
const BUFFER = Array.from({ length: 20 }, (_, i) => i);
const TICKS = [0, 1, 2, 3, 4];
---

<Demo
  title="무거운 요청 하나가 가벼운 요청에 미치는 영향"
  hint="1초 시점에 2초짜리 무거운 요청이 들어옵니다. 그 요청이 CPU로 계산하는지(동기), 응답을 기다리기만 하는지(비동기)를 바꿔 실행해 보세요. 파란 블록이 100ms마다 들어오는 가벼운 요청입니다."
  caption="Node.js 23 로컬 서버에서 측정한 결과(가벼운 요청 39개 중 19개가 100ms 초과, 최대 1,995ms)를 규칙으로 재구성한 모형입니다. 화면은 실제보다 2배 느리게 재생합니다."
>
  <Fragment slot="controls">
    <div class="demo-seg" role="group" aria-label="1초 시점에 들어오는 요청">
      <button class="demo-seg__opt" type="button" data-mode="none" aria-pressed="false">없음</button>
      <button class="demo-seg__opt" type="button" data-mode="block" aria-pressed="true">동기 계산 2초</button>
      <button class="demo-seg__opt" type="button" data-mode="slow" aria-pressed="false">비동기 대기 2초</button>
    </div>
    <span class="demo__spacer"></span>
    <button class="demo-btn demo-btn--primary" type="button" data-act="run">실행</button>
  </Fragment>

  <div class="lb" data-demo="loop-blocking">
    <div class="demo-stats">
      <div class="demo-stat">
        <span class="demo-stat__value demo-stat__value--accent" data-el="max">—</span>
        <span class="lb-stat-label">가벼운 요청이 기다린 최대 시간</span>
      </div>
    </div>

    <div class="lb-map">
      <span class="lb-name">도착 대기</span>
      <div class="demo-lane lb-rail" data-el="buffer">
        {BUFFER.map((i) => <span class="demo-slot lb-slot" data-anchor={`b${i}`} />)}
      </div>

      <span class="lb-name">콜 스택</span>
      <div class="demo-lane" data-el="stack">
        <span class="demo-slot lb-slot" data-anchor="stack"></span>
        <span class="demo-slot lb-heavy-slot" data-anchor="stack-heavy"></span>
      </div>

      <span class="lb-name">비동기 대기</span>
      <div class="demo-lane" data-el="wait">
        <span class="demo-slot lb-heavy-slot" data-anchor="wait"></span>
      </div>

      {LIGHTS.map((i) => <span class="demo-token lb-light" data-token={`l${i}`} />)}
      <span class="demo-token demo-token--b" data-token="heavy" data-el="heavy">/block</span>
    </div>

    <div class="lb-record">
      <span class="lb-name">응답 시간</span>
      <div class="lb-chart">
        <div class="lb-bars">
          <span class="lb-grid" style="--y: 1" aria-hidden="true"><i>2s</i></span>
          <span class="lb-grid" style="--y: 0.05" aria-hidden="true"><i>100ms</i></span>
          {LIGHTS.map((i) => <span class="lb-bar" data-bar={i} style={`--x: ${i}`} />)}
        </div>
        <div class="lb-axis" aria-hidden="true">
          {TICKS.map((t) => <span style={`--t: ${t}`}>{t}s</span>)}
        </div>
      </div>
    </div>
  </div>
</Demo>

<style>
  .lb {
    display: grid;
    gap: 1.25rem;
  }

  .lb-stat-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }

  .lb-map,
  .lb-record {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.375rem 0.75rem;
  }

  .lb-record {
    align-items: start;
  }

  .lb-name {
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--color-text-secondary);
  }

  .lb-rail {
    flex-wrap: wrap;
    gap: 0.25rem;
    padding-left: 0.5rem;
  }

  .lb-slot {
    width: 1.125rem;
    height: 1.125rem;
  }

  .lb-heavy-slot {
    width: 3.25rem;
  }

  .lb-light {
    min-width: 1.125rem;
    height: 1.125rem;
    padding: 0;
    border-radius: 0.25rem;
  }

  /* ── 응답 시간 기록: 처리된 요청이 막대로 남는다. 가로축 0~4초 ── */
  .lb-chart {
    display: grid;
    gap: 0.25rem;
  }

  .lb-bars {
    position: relative;
    height: 4.5rem;
    border-bottom: 1px solid var(--color-border-primary);
  }

  .lb-grid {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--y) * 100%);
    border-top: 1px dashed var(--color-border-secondary);
  }

  .lb-grid i {
    position: absolute;
    right: 0;
    bottom: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-style: normal;
    color: var(--color-text-tertiary);
  }

  /* 막대 높이 = 응답 시간 / 2초. 도착 시각(--x × 100ms) 위치에 선다. */
  .lb-bar {
    position: absolute;
    bottom: 0;
    left: calc(var(--x) * 2.5% + 0.35%);
    width: 1.8%;
    height: max(2px, calc(var(--h, 0) * 100%));
    border-radius: 2px 2px 0 0;
    background-color: var(--demo-a);
  }

  .lb-bar:not([data-done]) {
    visibility: hidden;
  }

  .lb-bar[data-late] {
    background-color: var(--demo-warn);
  }

  .lb-axis {
    position: relative;
    height: 0.875rem;
  }

  .lb-axis span {
    position: absolute;
    left: calc(var(--t) * 25%);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    transform: translateX(-50%);
  }

  .lb-axis span:first-child {
    transform: none;
  }

  .lb-axis span:last-child {
    transform: translateX(-100%);
  }

  @media (max-width: 34rem) {
    .lb-map,
    .lb-record {
      grid-template-columns: minmax(0, 1fr);
    }

    .lb-name {
      margin-top: 0.375rem;
    }
  }
</style>

<script>
  import { createTokens, type Placement } from './lib/tokens';

  type Mode = 'none' | 'block' | 'slow';

  const COUNT = 39;
  const GAP = 0.1; // 가벼운 요청 간격(초)
  const HEAVY_START = 1.09; // 무거운 요청 도착(초)
  const HEAVY_END = 3.09; // 2초 뒤
  const BASE = 0.005; // 방해가 없을 때의 응답 시간(측정 2~9ms)
  const SHOW = 0.06; // 콜 스택에 블록을 보여 두는 시간(화면용, 응답 시간과 무관)
  const END = 4;
  const SLOW = 2; // 화면에서 2배 느리게

  // i번째 가벼운 요청이 콜 스택에 올라가는 시각.
  // /block이 콜 스택을 잡은 동안 도착한 요청은 계산이 끝날 때까지 기다린다.
  const startOf = (mode: Mode, i: number) => {
    const arrive = i * GAP;
    if (mode === 'block' && arrive >= HEAVY_START && arrive < HEAVY_END) return HEAVY_END;
    return arrive;
  };

  document.querySelectorAll<HTMLElement>('[data-demo="loop-blocking"]').forEach((root) => {
    const shell = root.closest('.demo');
    if (!shell) return;

    const el = <T extends HTMLElement>(name: string) => shell.querySelector<T>(`[data-el="${name}"]`)!;
    const segs = shell.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const runBtn = shell.querySelector<HTMLButtonElement>('[data-act="run"]')!;
    const bars = root.querySelectorAll<HTMLElement>('[data-bar]');
    const stackLane = el('stack');
    const waitLane = el('wait');
    const heavy = el('heavy');
    const tokens = createTokens(root.querySelector<HTMLElement>('.lb-map')!);
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let mode: Mode = 'block';
    let raf = 0;
    let delay = 0;
    let lastKey = '';

    const frame = (t: number, instant = false) => {
      const at: Placement = {};
      let waiting = 0;
      let max = 0;

      for (let i = 0; i < COUNT; i++) {
        const arrive = i * GAP;
        const start = startOf(mode, i);
        const ms = Math.round((start - arrive + BASE) * 1000);
        const done = t >= start + BASE;

        if (t >= arrive && t < start) at[`l${i}`] = `b${waiting++}`;
        else if (t >= start && t < start + SHOW) at[`l${i}`] = 'stack';

        const bar = bars[i];
        bar.toggleAttribute('data-done', done);
        bar.toggleAttribute('data-late', ms > 100);
        bar.style.setProperty('--h', String(Math.min(ms / 2000, 1)));
        if (done) max = Math.max(max, ms);
        // 아직 기다리는 요청은 지금까지 기다린 시간을 센다. 쌓이는 동안 숫자가 자란다.
        else if (t >= arrive) max = Math.max(max, Math.round((t - arrive) * 1000));
      }

      // 무거운 요청: /block은 2초 내내 콜 스택에, /slow는 잠깐 올라왔다가 대기 레인으로 비켜선다
      let heavyAt: string | null = null;
      if (mode === 'block' && t >= HEAVY_START && t < HEAVY_END) heavyAt = 'stack-heavy';
      if (mode === 'slow' && t >= HEAVY_START && t < HEAVY_END + SHOW) {
        heavyAt = t < HEAVY_START + SHOW || t >= HEAVY_END ? 'stack-heavy' : 'wait';
      }
      at.heavy = heavyAt;

      stackLane.toggleAttribute('data-warn', mode === 'block' && heavyAt === 'stack-heavy');
      waitLane.toggleAttribute('data-on', heavyAt === 'wait');
      el('max').textContent = max ? `${max.toLocaleString()}ms` : '—';

      const key = JSON.stringify(at);
      if (key !== lastKey || instant) {
        tokens.place(at, instant);
        lastKey = key;
      }
    };

    // 버튼을 눌러야 재생한다. 독자가 스크롤해 오기 전에 끝나 버리지 않게.
    const setButton = (label: string, busy: boolean) => {
      runBtn.textContent = label;
      runBtn.disabled = busy;
    };

    const reset = () => {
      cancelAnimationFrame(raf);
      clearTimeout(delay);
      heavy.textContent = mode === 'slow' ? '/slow' : '/block';
      frame(0, true);
      setButton('실행', false);
    };

    const run = () => {
      reset();
      if (calm) {
        frame(END, true);
        setButton('다시 실행', false);
        return;
      }
      setButton('실행 중', true);
      let begin = 0;
      const tick = (now: number) => {
        if (!begin) begin = now;
        const t = (now - begin) / 1000 / SLOW;
        frame(Math.min(t, END));
        if (t < END) raf = requestAnimationFrame(tick);
        else setButton('다시 실행', false);
      };
      // 줄 선 모습을 한 박자 보여 준 뒤 출발한다
      delay = window.setTimeout(() => (raf = requestAnimationFrame(tick)), 300);
    };

    segs.forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.mode as Mode;
        segs.forEach((other) => other.setAttribute('aria-pressed', String(other === btn)));
        reset();
      });
    });
    runBtn.addEventListener('click', run);

    reset();
  });
</script>
