    border-bottom: 1px solid var(--color-border-primary);
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
  }

  /* 상태 칸은 오른쪽 정렬이라 머리글도 맞춘다 */
  .mas-cache__head span:last-child {
    justify-self: end;
  }

  .mas-cache__head span:first-child {
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .mas-group {
    padding: 0.4375rem 0.5rem 0.125rem;
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
  }

  .mas-group span {
    grid-column: 1 / -1;
  }

  .mas-entry {
    min-height: 1.75rem;
    padding: 0 0.5rem;
    border-radius: 0.375rem;
    transition: background-color 0.2s ease;
  }

  .mas-entry__key {
    overflow: hidden;
    font-size: 0.6875rem;
    color: var(--color-text-primary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mas-entry__group {
    color: var(--color-text-tertiary);
  }

  .mas-entry:not([data-active]) .mas-entry__key {
    color: var(--color-text-secondary);
  }

  .mas-entry__value {
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .mas-entry__value[data-none] {
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  .mas-entry__value[data-new] {
    color: var(--demo-a);
  }

  /* 상태 칸: 테두리의 성질로 단계를 나눈다 */
  .mas-entry__tag {
    justify-self: end;
    padding: 0.0625rem 0.4375rem;
    border: 1px solid var(--color-border-secondary);
    border-radius: 9999px;
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .mas-entry[data-state='stale'] .mas-entry__tag {
    border-style: dashed;
    border-color: var(--color-text-tertiary);
    color: var(--color-text-secondary);
  }

