</style>

<script>
  type Mode = 'none' | 'invalidate' | 'set';
  type Id = 'all1' | 'd42' | 'all2' | 'open1' | 'd7';
  type State = 'fresh' | 'stale' | 'fetching' | 'updated' | 'outdated';
  type Entry = { state: State; tag: string; value?: string };

  const OLD = '미배정';
  const NEW = '홍길동';
  const ACTIVE: Id[] = ['all1', 'd42'];
  const INTRO = '화면은 캐시 다섯 항목 중 둘만 구독합니다';

  document.querySelectorAll<HTMLElement>('[data-demo="manager-assign"]').forEach((root) => {
    const frame = root.closest('.demo')!;
    const el = (name: string) => root.querySelector<HTMLElement>(`[data-el="${name}"]`)!;
    const modeButtons = frame.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const run = frame.querySelector<HTMLButtonElement>('[data-act="run"]')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let mode: Mode = 'invalidate';
    let status: 'idle' | 'running' | 'done' = 'idle';
    let runId = 0;
    let server = OLD;
    let requests = 0;
    let line = INTRO;
    let entries = {} as Record<Id, Entry>;

    const reset = () => {
      server = OLD;
      requests = 0;
      line = INTRO;
      // value가 없는 항목은 강남점을 담고 있지 않다
      entries = {
        all1: { state: 'fresh', tag: 'fresh', value: OLD },
        d42: { state: 'fresh', tag: 'fresh', value: OLD },
        all2: { state: 'fresh', tag: 'fresh' },
        open1: { state: 'fresh', tag: 'fresh', value: OLD },
        d7: { state: 'fresh', tag: 'fresh' },
      };
    };

    const render = () => {
      el('server').textContent = server;
      el('server').toggleAttribute('data-changed', server === NEW);
      el('requests').textContent = String(requests);
      el('line').textContent = line;

      (Object.keys(entries) as Id[]).forEach((id) => {
        const entry = entries[id];
        const node = root.querySelector<HTMLElement>(`[data-entry="${id}"]`)!;
        node.dataset.state = entry.state;
        node.querySelector('[data-el="tag"]')!.textContent = entry.tag;
        if (entry.value) {
          const value = node.querySelector<HTMLElement>('[data-el="value"]')!;
          value.textContent = entry.value;
          value.toggleAttribute('data-new', entry.value === NEW);
        }
      });

      // 화면은 자기가 구독하는 캐시 항목을 그대로 그린다
      ACTIVE.forEach((id) => {
        const entry = entries[id];
        const cell = el(`mgr-${id}`);
        cell.textContent = entry.value!;
        cell.dataset.state =
          entry.state === 'fetching'
            ? 'loading'
            : entry.value === NEW
              ? 'new'
              : entry.state === 'outdated'
                ? 'old'
                : '';
      });

      run.textContent = { idle: '홍길동 배정하기', running: '배정하는 중…', done: '배정 전으로 되돌리기' }[status];
      run.disabled = status === 'running';
      modeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      root.querySelectorAll<HTMLElement>('[data-code]').forEach((c) => (c.hidden = c.dataset.code !== mode));
    };

    const halt = Symbol('halt');
    const wait = (id: number, ms: number) =>
      new Promise<void>((resolve, reject) =>
        setTimeout(() => (id === runId ? resolve() : reject(halt)), calm ? 0 : ms),
      );
    const patch = (ids: Id[], next: Partial<Entry>) =>
      ids.forEach((id) => (entries[id] = { ...entries[id], ...next }));

    const scenario = async (id: number) => {
      server = NEW;
      line = '서버가 배정을 저장했습니다';
      render();
      await wait(id, 900);

      if (mode === 'none') {
        patch(ACTIVE, { state: 'outdated', tag: '서버와 다름' });
        line = 'onSuccess가 없어 캐시는 그대로입니다';
        status = 'done';
        render();
        return;
      }

      // onSuccess: 무효화한 항목은 stale 표시, setQueryData는 요청 없이 값 교체
      patch(['all1', 'all2', 'open1'], { state: 'stale', tag: '무효화 → stale' });
      if (mode === 'invalidate') {
        patch(['d42'], { state: 'stale', tag: '무효화 → stale' });
        line = '목록 셋과 상세 하나가 stale로 표시됐습니다';
      } else {
        patch(['d42'], { state: 'updated', tag: 'setQueryData로 교체', value: NEW });
        line = '상세는 요청 없이 바뀌고, 무효화한 목록 셋은 stale';
      }
      render();
      await wait(id, 1000);

      // 화면이 구독 중인 stale 항목만 곧바로 다시 요청한다
      const refetch = ACTIVE.filter((x) => entries[x].state === 'stale');
      patch(refetch, { state: 'fetching', tag: '무효화 → 요청 중' });
      requests = refetch.length;
      line = '구독 중인 stale 항목만 다시 요청합니다';
      render();
      await wait(id, 1100);

      patch(refetch, { state: 'updated', tag: '무효화 → 다시 받음', value: NEW });
      patch(['d7'], { tag: '대상 아님' });
      line = '화면 밖 목록은 stale로 남아 열 때 확인합니다';
      status = 'done';
      render();
    };

    run.addEventListener('click', () => {
      runId += 1;
      reset();
      if (status === 'done') {
        status = 'idle';
        render();
        return;
      }
      status = 'running';
      scenario(runId).catch((e) => {
        if (e !== halt) throw e;
      });
    });

    modeButtons.forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode as Mode;
        runId += 1;
        status = 'idle';
        reset();
        render();
      }),
    );

    reset();
    render();
  });
</script>
