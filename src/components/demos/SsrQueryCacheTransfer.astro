---
import Demo from './Demo.astro';
---

<Demo bare frameless>
  <div class="sqt" data-scene="ssr-query-cache-transfer">
    <div class="sqt-api">
      <div class="sqt-title">백엔드 API 서버</div>
      <div class="sqt-description">매장 데이터 반환</div>
      <div class="sqt-record">
        <strong>강남점</strong>
        <span>담당 매니저 <b>홍길동</b></span>
      </div>
    </div>

    <div class="sqt-arrow" aria-label="조회 응답을 렌더링 서버로 전달">
      <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 12h25m-6-6 6 6-6 6"></path></svg>
    </div>

    <div class="sqt-environment">
      <div class="sqt-heading"><div class="sqt-title">렌더링 서버</div><span>Next.js</span></div>
      <div class="sqt-cache">
        <div class="sqt-cache__label">서버의 QueryClient</div>
        <code class="sqt-key">['stores', 'detail',<br />'store-42']</code>
        <div class="sqt-data"><strong>강남점</strong><span>홍길동</span></div>
      </div>
      <div class="sqt-operation">
        <code>dehydrate()</code>
        <span>전달할 캐시 데이터 추출</span>
      </div>
    </div>

    <div class="sqt-arrow" aria-label="추출한 캐시 데이터를 브라우저로 전달">
      <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 12h25m-6-6 6 6-6 6"></path></svg>
    </div>

    <div class="sqt-environment">
      <div class="sqt-heading"><div class="sqt-title">브라우저</div><span>운영자의 화면</span></div>
      <div class="sqt-operation sqt-operation--restore">
        <code>HydrationBoundary</code>
        <span>전달받은 캐시 데이터 복원</span>
      </div>
      <div class="sqt-cache">
        <div class="sqt-cache__label">브라우저의 QueryClient</div>
        <code class="sqt-key">['stores', 'detail',<br />'store-42']</code>
        <div class="sqt-data"><strong>강남점</strong><span>홍길동</span></div>
      </div>
      <div class="sqt-reader"><code>useQuery</code><span>같은 key로 상세 표시</span></div>
    </div>
    <div class="sqt-payload">
      <span>서버 → 브라우저</span>
      <div>첫 화면 HTML + 캐시 데이터 <span class="sqt-fields">(queryKey · data · dataUpdatedAt)</span></div>
    </div>
  </div>
</Demo>

<style>
  .sqt {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) 2rem minmax(0, 1.2fr) 2rem minmax(0, 1.2fr);
    align-items: center;
    gap: 0.75rem 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .sqt-api,
  .sqt-environment {
    min-width: 0;
    padding: 1rem 0.875rem;
    border: 1px solid var(--color-border-secondary);
    border-radius: 0.875rem;
    background: var(--surface-bg);
  }
  .sqt-title {
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .sqt-description {
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .sqt-record {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.75rem;
  }
  .sqt-record strong {
    font-weight: 650;
  }
  .sqt-record > span {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.375rem;
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
  }
  .sqt-record b {
    font-weight: 550;
    color: var(--color-text-primary);
  }
  .sqt-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.875rem;
  }
  .sqt-heading > span {
    color: var(--color-text-secondary);
    font-size: 0.625rem;
  }
  .sqt-cache {
    overflow: hidden;
    border: 1px solid var(--color-border-secondary);
    border-radius: 0.5rem;
  }
  .sqt-cache__label {
    padding: 0.5rem;
    background: var(--color-bg-tertiary);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .sqt-key {
    display: block;
    padding: 0.625rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }
  .sqt-data {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem;
    background: var(--demo-a-soft);
    color: var(--color-link);
    font-size: 0.75rem;
  }
  .sqt-data strong {
    font-weight: 650;
  }
  .sqt-operation {
    display: grid;
    gap: 0.1875rem;
    margin-top: 0.875rem;
  }
  .sqt-operation code,
  .sqt-reader code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .sqt-operation > span {
    font-size: 0.625rem;
    color: var(--color-text-secondary);
  }
  .sqt-operation--restore {
    margin: 0 0 0.875rem;
  }
  .sqt-reader {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-top: 0.875rem;
  }
  .sqt-reader > span {
    font-size: 0.625rem;
    color: var(--color-text-secondary);
  }
  .sqt-arrow {
    display: grid;
    place-items: center;
    color: var(--color-text-secondary);
  }
  .sqt-arrow svg {
    width: 2rem;
    height: 1.5rem;
  }
  .sqt-payload {
    grid-column: 3 / -1;
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--color-bg-tertiary);
    font-size: 0.6875rem;
  }
  .sqt-payload > span {
    font-weight: 650;
  }
  .sqt-fields {
    font-size: 0.625rem;
    color: var(--color-text-secondary);
  }
  @media (max-width: 42rem) {
    .sqt {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.625rem;
    }
    .sqt-api,
    .sqt-environment {
      padding: 1rem;
    }
    .sqt-record {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
    .sqt-arrow svg {
      transform: rotate(90deg);
    }
    .sqt-payload {
      grid-column: 1;
    }
    .sqt-key br {
      display: none;
    }
    .sqt-key {
      font-size: 0.6875rem;
    }
    .sqt-cache__label,
    .sqt-operation > span,
    .sqt-heading > span,
    .sqt-reader > span {
      font-size: 0.6875rem;
    }
  }
</style>
