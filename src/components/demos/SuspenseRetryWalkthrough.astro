---
import Demo from './Demo.astro';
const phases = ['대기', '완료 알림', '재호출', '결과 계산', '커밋'];
---

<Demo
  title="Promise 완료와 화면 변경 사이"
  hint="다음을 눌러 Promise, 컴포넌트 실행, 화면이 바뀌는 시점을 비교해 보세요."
  caption="설명용 모형 · 처음 표시한 fallback이 요청 성공 후 목록으로 바뀌는 흐름입니다."
>
  <Fragment slot="controls">
    <button type="button" class="demo-btn demo-btn--primary" data-el="next">다음</button>
    <span class="demo-label" data-el="count">1 / 5</span>
  </Fragment>
  <div class="srw" data-demo="suspense-retry" data-step="0">
    <ol class="srw-phases" aria-label="렌더링 진행 단계">
      {
        phases.map((phase, i) => (
          <li data-phase={i} aria-current={i === 0 ? 'step' : undefined}>
            <span>{i + 1}</span>
            {phase}
          </li>
        ))
      }
    </ol>
    <div class="srw-promise">
      <code>itemsPromise</code>
      <span class="srw-state" data-el="promise">대기 중</span>
    </div>
    <div class="srw-scene">
      <div class="srw-panel">
        <div class="srw-label">컴포넌트 실행</div>
        <div class="srw-code">
          <code data-line="0">function Recommendations(…) {'{'}</code>
          <code data-line="1"> const items = use(itemsPromise);</code>
          <code data-line="2"> return &lt;목록 items={'{items}'} /&gt;;</code>
          <code>{'}'}</code>
        </div>
        <span class="srw-result" data-el="result">use에서 중단</span>
      </div>
      <div class="srw-panel">
        <div class="srw-label">화면에 반영된 내용</div>
        <div class="srw-screen">
          <div class="srw-product">무선 키보드 <span>89,000원</span></div>
          <div class="srw-boundary">
            <span class="srw-boundary-label">Suspense</span>
            <div class="srw-fallback" data-el="fallback">
              <div class="srw-bars" aria-hidden="true"><span></span><span></span></div>
              추천 상품을 불러오는 중
            </div>
            <div class="srw-items" data-el="items" hidden>
              <span>추천 상품</span><strong>손목 받침대</strong><strong>키보드 파우치</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="demo-status" aria-live="polite" aria-atomic="true" data-el="status">추천 목록 대신 fallback을 표시했습니다.</p>
  </div>
</Demo>

<style>
  .srw {
    font-size: 0.8125rem;
    color: var(--color-text-primary);
  }
  .srw-phases {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .srw-phases li {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .srw-phases li > span {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--color-border-secondary);
    border-radius: 50%;
  }
  .srw-phases li[aria-current='step'] {
    color: var(--demo-a);
    font-weight: 700;
  }
  .srw-phases li[aria-current='step'] > span {
    border-color: var(--demo-a);
    background: var(--demo-a-soft);
  }
  .srw-promise {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: var(--color-bg-tertiary);
    border-radius: 0.625rem;
  }
  .srw-promise code {
    font-family: var(--font-mono);
  }
  .srw-state {
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--color-border-secondary);
    border-radius: 1rem;
    font-size: 0.75rem;
  }
  .srw:not([data-step='0']) .srw-state {
    border-style: solid;
    border-color: var(--demo-a);
    color: var(--demo-a);
    background: var(--demo-a-soft);
  }
  .srw-scene {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1rem;
  }
  .srw-panel {
    min-width: 0;
  }
  .srw-label {
    margin-bottom: 0.625rem;
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--color-text-secondary);
  }
  .srw-code {
    padding: 0.625rem 0;
    border: 1px solid var(--color-border-secondary);
    border-radius: 0.75rem;
  }
  .srw-code code {
    display: block;
    padding: 0.375rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .srw-code code[data-current] {
    background: var(--demo-a-soft);
    color: var(--demo-a);
  }
  .srw-result {
    display: block;
    margin-top: 0.625rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }
  .srw-product {
    display: grid;
    gap: 0.25rem;
    padding: 0.625rem;
    background: var(--color-bg-tertiary);
    border-radius: 0.5rem;
  }
  .srw-product span {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
  .srw-boundary {
    padding: 0.625rem;
    margin-top: 0.625rem;
    border: 1px solid var(--demo-a);
    border-radius: 0.75rem;
  }
  .srw-boundary-label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--demo-a);
  }
  .srw-fallback,
  .srw-items {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    min-height: 6.25rem;
    padding: 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
  }
  .srw-fallback {
    border: 1px dashed var(--color-border-secondary);
    color: var(--color-text-secondary);
  }
  .srw-items {
    background: var(--demo-a-soft);
  }
  .srw-items > span {
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .srw-fallback[hidden],
  .srw-items[hidden] {
    display: none;
  }
  .srw-bars {
    display: grid;
    gap: 0.5rem;
  }
  .srw-bars span {
    height: 0.375rem;
    width: 85%;
    background: var(--color-border-secondary);
    border-radius: 1rem;
  }
  .srw-bars span + span {
    width: 60%;
  }
  @media (max-width: 34rem) {
    .srw-scene {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-demo="suspense-retry"]').forEach((root) => {
    const shell = root.closest('.demo')!;
    const el = <T extends HTMLElement>(name: string) => shell.querySelector<T>(`[data-el="${name}"]`)!;
    const next = el<HTMLButtonElement>('next');
    const steps = [
      { line: 1, result: 'use에서 중단', status: '추천 목록 대신 fallback을 표시했습니다.' },
      { line: -1, result: '재시도 예약', status: 'Promise가 완료되어 재시도를 예약합니다.' },
      { line: 0, result: '함수의 처음부터 실행', status: '컴포넌트를 처음부터 다시 호출합니다.' },
      { line: 2, result: 'use가 값을 반환 → 목록 계산', status: '완료된 값으로 목록을 계산합니다.' },
      { line: -1, result: '렌더링 결과를 DOM에 반영', status: '커밋한 목록이 화면에 나타납니다.' },
    ];
    let step = 0;
    const render = () => {
      const done = step === steps.length - 1;
      root.dataset.step = String(step);
      el('count').textContent = `${step + 1} / ${steps.length}${done ? ' · 완료' : ''}`;
      el('promise').textContent = step === 0 ? '대기 중' : '성공';
      el('result').textContent = steps[step].result;
      el('status').textContent = steps[step].status;
      // Promise가 완료돼도 커밋 단계 전까지는 기존 fallback을 남깁니다.
      el('fallback').hidden = done;
      el('items').hidden = !done;
      root.querySelectorAll<HTMLElement>('[data-line]').forEach((line) => {
        line.toggleAttribute('data-current', Number(line.dataset.line) === steps[step].line);
      });
      root.querySelectorAll<HTMLElement>('[data-phase]').forEach((phase) => {
        if (Number(phase.dataset.phase) === step) phase.setAttribute('aria-current', 'step');
        else phase.removeAttribute('aria-current');
      });
      next.textContent = done ? '처음부터' : '다음';
      next.classList.toggle('demo-btn--primary', !done);
    };
    next.addEventListener('click', () => {
      step = (step + 1) % steps.length;
      render();
    });
    render();
  });
</script>
