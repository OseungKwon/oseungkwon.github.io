---
import InfraDiagram from './InfraDiagram.astro';
---

<InfraDiagram caption="상품 앱의 Service가 요청을 받을 준비가 된 Pod들을 연결합니다.">
  <div class="iwm">
    <div class="iwm-router">HTTP 라우터<span aria-hidden="true"></span></div>
    <div class="iwm-cluster">
      <div class="iwm-label">Kubernetes 클러스터</div>
      <div class="iwm-service">Service · product-web</div>
      <div class="iwm-branch" aria-hidden="true"><span></span><span></span></div>
      <div class="iwm-pods">
        {
          ['A', 'B'].map((name) => (
            <div class="iwm-pod">
              <span class="iwm-ready">Ready</span>
              <strong>Pod {name}</strong>
              <span>앱 프로세스 :3000</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</InfraDiagram>
<style>
  .iwm {
    font-size: var(--infra-body);
  }
  .iwm-label {
    font-size: var(--infra-note);
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }
  .iwm-router {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: center;
    margin-bottom: 10px;
    font-weight: 600;
    font-size: var(--infra-title);
  }
  .iwm-router span {
    position: relative;
    width: 10px;
    height: 28px;
    align-self: center;
  }
  .iwm-router span::before,
  .iwm-branch span::before {
    content: '';
    position: absolute;
    left: calc(50% - 1px);
    top: 0;
    bottom: 2px;
    width: 2px;
    background: var(--demo-a);
  }
  .iwm-router span::after,
  .iwm-branch span::after {
    content: '';
    position: absolute;
    left: calc(50% - 5px);
    bottom: 0;
    width: 10px;
    height: 8px;
    background: var(--demo-a);
    clip-path: polygon(0 0, 50% 65%, 100% 0, 100% 25%, 50% 100%, 0 25%);
  }
  .iwm-service {
    width: fit-content;
    margin: 12px auto 0;
    border: 1px solid var(--demo-a);
    background: var(--demo-a-soft);
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 600;
  }
  .iwm-branch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    height: 44px;
    margin-bottom: 4px;
  }
  .iwm-branch span {
    position: relative;
  }
  .iwm-branch span::before {
    top: 16px;
  }
  .iwm-branch::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(50% - 1px);
    height: 16px;
    width: 2px;
    background: var(--demo-a);
  }
  .iwm-branch::after {
    content: '';
    position: absolute;
    top: 16px;
    left: calc(25% - 3px);
    right: calc(25% - 3px);
    height: 2px;
    background: var(--demo-a);
  }
  .iwm-cluster {
    border: 1px dashed var(--infra-border);
    border-radius: var(--infra-radius);
    padding: 14px;
  }
  .iwm-pods {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .iwm-pod {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 0;
    border: 1px solid var(--demo-a);
    border-radius: 8px;
    padding: 12px;
    background: var(--demo-a-soft);
  }
  .iwm-pod > strong {
    font-size: var(--infra-title);
  }
  .iwm-pod > :last-child {
    font-size: var(--infra-note);
    color: var(--color-text-secondary);
  }
  .iwm-ready {
    font-size: var(--infra-note);
    color: var(--demo-a);
  }
  @media (max-width: 460px) {
    .iwm-pods {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .iwm-cluster {
      padding: 10px;
    }
  }
</style>
