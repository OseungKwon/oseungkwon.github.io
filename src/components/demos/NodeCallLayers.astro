---
/**
 * 호출 하나가 지나는 계층 — 이동하는 블록형 데모.
 *
 * 글(nodejs-runtime-anatomy)의 "fs.readFile() 호출 하나는 내장 모듈, 바인딩,
 * libuv를 거쳐 운영체제까지 내려간다"를 보여준다. 호출 블록(fs)이 계층을
 * 따라 내려갔다 올라오고, 맨 위 app.js의 띠는 그동안 메인 스레드가 실행 중인 줄이다.
 *
 * readFile은 libuv에 작업을 넘긴 뒤 띠가 다음 줄로 넘어가지만, readFileSync는
 * 블록이 돌아올 때까지 띠가 첫 줄에 묶인다(경고색). 같은 계층을 지나는데도
 * 운영체제 작업을 누가 맡느냐(워커 스레드/메인 스레드)만 다르다.
 */
import Demo from './Demo.astro';

const LAYERS = [
  ['lib', '내장 모듈', 'lib/fs.js가 인수를 검사하고 콜백을 등록합니다'],
  ['bind', '바인딩', 'C++ 코드가 JS 호출을 libuv 요청으로 바꿉니다'],
  ['uv', 'libuv', '작업을 스레드풀에 넘기거나 그 자리에서 실행합니다'],
  ['os', '운영체제', 'open, read, close 시스템 콜'],
];
---

<Demo
  title="fs.readFile() 호출이 내려가는 계층"
  hint="단계를 넘기며 fs 블록을 따라가 보세요. readFileSync로 바꾸면 app.js의 띠가 첫 줄에서 움직이지 않습니다."
  caption="Node.js와 libuv 문서를 바탕으로 만든 설명용 모형입니다. 실제 readFile은 open·read·close를 따로 요청하며 스레드풀을 여러 번 오갑니다."
>
  <Fragment slot="controls">
    <div class="demo-seg" role="group" aria-label="호출 방식">
      <button class="demo-seg__opt" type="button" data-mode="async" aria-pressed="true">readFile</button>
      <button class="demo-seg__opt" type="button" data-mode="sync" aria-pressed="false">readFileSync</button>
    </div>
    <div class="demo-nav">
      <button class="demo-btn" type="button" data-act="back">이전</button>
      <span class="demo-label" data-el="count"></span>
      <button class="demo-btn demo-btn--primary" type="button" data-act="next">다음</button>
    </div>
  </Fragment>

  <div class="cl" data-demo="call-layers">
    <div class="cl-stack">
      <div class="demo-lane cl-lane cl-lane--app" data-layer="app">
        <div class="cl-app">
          <span class="demo-lane__name">app.js</span>
          <ol class="demo-lines">
            {[1, 2, 3].map((n) => <li class="demo-line" data-line={n} data-el={`src${n}`} />)}
          </ol>
        </div>
        <span class="demo-slot cl-slot" data-anchor="app"></span>
      </div>

      {
        LAYERS.map(([key, name, desc]) => (
          <div class="demo-lane cl-lane" data-layer={key}>
            <span class="demo-lane__name cl-name">{name}</span>
            <span class="demo-lane__desc">{desc}</span>
            {key === 'os' && <span class="cl-thread" data-el="thread" />}
            <span class="demo-slot cl-slot" data-anchor={key} />
          </div>
        ))
      }

      <span class="demo-token" data-token="call">fs</span>
    </div>

    <p class="demo-status" data-el="status" aria-live="polite"></p>
  </div>
</Demo>

<style>
  /* 블록이 오르내리는 세로 축. 각 레인의 자리를 한 줄로 잇는다. */
  .cl-stack {
    position: relative;
    display: grid;
    gap: 0.25rem;
  }

  .cl-stack::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: 1.25rem;
    bottom: 1.25rem;
    right: calc(0.625rem + 0.75rem - 0.5px);
    width: 1px;
    background-color: var(--color-border-primary);
  }

  /* 계층 이름과 설명이 이 데모의 본문이다. 본문 바로 아래 단계로 키운다. */
  .cl-lane {
    min-height: 3rem;
    padding: 0.625rem 0.625rem 0.625rem 0.875rem;
  }

  .cl-lane .demo-lane__name {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .cl-lane .demo-lane__desc {
    font-size: 0.8125rem;
  }

  .cl-lane[data-on] .demo-lane__desc {
    color: var(--color-text-primary);
  }

  .cl-lane--app {
    align-items: stretch;
    padding-block: 0.75rem;
  }

  .cl-app .demo-line {
    font-size: 0.8125rem;
  }

  .cl-app .demo-line[data-current] {
    font-weight: 600;
  }

  .cl-slot {
    align-self: center;
    margin-left: auto;
  }

  .cl-app {
    display: grid;
    flex: 1 1 auto;
    gap: 0.375rem;
    min-width: 0;
  }

  /* 코드 띠가 레인 가장자리와 맞도록 줄 안쪽 여백만큼 당긴다. */
  .cl-app .demo-lines {
    margin-left: -0.5rem;
  }

  .cl-name {
    width: 5.25rem;
  }

  .cl-thread {
    flex: none;
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--color-text-secondary);
  }

  .cl-thread[data-tone='worker'] {
    color: var(--demo-a);
  }

  .cl-thread[data-tone='main'] {
    color: var(--demo-warn);
  }

  .cl-thread + .cl-slot {
    margin-left: 0;
  }

  @media (max-width: 34rem) {
    .cl-lane:not(.cl-lane--app) {
      flex-wrap: wrap;
      row-gap: 0.125rem;
      padding-right: 2.5rem;
      position: relative;
    }

    .cl-lane:not(.cl-lane--app) .demo-lane__desc {
      flex-basis: 100%;
      order: 3;
    }

    .cl-lane:not(.cl-lane--app) .cl-slot {
      position: absolute;
      top: 50%;
      right: 0.625rem;
      margin-top: -0.75rem;
    }
  }
</style>

<script>
  import { createTokens } from './lib/tokens';

  type Mode = 'async' | 'sync';

  interface Step {
    status: string;
    /** 호출 블록이 있는 계층 */
    at: string;
    /** 메인 스레드가 실행 중인 줄 */
    line: 1 | 2 | 3;
    /** 운영체제 작업을 맡은 스레드 */
    os?: 'worker' | 'main';
    /** 메인 스레드가 호출이 돌아오기만 기다리는 중 */
    blocked?: boolean;
  }

  const CODE: Record<Mode, string[]> = {
    async: ["fs.readFile('a.txt', cb);", "console.log('다음 줄');", 'function cb(err, data) { … }'],
    sync: ["const data = fs.readFileSync('a.txt');", "console.log('다음 줄');", 'use(data);'],
  };

  const STEPS: Record<Mode, Step[]> = {
    async: [
      { status: 'fs.readFile()을 호출합니다.', at: 'app', line: 1 },
      { status: '내장 모듈이 인수를 검사합니다.', at: 'lib', line: 1 },
      { status: '바인딩이 libuv 요청으로 바꿉니다.', at: 'bind', line: 1 },
      { status: 'libuv가 스레드풀에 넘기면, 메인 스레드는 다음 줄로 갑니다.', at: 'uv', line: 2 },
      { status: '워커 스레드가 파일을 읽습니다.', at: 'os', line: 2, os: 'worker' },
      { status: '읽기가 끝나면 poll 단계가 완료를 받습니다.', at: 'uv', line: 2 },
      { status: '콜백이 메인 스레드에서 실행됩니다.', at: 'app', line: 3 },
    ],
    sync: [
      { status: 'fs.readFileSync()를 호출합니다.', at: 'app', line: 1 },
      { status: '내장 모듈이 인수를 검사합니다.', at: 'lib', line: 1, blocked: true },
      { status: '바인딩이 libuv 요청으로 바꿉니다.', at: 'bind', line: 1, blocked: true },
      { status: 'libuv가 스레드풀에 넘기지 않고 그 자리에서 실행합니다.', at: 'uv', line: 1, blocked: true },
      { status: '메인 스레드가 직접 파일을 읽습니다.', at: 'os', line: 1, os: 'main', blocked: true },
      { status: '읽기가 끝나야 값이 돌아옵니다.', at: 'uv', line: 1, blocked: true },
      { status: '그제야 다음 줄로 넘어갑니다.', at: 'app', line: 2 },
    ],
  };

  document.querySelectorAll<HTMLElement>('[data-demo="call-layers"]').forEach((root) => {
    const shell = root.closest('.demo');
    if (!shell) return;

    const el = <T extends HTMLElement>(name: string) => shell.querySelector<T>(`[data-el="${name}"]`)!;
    const layers = root.querySelectorAll<HTMLElement>('[data-layer]');
    const lines = root.querySelectorAll<HTMLElement>('[data-line]');
    const segs = shell.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const nextBtn = shell.querySelector<HTMLButtonElement>('[data-act="next"]')!;
    const backBtn = shell.querySelector<HTMLButtonElement>('[data-act="back"]')!;
    const tokens = createTokens(root.querySelector<HTMLElement>('.cl-stack')!);

    let mode: Mode = 'async';
    let step = 0;

    const render = (instant = false) => {
      const steps = STEPS[mode];
      const s = steps[step];

      el('status').textContent = s.status;
      el('count').textContent = `${step + 1} / ${steps.length}`;
      nextBtn.disabled = step === steps.length - 1;
      backBtn.disabled = step === 0;

      lines.forEach((line, i) => {
        line.textContent = CODE[mode][i];
        line.toggleAttribute('data-current', i + 1 === s.line);
        line.toggleAttribute('data-warn', Boolean(s.blocked));
      });
      layers.forEach((layer) => layer.toggleAttribute('data-on', layer.dataset.layer === s.at));

      // 운영체제 계층만 누가 일하는지가 방식에 따라 갈린다.
      const thread = el('thread');
      thread.textContent = mode === 'async' ? '워커 스레드' : '메인 스레드';
      thread.dataset.tone = s.os ?? '';

      tokens.place({ call: s.at }, instant);
    };

    nextBtn.addEventListener('click', () => {
      if (step < STEPS[mode].length - 1) step++;
      render();
    });
    backBtn.addEventListener('click', () => {
      if (step > 0) step--;
      render();
    });
    segs.forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.mode as Mode;
        segs.forEach((other) => other.setAttribute('aria-pressed', String(other === btn)));
        step = 0;
        render();
      });
    });

    render(true);
  });
</script>
