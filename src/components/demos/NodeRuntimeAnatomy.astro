---
/**
 * Node.js 런타임 해부도 — 단계 진행형 데모.
 *
 * 글(nodejs-runtime-anatomy)의 "비동기 작업마다 맡는 부품이 다르고, 그동안
 * 콜 스택은 비어 있다"를 보여준다. 코드 한 줄을 고르고 단계를 넘기면
 * 그 호출이 지나가는 부품에 테두리가 켜진다.
 *
 * 요지는 우상단 배지 하나가 말한다. fs.readFile·fetch·setTimeout은 중간
 * 단계에서 '콜 스택 비어 있음'으로 바뀌지만, pbkdf2Sync는 끝날 때까지
 * '사용 중'에 머물고 이벤트 루프 여섯 단계가 함께 멈춘다.
 */
import Demo from './Demo.astro';

const PHASES = [
  ['timers', 'timers'],
  ['pending', 'pending'],
  ['idle', 'idle·prepare'],
  ['poll', 'poll'],
  ['check', 'check'],
  ['close', 'close'],
];
const WORKERS = [0, 1, 2, 3];
---

<Demo
  title="코드 한 줄이 Node.js 런타임을 지나는 경로"
  hint="코드를 고르고 단계를 넘겨 보세요. 오른쪽 위 배지가 콜 스택이 비어 있는지 알려 줍니다."
  caption="Node.js 공식 문서와 libuv 설계 문서를 바탕으로 만든 설명용 모형입니다. fs.readFile이 open·read·close로 나뉘어 스레드풀을 여러 번 오가는 과정과, fetch가 호스트 이름을 조회할 때(dns.lookup) 스레드풀을 쓰는 과정은 생략했습니다."
>
  <Fragment slot="controls">
    <div class="demo-seg na-seg" role="group" aria-label="실행할 코드">
      <button class="demo-seg__opt" type="button" data-scenario="readFile" aria-pressed="true">fs.readFile</button>
      <button class="demo-seg__opt" type="button" data-scenario="fetch" aria-pressed="false">fetch</button>
      <button class="demo-seg__opt" type="button" data-scenario="timeout" aria-pressed="false">setTimeout</button>
      <button class="demo-seg__opt" type="button" data-scenario="sync" aria-pressed="false">pbkdf2Sync</button>
    </div>
    <span class="demo__spacer"></span>
    <button class="demo-btn" type="button" data-act="back">이전</button>
    <button class="demo-btn demo-btn--primary" type="button" data-act="next">다음</button>
    <span class="na-count demo-code" data-el="count"></span>
  </Fragment>

  <div class="na" data-demo="node-anatomy">
    <div class="na-top">
      <p class="na-headline" data-el="headline" aria-live="polite"></p>
      <span class="na-state" data-el="state"></span>
    </div>

    <div class="na-layer">
      <div class="na-layer__name">V8 · 메인 스레드</div>
      <div class="na-row na-row--v8">
        <div class="na-box" data-node="stack">
          <span class="na-box__name">Call Stack</span>
          <code class="na-slot" data-el="stack"></code>
        </div>
        <div class="na-box" data-node="micro">
          <span class="na-box__name">Microtask Queue</span>
          <span class="na-box__sub">nextTick · Promise</span>
          <code class="na-slot" data-el="micro"></code>
        </div>
      </div>
    </div>

    <div class="na-layer">
      <div class="na-layer__name">Node.js 바인딩 · C++</div>
      <div class="na-box na-box--wide" data-node="bind">
        <span class="na-box__name">Bindings</span>
        <span class="na-box__sub">JS 호출을 libuv 요청으로 바꿉니다</span>
      </div>
    </div>

    <div class="na-layer">
      <div class="na-layer__name">libuv · C</div>
      <div class="na-box na-box--wide" data-node="loop">
        <span class="na-box__name">
          Event Loop <span class="na-tag">메인 스레드</span>
        </span>
        <ol class="na-phases">
          {
            PHASES.map(([key, label]) => (
              <li class="na-phase" data-phase={key}>
                {label}
              </li>
            ))
          }
        </ol>
      </div>
      <div class="na-box na-box--wide" data-node="pool">
        <span class="na-box__name">
          Thread Pool <span class="na-tag">별도 스레드 ×4</span>
        </span>
        <div class="na-workers">
          {WORKERS.map((i) => <span class="na-worker" data-worker={i} />)}
        </div>
      </div>
    </div>

    <div class="na-layer">
      <div class="na-layer__name">운영체제</div>
      <div class="na-box na-box--wide" data-node="kernel">
        <span class="na-box__name na-box__name--text">커널 I/O 알림</span>
        <span class="na-box__sub">epoll · kqueue · IOCP</span>
        <span class="na-slot na-slot--text" data-el="kernel"></span>
      </div>
    </div>
  </div>
</Demo>

<style>
  .na-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .na-headline {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  /* 이 데모가 주목시키는 상태 하나. 비어 있으면 블루, 사용 중이면 뉴트럴, 막혔으면 경고색. */
  .na-state {
    flex: none;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border-secondary);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--demo-b);
    white-space: nowrap;
  }

  .na-state[data-tone='free'] {
    border-color: var(--demo-a);
    background-color: var(--demo-a-soft);
    color: var(--demo-a);
  }

  .na-state[data-tone='blocked'] {
    border-color: var(--demo-warn);
    background-color: var(--demo-warn-soft);
    color: var(--demo-warn);
  }

  .na-layer {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .na-layer__name {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-text-tertiary);
  }

  .na-row--v8 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  /* 부품은 채움과 테두리 전체로 상태를 말한다. */
  .na-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-border-secondary);
    border-radius: 0.75rem;
    transition:
      border-color 0.16s ease,
      background-color 0.16s ease;
  }

  .na-box[data-on] {
    border-color: var(--demo-a);
    background-color: var(--demo-a-soft);
  }

  .na-box[data-blocked] {
    border-color: var(--demo-warn);
    background-color: var(--demo-warn-soft);
  }

  .na-box__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  /* 한글 라벨은 모노 서체에서 자간이 벌어지므로 본문 서체로 되돌린다. */
  .na-box__name--text,
  .na-slot--text {
    font-family: var(--font-sans);
  }

  .na-box__sub {
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
  }

  .na-tag {
    padding: 0.0625rem 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-bg-tertiary);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  /* 빈 슬롯은 점선, 채워지면 실선. */
  .na-slot {
    display: block;
    min-height: 1.75rem;
    margin-top: 0.25rem;
    padding: 0.3125rem 0.5rem;
    border: 1px dashed var(--color-border-secondary);
    border-radius: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }

  .na-slot[data-filled] {
    border-style: solid;
    border-color: var(--color-border-primary);
    background-color: var(--surface-bg);
  }

  .na-phases {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .na-phase {
    padding: 0.3125rem 0.125rem;
    border: 1px solid var(--color-border-secondary);
    border-radius: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-align: center;
    color: var(--color-text-tertiary);
    overflow-wrap: anywhere;
    transition:
      border-color 0.16s ease,
      background-color 0.16s ease,
      color 0.16s ease;
  }

  .na-phase[data-on] {
    border-color: var(--demo-a);
    background-color: var(--surface-bg);
    font-weight: 700;
    color: var(--demo-a);
  }

  /* 동기 작업 중에는 여섯 단계가 모두 멈춘다. */
  .na-box[data-blocked] .na-phase {
    border-style: dashed;
    border-color: var(--demo-warn);
    color: var(--demo-warn);
    opacity: 0.6;
  }

  .na-workers {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .na-worker {
    width: 1.75rem;
    height: 0.75rem;
    border: 1px dashed var(--color-border-secondary);
    border-radius: 9999px;
  }

  .na-worker[data-busy] {
    border-style: solid;
    border-color: var(--demo-a);
    background-color: var(--demo-a);
  }

  .na-slot[hidden] {
    display: none;
  }

  .na-count {
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 34rem) {
    .na-top {
      flex-direction: column;
    }

    .na-row--v8 {
      grid-template-columns: minmax(0, 1fr);
    }

    .na-phases {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* 네 개의 코드 이름이 한 줄에 들어가지 않으므로 옵션 간격을 줄인다. */
    .na-seg :global(.demo-seg__opt) {
      padding-inline: 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  type Tone = 'busy' | 'free' | 'blocked';

  interface Step {
    /** 한 줄 상태 */
    line: string;
    /** 테두리를 켤 부품 */
    on: string[];
    /** 콜 스택 상태 배지 */
    tone: Tone;
    stack?: string;
    micro?: string;
    kernel?: string;
    phase?: string;
    workers?: number;
    /** 동기 작업이 루프를 막는 중 */
    blocked?: boolean;
  }

  const SCENARIOS: Record<string, Step[]> = {
    readFile: [
      { line: 'fs.readFile()을 호출합니다', on: ['stack'], tone: 'busy', stack: "fs.readFile('a.txt', cb)" },
      { line: '바인딩이 libuv에 작업을 넘깁니다', on: ['bind'], tone: 'busy', stack: "fs.readFile('a.txt', cb)" },
      { line: '워커 스레드가 파일을 읽습니다', on: ['pool'], tone: 'free', workers: 1 },
      { line: 'poll 단계가 완료를 받습니다', on: ['loop'], tone: 'free', phase: 'poll' },
      { line: '콜백을 콜 스택에서 실행합니다', on: ['stack'], tone: 'busy', stack: 'cb(null, data)', phase: 'poll' },
    ],
    fetch: [
      { line: 'fetch()를 호출합니다', on: ['stack'], tone: 'busy', stack: 'await fetch(url)' },
      { line: '소켓을 열고 커널에 감시를 맡깁니다', on: ['bind', 'kernel'], tone: 'busy', stack: 'await fetch(url)', kernel: 'socket 감시 중' },
      { line: '응답을 기다리는 동안 스레드는 쓰지 않습니다', on: ['kernel'], tone: 'free', kernel: 'socket 감시 중' },
      { line: '데이터가 도착하면 poll 단계가 알림을 받습니다', on: ['loop', 'kernel'], tone: 'free', phase: 'poll', kernel: '데이터 도착' },
      { line: 'Promise가 이행되어 마이크로태스크에 들어갑니다', on: ['micro'], tone: 'free', micro: 'resolve(response)', phase: 'poll' },
      { line: 'await 다음 코드가 이어서 실행됩니다', on: ['stack'], tone: 'busy', stack: 'const data = await res.json()', phase: 'poll' },
    ],
    timeout: [
      { line: 'setTimeout()을 호출합니다', on: ['stack'], tone: 'busy', stack: 'setTimeout(cb, 100)' },
      { line: 'libuv가 타이머를 등록합니다', on: ['loop'], tone: 'free', phase: 'timers' },
      { line: '100ms가 지나면 timers 단계에서 꺼냅니다', on: ['loop'], tone: 'free', phase: 'timers' },
      { line: '콜백을 콜 스택에서 실행합니다', on: ['stack'], tone: 'busy', stack: 'cb()', phase: 'timers' },
    ],
    sync: [
      { line: 'crypto.pbkdf2Sync()를 호출합니다', on: ['stack'], tone: 'busy', stack: 'crypto.pbkdf2Sync(pw, salt, ...)' },
      { line: '메인 스레드가 직접 해시를 계산합니다', on: [], tone: 'blocked', stack: 'crypto.pbkdf2Sync(pw, salt, ...)', blocked: true },
      { line: '그동안 이벤트 루프는 한 단계도 돌지 못합니다', on: ['kernel'], tone: 'blocked', stack: 'crypto.pbkdf2Sync(pw, salt, ...)', kernel: '다른 요청 도착 · 처리 대기', blocked: true },
      { line: '계산이 끝나야 루프가 다시 돕니다', on: ['loop'], tone: 'free', phase: 'poll', kernel: '다른 요청 도착 · 처리 대기' },
    ],
  };

  const TONE_LABEL: Record<Tone, string> = {
    busy: '콜 스택 사용 중',
    free: '콜 스택 비어 있음',
    blocked: '콜 스택 점유 · 루프 멈춤',
  };

  document.querySelectorAll<HTMLElement>('[data-demo="node-anatomy"]').forEach((root) => {
    const shell = root.closest('.demo');
    if (!shell) return;

    const el = <T extends HTMLElement>(name: string) => shell.querySelector<T>(`[data-el="${name}"]`)!;
    const nodes = root.querySelectorAll<HTMLElement>('[data-node]');
    const phases = root.querySelectorAll<HTMLElement>('[data-phase]');
    const workers = root.querySelectorAll<HTMLElement>('[data-worker]');
    const segs = shell.querySelectorAll<HTMLButtonElement>('[data-scenario]');
    const nextBtn = shell.querySelector<HTMLButtonElement>('[data-act="next"]');
    const backBtn = shell.querySelector<HTMLButtonElement>('[data-act="back"]');

    let scenario = 'readFile';
    let step = 0;

    const setFlag = (node: Element, name: string, on: boolean) => {
      if (on) node.setAttribute(name, '');
      else node.removeAttribute(name);
    };

    const fill = (name: string, text?: string) => {
      const slot = el(name);
      slot.textContent = text ?? '';
      setFlag(slot, 'data-filled', Boolean(text));
    };

    const render = () => {
      const steps = SCENARIOS[scenario];
      const s = steps[step];

      el('headline').textContent = s.line;
      const state = el('state');
      state.textContent = TONE_LABEL[s.tone];
      state.dataset.tone = s.tone;
      el('count').textContent = `${step + 1} / ${steps.length}`;
      if (nextBtn) nextBtn.disabled = step === steps.length - 1;
      if (backBtn) backBtn.disabled = step === 0;

      nodes.forEach((node) => {
        const key = node.dataset.node!;
        setFlag(node, 'data-on', s.on.includes(key));
        // 동기 작업은 콜 스택과 루프를 함께 붙잡는다. 둘이 같은 스레드라서다.
        setFlag(node, 'data-blocked', Boolean(s.blocked) && (key === 'stack' || key === 'loop'));
      });
      phases.forEach((p) => setFlag(p, 'data-on', !s.blocked && p.dataset.phase === s.phase));
      workers.forEach((w, i) => setFlag(w, 'data-busy', i < (s.workers ?? 0)));

      fill('stack', s.stack);
      fill('micro', s.micro);
      fill('kernel', s.kernel);
    };

    nextBtn?.addEventListener('click', () => {
      if (step < SCENARIOS[scenario].length - 1) step++;
      render();
    });
    backBtn?.addEventListener('click', () => {
      if (step > 0) step--;
      render();
    });
    segs.forEach((btn) => {
      btn.addEventListener('click', () => {
        scenario = btn.dataset.scenario!;
        segs.forEach((other) => other.setAttribute('aria-pressed', String(other === btn)));
        step = 0;
        render();
      });
    });

    render();
  });
</script>
