---
/**
 * 쿠폰함 코드의 의존 구조 — 단계별 정적 구조도.
 *
 * 글(clean-architecture-coupon-wallet)은 요구사항이 붙을 때마다 코드를 나누는데,
 * 코드 조각이 흩어져 있어 지금까지 어떤 모양이 됐는지 한 번에 읽히지 않는다.
 * 같은 구조도를 절이 끝날 때마다 두고, 그 절에서 생긴 카드에만 '추가' 배지를 단다.
 * 독자는 앞 그림과 비교해 무엇이 늘었고 무엇이 그대로인지를 본다.
 *
 * - legacy  : 한 함수에 화면 상태·쿠폰 규칙·API 요청이 섞인 처음 모습
 * - wallet  : 엔티티와 쿠폰함 조회 유스케이스, API 인터페이스·구현을 나눈 뒤
 * - apply   : 적용 요청 유스케이스를 더한 뒤
 * - product : 상품 카드 최저가를 더한 뒤
 *
 * 층 사이 화살표는 import 방향이다. 엔티티 카드에는 '사용' 칩이 없어서,
 * 엔티티가 다른 층을 모른다는 점이 빈자리로 드러난다.
 * 강조는 안쪽일수록 진하게 준다. 엔티티(채움 + 블루 테두리) → 유스케이스(블루
 * 테두리) → 화면·인터페이스(뉴트럴 테두리) → fetch 구현(옅은 바닥).
 *
 * 사용법: <CouponDependencyMap stage="apply" />
 */
import Demo from './Demo.astro';

type Stage = 'legacy' | 'wallet' | 'apply' | 'product';

interface Props {
  stage: Stage;
}

const { stage } = Astro.props;

const ORDER: Stage[] = ['legacy', 'wallet', 'apply', 'product'];
const at = ORDER.indexOf(stage);
const shown = (since: Stage) => at >= ORDER.indexOf(since);
/** 이 단계에서 새로 생겼는가. 첫 구조도(wallet)는 전부 새것이라 배지를 달지 않는다 */
const added = (since: Stage) => since === stage && stage !== 'wallet';

type Use = { name: string; kind: 'usecase' | 'entity' | 'port' };
type Card = { name: string; since: Stage; role?: string; items?: string[]; uses?: Use[] };

const VIEWS: Card[] = [
  {
    name: '쿠폰함',
    since: 'wallet',
    uses: [
      { name: 'loadCouponWallet', kind: 'usecase' },
      ...(shown('apply') ? [{ name: 'applyCouponToOrder', kind: 'usecase' } as Use] : []),
    ],
  },
  {
    name: '상품 카드',
    since: 'product',
    uses: [{ name: 'getBestCouponPrice', kind: 'usecase' }],
  },
];

const USECASES: Card[] = [
  {
    name: 'loadCouponWallet',
    since: 'wallet',
    role: '쿠폰함 조회',
    uses: [
      { name: '쿠폰', kind: 'entity' },
      { name: 'CouponApi', kind: 'port' },
      { name: 'OrderApi', kind: 'port' },
    ],
  },
  {
    name: 'applyCouponToOrder',
    since: 'apply',
    role: '주문에 쿠폰 적용',
    uses: [
      { name: 'CouponApi', kind: 'port' },
      { name: 'loadCouponWallet', kind: 'usecase' },
    ],
  },
  {
    name: 'getBestCouponPrice',
    since: 'product',
    role: '상품 최저가',
    uses: [
      { name: '쿠폰', kind: 'entity' },
      { name: 'CouponApi', kind: 'port' },
      { name: 'ProductApi', kind: 'port' },
    ],
  },
];

const ENTITIES: Card[] = [
  { name: '쿠폰', since: 'wallet', items: ['Coupon', 'getCouponStatus', 'getCouponDiscount'] },
  { name: '상품', since: 'product', items: ['Product'] },
];

const PORTS: Card[] = [
  { name: 'CouponApi', since: 'wallet', items: ['listMine', 'applyToOrder'] },
  { name: 'OrderApi', since: 'wallet', items: ['getCurrent'] },
  { name: 'ProductApi', since: 'product', items: ['getById'] },
];

const IMPLS: Card[] = [
  { name: 'couponApi', since: 'wallet', items: ['toCoupon'] },
  { name: 'orderApi', since: 'wallet' },
  { name: 'productApi', since: 'product' },
];

const pick = (cards: Card[]) => cards.filter((c) => shown(c.since));
const views = pick(VIEWS);
const usecases = pick(USECASES);
const entities = pick(ENTITIES);
const ports = pick(PORTS);
const impls = pick(IMPLS);

const HEAD: Record<Stage, { title: string; caption: string }> = {
  legacy: {
    title: '처음 쿠폰함 코드의 구조',
    caption: '쿠폰 규칙이 클릭 함수와 목록 변환에 따로 들어 있습니다.',
  },
  wallet: {
    title: '쿠폰함 조회를 나눈 뒤의 의존 방향',
    caption: '화살표는 import 방향입니다. 엔티티는 다른 층을 사용하지 않습니다.',
  },
  apply: {
    title: '적용 요청을 더한 뒤',
    caption: '유스케이스가 하나 늘었고, 엔티티와 인터페이스는 그대로입니다.',
  },
  product: {
    title: '상품 카드 최저가를 더한 뒤',
    caption: '쿠폰 엔티티는 고치지 않고, 상품 쪽 카드만 늘어납니다.',
  },
};

/** 처음 코드: 한 함수 안의 관심사. 쿠폰 규칙만 블루로 칠해 중복이 보이게 한다 */
const LEGACY = [
  {
    name: 'handleCouponClick',
    groups: [
      { label: '화면 상태', kind: 'view', items: ['setMessage', 'setExpectedDiscount', 'setQuote'] },
      { label: '쿠폰 규칙', kind: 'rule', items: ['발급 후 30일', '5천 원 할인'] },
      { label: 'API 요청', kind: 'api', items: ['GET 쿠폰 목록', 'GET 현재 주문', 'PUT 쿠폰 적용'] },
    ],
  },
  {
    name: '목록 변환',
    groups: [
      { label: '화면 상태', kind: 'view', items: ['사용 가능 표시'] },
      { label: '쿠폰 규칙', kind: 'rule', items: ['발급 후 30일'] },
    ],
  },
];
---

<Demo title={HEAD[stage].title} caption={HEAD[stage].caption}>
  {
    stage === 'legacy' ? (
      <div
        class="cd-legacy"
        role="img"
        aria-label="화면 코드 두 곳이 화면 상태, 쿠폰 규칙, API 요청을 함께 가지고 있고, 발급 후 30일 조건이 두 곳에 들어 있습니다."
      >
        <section class="cd-band" data-layer="view">
          <div class="cd-band__head">
            <span class="cd-band__name">화면</span>
          </div>
          <div class="cd-cards" data-cols="2">
            {LEGACY.map((card) => (
              <div class="cd-card">
                {/^[a-z]/i.test(card.name) ? (
                  <code class="cd-card__code">{card.name}</code>
                ) : (
                  <span class="cd-card__name">{card.name}</span>
                )}
                {card.groups.map((g) => (
                  <div class="cd-group">
                    <span class="cd-group__label">{g.label}</span>
                    <ul class="cd-items">
                      {g.items.map((item) => (
                        <li class="cd-item" data-kind={g.kind} data-code={/^[a-z]+$/i.test(item) ? '' : undefined}>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </section>
      </div>
    ) : (
      <div
        class="cd"
        role="img"
        aria-label="화면은 유스케이스를, 유스케이스는 엔티티와 API 인터페이스를 사용하고, fetch 구현은 API 인터페이스를 구현합니다. 엔티티는 다른 층을 사용하지 않습니다."
      >
        <section class="cd-band" data-layer="view" style="grid-area: view">
          <div class="cd-band__head">
            <span class="cd-band__name">화면</span>
            <span class="cd-band__reason">표시 방식이 바뀔 때</span>
          </div>
          <div class="cd-cards" data-cols={views.length}>
            {views.map((card) => (
              <div class="cd-card" data-new={added(card.since) ? '' : undefined}>
                <span class="cd-card__name">{card.name}</span>
                <ul class="cd-uses">
                  {card.uses?.map((u) => (
                    <li class="cd-use" data-kind={u.kind}>
                      {u.name}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <div class="cd-arrow" style="grid-area: a1" aria-hidden="true" />

        <section class="cd-band" data-layer="usecase" style="grid-area: usecase">
          <div class="cd-band__head">
            <span class="cd-band__name">유스케이스</span>
            <span class="cd-band__reason">조회·조합 순서가 바뀔 때</span>
          </div>
          <div class="cd-cards" data-cols={usecases.length}>
            {usecases.map((card) => (
              <div class="cd-card" data-new={added(card.since) ? '' : undefined}>
                <code class="cd-card__code">{card.name}</code>
                <span class="cd-card__role">{card.role}</span>
                <ul class="cd-uses">
                  {card.uses?.map((u) => (
                    <li class="cd-use" data-kind={u.kind}>
                      {u.name}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <div class="cd-arrow" style="grid-area: a2" aria-hidden="true" />
        <div class="cd-arrow" style="grid-area: a3" aria-hidden="true" />

        <section class="cd-band" data-layer="entity" style="grid-area: entity">
          <div class="cd-band__head">
            <span class="cd-band__name">엔티티</span>
            <span class="cd-band__reason">업무 규칙이 바뀔 때</span>
          </div>
          <div class="cd-cards">
            {entities.map((card) => (
              <div class="cd-card" data-new={added(card.since) ? '' : undefined}>
                <span class="cd-card__name">{card.name}</span>
                <ul class="cd-items">
                  {card.items?.map((item) => (
                    <li class="cd-item">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class="cd-band" data-layer="port" style="grid-area: port">
          <div class="cd-band__head">
            <span class="cd-band__name">API 인터페이스</span>
            <span class="cd-band__reason">필요한 통신이 바뀔 때</span>
          </div>
          <div class="cd-cards">
            {ports.map((card) => (
              <div class="cd-card" data-new={added(card.since) ? '' : undefined}>
                <code class="cd-card__code">{card.name}</code>
                <ul class="cd-items">
                  {card.items?.map((item) => (
                    <li class="cd-item">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <div class="cd-arrow" data-kind="implements" style="grid-area: a4" aria-hidden="true">
          <span class="cd-arrow__label">구현</span>
        </div>

        <section class="cd-band" data-layer="impl" style="grid-area: impl">
          <div class="cd-band__head">
            <span class="cd-band__name">fetch 구현</span>
            <span class="cd-band__reason">URL·응답 형식이 바뀔 때</span>
          </div>
          <ul class="cd-items">
            {impls.map((card) => (
              <li class="cd-item" data-new={added(card.since) ? '' : undefined}>
                {card.name}
                {card.items && <span class="cd-item__sub">· {card.items.join(', ')}</span>}
              </li>
            ))}
          </ul>
        </section>
      </div>
    )
  }
</Demo>

<style>
  .cd {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'view    view'
      'a1      a1'
      'usecase usecase'
      'a2      a3'
      'entity  port'
      '.       a4'
      '.       impl';
    column-gap: 0.75rem;
  }

  .cd-band {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.625rem;
    border: 1px solid var(--color-border-primary);
    border-radius: 0.875rem;
  }

  .cd-band[data-layer='usecase'] {
    border-color: var(--demo-a);
  }

  /* 옆의 인터페이스 층 높이에 맞춰 늘어나면 아래가 비어 보이므로 내용만큼만 둔다 */
  .cd-band[data-layer='entity'] {
    align-self: start;
    border-color: var(--demo-a);
    background-color: var(--demo-a-soft);
  }

  .cd-band[data-layer='impl'] {
    border-color: transparent;
    background-color: var(--demo-b-soft);
  }

  .cd-band__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.5rem;
    padding: 0 0.125rem;
  }

  .cd-band__name {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .cd-band[data-layer='usecase'] .cd-band__name,
  .cd-band[data-layer='entity'] .cd-band__name {
    color: var(--color-link);
  }

  .cd-band__reason {
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
  }

  /* ── 층 안의 카드: 유스케이스·엔티티·인터페이스 하나가 카드 하나 ── */
  .cd-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .cd-cards[data-cols='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cd-cards[data-cols='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cd-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3125rem;
    min-width: 0;
    padding: 0.5rem 0.625rem 0.5625rem;
    border: 1px solid var(--color-border-secondary);
    border-radius: 0.625rem;
    background-color: var(--surface-bg);
  }

  /* 이 절에서 새로 생긴 카드. 테두리를 블루로 바꾸고 오른쪽 위에 배지를 단다 */
  .cd-card[data-new] {
    border-color: var(--demo-a);
  }

  .cd-card[data-new]::after {
    content: '추가';
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0 0.3125rem;
    border-radius: 0.25rem;
    background-color: var(--demo-a);
    font-size: 0.5625rem;
    font-weight: 700;
    line-height: 1.6;
    color: #ffffff;
  }

  .cd-card__name {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .cd-card__code {
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }

  .cd-card[data-new] .cd-card__code,
  .cd-card[data-new] .cd-card__name {
    padding-right: 2rem;
  }

  .cd-card__role {
    margin-top: -0.1875rem;
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
  }

  /* ── 칩: 카드가 가진 것(items)과 카드가 기대는 것(uses) ── */
  .cd-items,
  .cd-uses {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cd-item,
  .cd-use {
    margin: 0;
    padding: 0.0625rem 0.375rem;
    border-radius: 0.3125rem;
    font-size: 0.625rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .cd-item {
    background-color: var(--color-bg-tertiary);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  .cd-band[data-layer='impl'] .cd-item {
    border: 1px solid transparent;
    background-color: var(--surface-bg);
  }

  .cd-band[data-layer='impl'] .cd-item[data-new] {
    border-color: var(--demo-a);
    color: var(--color-link);
  }

  .cd-item__sub {
    margin-left: 0.25rem;
    color: var(--color-text-tertiary);
  }

  /* '사용' 칩은 무엇에 기대는지를 가리키므로 테두리만 둬서 채운 칩(가진 것)과 구분한다.
     엔티티를 가리키는 칩만 블루로 둬서 규칙을 어디서 읽는지가 먼저 보이게 한다. */
  .cd-use {
    max-width: 100%;
    border: 1px solid var(--color-border-primary);
    white-space: nowrap;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  .cd-use::before {
    content: '→ ';
    font-family: var(--font-sans);
    color: var(--color-text-tertiary);
  }

  .cd-use[data-kind='entity'] {
    border-color: var(--demo-a);
    background-color: var(--demo-a-soft);
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-link);
  }

  .cd-use[data-kind='entity']::before {
    color: var(--color-link);
  }

  /* ── 처음 코드: 한 카드 안에 관심사 묶음을 줄로 쌓는다 ── */
  .cd-group {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    margin-top: 0.125rem;
  }

  .cd-group__label {
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
  }

  .cd-legacy .cd-item {
    font-family: var(--font-sans);
  }

  /* 한글이 섞인 칩은 모노로 두면 자간이 벌어지므로 식별자 칩만 모노로 둔다 */
  .cd-legacy .cd-item[data-code] {
    font-family: var(--font-mono);
  }

  /* 쿠폰 규칙만 블루로 칠해 두 카드에 같은 조건이 있다는 점이 먼저 보이게 한다 */
  .cd-legacy .cd-item[data-kind='rule'] {
    background-color: var(--demo-a-soft);
    font-weight: 600;
    color: var(--color-link);
  }

  /* ── 층 사이 화살표: 세로선 + 삼각 머리. 위에서 아래를 가리키고,
     '구현'만 아래(fetch 구현)에서 위(인터페이스)를 가리킨다. ── */
  .cd-arrow {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.75rem;
    color: var(--color-text-tertiary);
  }

  .cd-arrow::before {
    content: '';
    position: absolute;
    top: 0.125rem;
    bottom: 0.4375rem;
    left: 50%;
    width: 1.5px;
    transform: translateX(-50%);
    background-color: currentColor;
  }

  .cd-arrow::after {
    content: '';
    position: absolute;
    bottom: 0.125rem;
    left: 50%;
    transform: translateX(-50%);
    border-top: 0.375rem solid currentColor;
    border-right: 0.3125rem solid transparent;
    border-left: 0.3125rem solid transparent;
  }

  .cd-arrow[data-kind='implements']::before {
    top: 0.4375rem;
    bottom: 0.125rem;
    background: repeating-linear-gradient(to bottom, currentColor 0 3px, transparent 3px 6px);
  }

  .cd-arrow[data-kind='implements']::after {
    top: 0.125rem;
    bottom: auto;
    border-top: 0;
    border-bottom: 0.375rem solid currentColor;
  }

  .cd-arrow__label {
    margin-left: 2.5rem;
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
  }

  /* 좁은 화면: 유스케이스 세 장만 세로로 쌓는다. 엔티티와 인터페이스는 좌우를
