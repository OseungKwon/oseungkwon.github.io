---
/**
 * 같은 매장의 담당자를 연달아 바꿨을 때 서버에 남는 값 — 대조 토글 + 재생.
 *
 * 글(tanstack-query-beyond-use-query)의 "B 요청이 먼저 끝나고 뒤늦은 A 요청이
 * 서버 값을 다시 A로 만들 수 있습니다. scope.id가 같은 mutation은 순서대로
 * 실행되므로"를 보여준다. 두 방식 모두 요청은 두 번이고 각 요청의 소요 시간도
 * 같다. B가 A를 기다리는지만 다르다.
 */
import Demo from './Demo.astro';

const END = 2.8;
const A = { name: '홍길동', start: 0, end: 1.6 };
const B_CLICK = 0.3;
const B_TOOK = 0.6;

type Seg = { from: number; to: number; kind: string; label?: string };
type Mode = 'parallel' | 'scope';

const bStart = { parallel: B_CLICK, scope: A.end };
const bEnd = (m: Mode) => bStart[m] + B_TOOK;

const lanes = (m: Mode): { name: string; segs: Seg[] }[] => [
  {
    name: '고른 담당자',
    segs: [
      { from: 0, to: B_CLICK, kind: 'pick', label: '홍길동' },
      { from: B_CLICK, to: END, kind: 'pick', label: '임꺽정' },
    ],
  },
  {
    name: 'A 저장',
    segs: [{ from: A.start, to: A.end, kind: 'req', label: '홍길동으로 변경' }],
  },
  {
    name: 'B 저장',
    segs: [
      ...(m === 'scope' ? [{ from: B_CLICK, to: A.end, kind: 'wait', label: 'A 끝나길 대기' }] : []),
      { from: bStart[m], to: bEnd(m), kind: 'req', label: '임꺽정' },
    ],
  },
  {
    name: '서버 값',
    segs:
      m === 'parallel'
        ? [
            { from: 0, to: bEnd(m), kind: 'value', label: '미배정' },
            { from: bEnd(m), to: A.end, kind: 'value', label: '임꺽정' },
            { from: A.end, to: END, kind: 'wrong', label: '홍길동' },
          ]
        : [
            { from: 0, to: A.end, kind: 'value', label: '미배정' },
            { from: A.end, to: bEnd(m), kind: 'value', label: '홍길동' },
            { from: bEnd(m), to: END, kind: 'right', label: '임꺽정' },
          ],
  },
];

const MODES: Mode[] = ['parallel', 'scope'];
const ticks = [0, 1, 2];
const timing = {
  end: END,
  // 서버 값이 바뀌는 시각과 값. 스크립트가 재생 중 현재 값을 계산할 때 쓴다.
  server: {
    parallel: [
      [0, '미배정'],
      [bEnd('parallel'), '임꺽정'],
      [A.end, '홍길동'],
    ],
    scope: [
      [0, '미배정'],
      [A.end, '홍길동'],
      [bEnd('scope'), '임꺽정'],
    ],
  },
  done: { parallel: A.end, scope: bEnd('scope') },
};
---

<Demo
  title="담당자를 홍길동에서 임꺽정으로 바로 바꿨을 때 서버에 남는 값"
  hint="scope 설정을 고르고 재생해 보세요. 홍길동 저장이 느리게 끝나는 상황입니다."
  caption="설명용 시간 모형 · A 요청 1.6초, B 요청 0.6초. 두 방식 모두 요청은 두 번입니다."
>
  <Fragment slot="controls">
    <div class="demo-seg" role="group" aria-label="mutation scope">
      <button class="demo-seg__opt" type="button" data-mode="parallel" aria-pressed="true">scope 없음</button>
      <button class="demo-seg__opt" type="button" data-mode="scope" aria-pressed="false">scope: store-42</button>
    </div>
    <span class="demo__spacer"></span>
    <button class="demo-btn demo-btn--primary" type="button" data-act="play">재생</button>
  </Fragment>

  <div class="mso" data-demo="mutation-scope" data-timing={JSON.stringify(timing)} style={`--end: ${END}; --t: ${END}`}>
    {
      MODES.map((m) => (
        <div class="mso-lanes" data-for={m} hidden={m !== 'parallel'}>
          {lanes(m).map((lane, i) => (
            <>
              <span class="mso-lane__name" style={`grid-row: ${i + 1}`}>
                {lane.name}
              </span>
              <div class="mso-lane" style={`grid-row: ${i + 1}`}>
                {lane.segs.map((s) => (
                  <span class="mso-seg" data-kind={s.kind} style={`--from: ${s.from}; --to: ${s.to}`}>
                    {s.label}
                  </span>
                ))}
              </div>
            </>
          ))}
          <div class="mso-axis">
            {ticks.map((s) => (
              <span style={`--at: ${s}`}>{s}초</span>
            ))}
          </div>
          <div class="mso-head-layer" aria-hidden="true">
            <span class="mso-future" />
            <span class="mso-playhead" />
          </div>
        </div>
      ))
    }

    <div class="demo-stats mso-stats">
      <div class="demo-stat">
        <span class="demo-stat__value mso-server" data-el="server">홍길동</span>
        <span class="demo-stat__label">서버에 남은 담당자</span>
      </div>
      <div class="demo-stat">
        <span class="demo-stat__value" data-el="done">1.6</span>
        <span class="demo-stat__label">두 저장이 모두 끝난 시각(초)</span>
      </div>
    </div>
  </div>
</Demo>

<style>
  .mso-lanes {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.4375rem 0.75rem;
  }

  .mso-lanes[hidden] {
    display: none;
  }

  .mso-lane__name {
    grid-column: 1;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .mso-lane {
    position: relative;
    grid-column: 2;
    height: 1.625rem;
    border-radius: 0.5rem;
    background-color: var(--color-bg-tertiary);
  }

  .mso-seg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--from) / var(--end) * 100%);
    width: calc((var(--to) - var(--from)) / var(--end) * 100%);
    display: flex;
    align-items: center;
    overflow: hidden;
    box-sizing: border-box;
    padding-left: 0.4375rem;
    border-radius: 0.5rem;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .mso-seg[data-kind='pick'] {
    border: 1px solid var(--color-border-primary);
    background-color: var(--surface-bg);
    color: var(--color-text-primary);
  }

  .mso-seg[data-kind='req'] {
    border: 1px solid var(--demo-a);
    background-color: var(--demo-a-soft);
    font-weight: 600;
    color: var(--demo-a);
  }

  .mso-seg[data-kind='wait'] {
    border: 1px dashed var(--color-border-primary);
    color: var(--color-text-tertiary);
  }

  .mso-seg[data-kind='value'] {
    color: var(--color-text-secondary);
  }

  .mso-seg[data-kind='right'] {
    border: 1px solid var(--demo-a);
    background-color: var(--demo-a-soft);
    font-weight: 700;
    color: var(--demo-a);
  }

  .mso-seg[data-kind='wrong'] {
    border: 1px solid var(--demo-warn);
    background-color: var(--demo-warn-soft);
    font-weight: 700;
    color: var(--demo-warn);
  }

  .mso-axis {
    position: relative;
    grid-row: 5;
    grid-column: 2;
    height: 0.875rem;
  }

  .mso-axis span {
    position: absolute;
    left: calc(var(--at) / var(--end) * 100%);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    transform: translateX(-50%);
  }

  .mso-axis span:first-child {
    transform: none;
  }

  .mso-head-layer {
    position: relative;
    grid-row: 1 / 5;
    grid-column: 2;
    align-self: stretch;
    pointer-events: none;
  }

  .mso-playhead,
  .mso-future {
    position: absolute;
    top: -0.25rem;
    bottom: -0.25rem;
    left: calc(var(--t) / var(--end) * 100%);
  }

  .mso-playhead {
    width: 2px;
    margin-left: -1px;
    border-radius: 1px;
    background-color: var(--color-text-primary);
    opacity: 0;
  }

  .mso-future {
    right: 0;
    background-color: var(--surface-bg);
    opacity: 0;
  }

  .mso[data-playing] .mso-playhead {
    opacity: 1;
  }

  .mso[data-playing] .mso-future {
    opacity: 0.7;
  }

  .mso-stats {
    margin-top: 1.25rem;
  }

  /* 한글 이름은 모노 서체에서 자간이 벌어지므로 본문 서체로 되돌린다 */
  .mso-server {
    font-family: var(--font-sans);
  }

  .mso-server[data-state='wrong'] {
    color: var(--demo-warn);
  }

  .mso-server[data-state='right'] {
    color: var(--demo-a);
  }

  @media (max-width: 34rem) {
    .mso-lanes {
      grid-template-columns: 3.75rem minmax(0, 1fr);
      gap: 0.375rem 0.5rem;
    }

    .mso-lane__name {
      font-size: 0.6875rem;
      white-space: normal;
    }

    .mso-seg {
      padding-left: 0.25rem;
      font-size: 0.625rem;
    }
  }
</style>

<script>
  type Mode = 'parallel' | 'scope';
  type Timing = {
    end: number;
    server: Record<Mode, [number, string][]>;
    done: Record<Mode, number>;
  };

  document.querySelectorAll<HTMLElement>('[data-demo="mutation-scope"]').forEach((root) => {
    const frame = root.closest('.demo')!;
    const el = (name: string) => root.querySelector<HTMLElement>(`[data-el="${name}"]`)!;
    const modeButtons = frame.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const play = frame.querySelector<HTMLButtonElement>('[data-act="play"]')!;
    const laneSets = root.querySelectorAll<HTMLElement>('[data-for]');
    const T = JSON.parse(root.dataset.timing!) as Timing;

    // 모형 시간 1초를 화면에서 몇 ms로 보여줄지
    const MS_PER_SECOND = 1300;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let mode: Mode = 'parallel';
    let t = T.end;
    let raf = 0;

    const serverAt = (time: number) => {
      const changes = T.server[mode];
      let value = changes[0][1];
      changes.forEach(([at, v]) => {
        if (time >= at) value = v;
      });
      return value;
    };

    /** idle·done은 전체 결과를 펼쳐 둔 상태, playing·paused는 재생 중인 상태 */
    let status: 'idle' | 'playing' | 'paused' | 'done' = 'idle';

    const render = () => {
      const finished = t >= T.end;
      const value = serverAt(t);
      root.style.setProperty('--t', String(t));
      root.toggleAttribute('data-playing', status === 'playing' || status === 'paused');
      laneSets.forEach((set) => (set.hidden = set.dataset.for !== mode));

      el('server').textContent = value;
      el('server').dataset.state = !finished ? '' : value === '임꺽정' ? 'right' : 'wrong';
      el('done').textContent = t >= T.done[mode] ? String(T.done[mode]) : '—';
      // 버튼 하나가 재생·일시정지·다시 재생을 모두 맡는다
      play.textContent = { idle: '재생', playing: '일시정지', paused: '이어서 재생', done: '다시 재생' }[status];
      modeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
    };

    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    const run = () => {
      status = 'playing';
      let last = performance.now();
      const tick = (now: number) => {
        t = Math.min(T.end, t + (now - last) / MS_PER_SECOND);
        last = now;
        if (t >= T.end) {
          raf = 0;
          status = 'done';
        } else {
          raf = requestAnimationFrame(tick);
        }
        render();
      };
      raf = requestAnimationFrame(tick);
      render();
    };

    play.addEventListener('click', () => {
      if (status === 'playing') {
        stop();
        status = 'paused';
        render();
      } else if (status === 'paused') {
        run();
      } else if (calm) {
        // 움직임을 줄인 설정에서는 재생 없이 결과를 바로 보여준다
        t = T.end;
        status = 'done';
        render();
      } else {
        t = 0;
        run();
      }
    });

    modeButtons.forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode as Mode;
        stop();
        t = T.end;
        status = 'idle';
        render();
      }),
    );
    render();
  });
</script>
