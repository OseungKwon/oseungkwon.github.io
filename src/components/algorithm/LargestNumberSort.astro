---
/**
 * 비교 함수 정렬 — 가장 큰 수(LeetCode 179).
 *
 * 대표 도형은 카드 줄 + 저울이다(그리기는 LargestNumberDiagram). 수를 문자열로 바꿔 한 줄로 세우고,
 * 삽입 정렬로 한 장씩 꺼내 앞의 수와 비교 규칙(a + b와 b + a 중 큰 쪽)을 적용한다.
 *
 *   비교 = 저울에 a(앞에 있던 수)와 b(꺼낸 수)를 올린다
 *     b가 앞이면 → a가 한 칸 뒤로 밀리고, b는 더 앞의 수와 다시 비교한다
 *     a가 앞이면 → b를 a 바로 뒤에 내려놓는다
 *   끝          → 줄을 그대로 이어 붙인 문자열이 답이다
 *
 * 풀이 코드는 Array.prototype.sort를 쓴다. sort가 어떤 순서로 비교하는지는 엔진이 정하지만, 같은
 * 비교 규칙이면 결과 순서는 같다. 여기서는 비교를 하나씩 보이려고 삽입 정렬로 돌린다.
 * 단계는 빌드 시점에 trace()가 실제로 정렬을 돌려 만든다.
 */
import Visualizer from './Visualizer.astro';
import LargestNumberDiagram from './LargestNumberDiagram.astro';

// LeetCode 179 예제 2
const nums = [3, 30, 34, 5, 9];
const strs = nums.map(String);
const n = strs.length;

/** 풀이 코드의 비교 함수와 같다. 음수면 a가 앞, 양수면 b가 앞 */
const compare = (a: string, b: string) => (a + b > b + a ? -1 : a + b < b + a ? 1 : 0);

// 카드: i 아직 안 꺼냄 / a 꺼낸 수 / s 비교 상대 / d 순서를 정함 / w 답
interface Step {
  note: string;
  cards: string;
  /** 카드마다 놓인 자리 */
  slots: number[];
  /** 줄 위로 들린 카드 (-1이면 없음) */
  lift: number;
  a: string | null;
  b: string | null;
  ret: number | null;
  result: string | null;
}

const noBatchim = (s: string) => '2459'.includes(s.at(-1)!);
const obj = (s: string) => (noBatchim(s) ? '를' : '을');
const subj = (s: string) => (noBatchim(s) ? '가' : '이');
const and = (s: string) => (noBatchim(s) ? '와' : '과');

function trace(): Step[] {
  const steps: Step[] = [];
  const order = strs.map((_, i) => i); // 자리 → 카드
  const slotOf = strs.map((_, i) => i); // 카드 → 자리

  const snap = (note: string, round: number, extra: { key?: number; against?: number; lift?: number } & Partial<Step> = {}) => {
    const { key = -1, against = -1, lift = -1, ...rest } = extra;
    steps.push({
      note,
      cards: strs
        .map((_, c) => {
          if (c === key) return 'a';
          if (c === against) return 's';
          return c <= round ? 'd' : 'i';
        })
        .join(''),
      slots: [...slotOf],
      lift,
      a: null,
      b: null,
      ret: null,
      result: null,
      ...rest,
    });
  };

  snap(
    `수를 문자열로 바꿔 한 줄로 세웠습니다. 맨 앞 ${strs[0]}${noBatchim(strs[0]) ? '는' : '은'} 그대로 두고, 둘째 수 ${strs[1]}${obj(strs[1])} 꺼내 앞의 수와 비교합니다. "다음"을 눌러 보세요`,
    0,
  );

  for (let i = 1; i < n; i++) {
    const key = order[i];
    const b = strs[key];
    const nextKey = i + 1 < n ? strs[order[i + 1]] : null;
    const then = nextKey === null ? '' : `. 이어서 ${nextKey}${obj(nextKey)} 꺼냅니다`;
    let j = i - 1;
    while (j >= 0) {
      const against = order[j];
      const a = strs[against];
      const ret = compare(a, b);
      const [big, small] = ret > 0 ? [b + a, a + b] : [a + b, b + a];
      const verdict =
        ret === 0 ? `${a + b}${subj(a + b)} 양쪽 모두 같아 순서를 바꾸지 않습니다` : `${big}${subj(big)} ${small}보다 커서 ${ret > 0 ? b : a}${subj(ret > 0 ? b : a)} 앞입니다`;
      if (ret > 0) {
        // b가 앞: a를 한 칸 뒤로 민다
        order[j + 1] = against;
        slotOf[against] = j + 1;
        if (j === 0) {
          order[0] = key;
          slotOf[key] = 0;
          snap(`${verdict}. ${a}${obj(a)} 한 칸 뒤로 밀고 ${b}${obj(b)} 맨 앞에 내려놓습니다${then}`, i, { key, against, a, b, ret });
        } else {
          slotOf[key] = j;
          const nextA = strs[order[j - 1]];
          snap(`${verdict}. ${a}${obj(a)} 한 칸 뒤로 밀고, ${nextA}${and(nextA)} 비교합니다`, i, { key, against, lift: key, a, b, ret });
        }
        j--;
      } else {
        // a가 앞: b를 a 바로 뒤에 내려놓는다
        order[j + 1] = key;
        slotOf[key] = j + 1;
        snap(`${verdict}. ${b}${obj(b)} ${a} 바로 뒤에 내려놓습니다${then}`, i, { key, against, a, b, ret });
        break;
      }
    }
  }

  const sorted = order.map((c) => strs[c]);
  const result = sorted[0] === '0' ? '0' : sorted.join('');
  snap(`모든 수의 자리가 정해졌습니다. ${sorted.join(', ')} 순서로 이어 붙인 "${result}"${obj(result)} 돌려줍니다`, n, { result });
  steps.at(-1)!.cards = 'w'.repeat(n);
  return steps;
}

const steps = trace();

// 검증: 예제 2의 출력("9534330"), 같은 비교 함수로 sort한 결과, 모든 순서를 직접 따진 최댓값이 같아야 한다.
const expected = '9534330';
const bySort = [...strs].sort(compare).join('');
const permutations = (arr: string[]): string[][] =>
  arr.length <= 1 ? [arr] : arr.flatMap((x, i) => permutations([...arr.slice(0, i), ...arr.slice(i + 1)]).map((rest) => [x, ...rest]));
const brute = permutations(strs)
  .map((p) => p.join(''))
  .reduce((best, s) => (s > best ? s : best));
if (steps.at(-1)!.result !== expected || bySort !== expected || brute !== expected) {
  throw new Error('LargestNumberSort: 결과가 LeetCode 179 예제 2 출력("9534330")이나 완전 탐색 값과 다릅니다.');
}

const first = steps[0];
const CARD: Record<string, string> = { i: 'idle', a: 'active', s: 'stack', d: 'done', w: 'answer' };
---

<Visualizer
  modes={[{ id: 'main', label: '기본' }]}
  steps={{ main: steps }}
  title={`비교 정렬 · nums = [${nums.join(', ')}]`}
  caption="LeetCode 179 예제 2. 비교를 하나씩 보이려고 삽입 정렬로 돌렸고, 빌드할 때 실제로 실행해 기록한 단계입니다."
  legend={[
    { state: 'active', label: '꺼내서 자리를 찾는 수 (b)' },
    { state: 'stack', label: '비교하는 앞 수 (a)' },
    { state: 'answer', label: '더 큰 이어 붙이기 · 완성된 순서' },
    { state: 'done', label: '순서를 정한 수' },
    { state: 'idle', label: '아직 안 꺼낸 수' },
  ]}
>
  <Fragment slot="watch">
    <dl class="lw" data-ln-watch>
      <div class="lw-row">
        <dt>a</dt>
        <dd><span class="lw-str lw-str--a" data-w="a">–</span><span class="lw-hint">앞에 있던 수</span></dd>
      </div>
      <div class="lw-row">
        <dt>b</dt>
        <dd><span class="lw-str lw-str--b" data-w="b">–</span><span class="lw-hint">꺼낸 수</span></dd>
      </div>
      <div class="lw-row">
        <dt>return</dt>
        <dd><span class="lw-num" data-w="ret">–</span><span class="lw-hint" data-w="retHint"></span></dd>
      </div>
      <div class="lw-row">
        <dt>result</dt>
        <dd><span class="lw-str" data-w="result">–</span></dd>
      </div>
    </dl>
  </Fragment>

  <Fragment slot="figure">
    <LargestNumberDiagram
      strs={strs}
      slots={first.slots}
      lift={first.lift}
      cardStates={[...first.cards].map((c) => CARD[c])}
      compare={null}
      label={`nums = [${nums.join(', ')}]를 비교 규칙으로 정렬하는 과정`}
    />
  </Fragment>
</Visualizer>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */
  .lw {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5rem;
  }

  .lw-row {
    display: flex;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .lw-row dt {
    min-width: 3.25rem;
    color: var(--t-var);
  }

  .lw-row dt::after {
    content: ':';
    color: var(--fg);
  }

  .lw-row dd {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
  }

  /* a·b는 카드와 같은 색으로 칠해 어느 카드인지 바로 잇는다 */
  .lw-str {
    color: var(--answer);
  }

  .lw-str--a {
    color: var(--stack-text);
  }

  .lw-str--b {
    color: var(--exec-text);
  }

  .lw-num {
    color: var(--t-num);
  }

  .lw-hint {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--fg-faint);
  }

  .lw [data-changed] {
    border-radius: 2px;
    background: var(--changed-bg);
    box-shadow: 0 0 0 2px var(--changed-bg);
  }
</style>

<script>
  interface Step {
    cards: string;
    slots: number[];
    lift: number;
    a: string | null;
    b: string | null;
    ret: number | null;
    result: string | null;
  }

  const CARD: Record<string, string> = { i: 'idle', a: 'active', s: 'stack', d: 'done', w: 'answer' };

  document.querySelectorAll<SVGSVGElement>('[data-ln-figure]').forEach((figure) => {
    // 같은 도형이 본문의 정적 그림(LargestNumberCompare)에도 쓰이므로, Visualizer 안에 있는 것만 움직인다.
    const root = figure.closest<HTMLElement>('[data-viz]');
    if (!root) return;
    const watch = root.querySelector<HTMLElement>('[data-ln-watch]')!;
    const w = (name: string) => watch.querySelector<HTMLElement>(`[data-w="${name}"]`)!;
    const cards = Array.from(figure.querySelectorAll<SVGGElement>('[data-card]'));
    const panel = figure.querySelector<SVGGElement>('[data-panel]')!;
    const rows = Array.from(figure.querySelectorAll<SVGGElement>('[data-row]'));
    const rowLeft = Number(figure.dataset.rowLeft);
    const pitch = Number(figure.dataset.pitch);
    const liftY = Number(figure.dataset.liftY);
    const rowY = Number(figure.dataset.rowY);
    const quote = (s: string | null) => (s === null ? '–' : `"${s}"`);

    const render = (step: Step) => {
      cards.forEach((el, i) => {
        el.setAttribute('data-state', CARD[step.cards[i]]);
        el.style.transform = `translate(${rowLeft + step.slots[i] * pitch}px, ${i === step.lift ? liftY : rowY}px)`;
      });

      // 저울: 이번 단계에 비교한 두 수. 비교가 없는 단계(시작·끝)에는 숨긴다
      if (step.a === null || step.b === null) {
        panel.setAttribute('hidden', '');
      } else {
        panel.removeAttribute('hidden');
        const winner = step.ret === 0 ? null : step.ret! < 0 ? 'ab' : 'ba';
        rows.forEach((row) => {
          row.setAttribute('data-state', winner === null ? 'tie' : row.dataset.row === winner ? 'win' : 'lose');
          row.querySelector('[data-part="a"]')!.textContent = step.a;
          row.querySelector('[data-part="b"]')!.textContent = step.b;
        });
      }

      w('a').textContent = quote(step.a);
      w('b').textContent = quote(step.b);
      w('ret').textContent = step.ret === null ? '–' : String(step.ret);
      w('retHint').textContent = step.ret === null ? '' : step.ret < 0 ? 'a가 앞' : step.ret > 0 ? 'b가 앞' : '그대로';
      w('result').textContent = quote(step.result);
      w('result').toggleAttribute('data-changed', step.result !== null);
    };

    root.addEventListener('algo:step', (event) => render((event as CustomEvent).detail.step));
    root.dispatchEvent(new CustomEvent('algo:ready'));
  });
</script>
