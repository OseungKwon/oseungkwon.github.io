---
/**
 * 세 구역 분할의 대표 도형 — 칸 줄 + 세 포인터(lo·mid·hi) + 칸 아래 네 구역 괄호.
 *
 * 칸은 네 구역으로 나뉜다. [0, lo)는 0 구역, [lo, mid)는 1 구역, [mid, hi]는 아직 안 본 칸,
 * (hi, n)은 2 구역이다. 포인터가 움직일 때마다 구역의 경계가 움직이고, 가운데의 "안 본 칸"이
 * 한 칸씩 줄어든다. 두 칸을 바꿀 때는 칸 아래에 교환 호를 그린다.
 *
 * 그리기만 맡는다. 단계 진행(SortColorsWalk)과 본문 정적 그림(SortColorsRegions,
 * SortColorsSkip)이 같은 컴포넌트를 쓴다. 단계 진행 스크립트가 포인터·괄호·호를 옮길 수 있도록
 * 칸 간격을 data-geo에 적어 둔다.
 */
interface Props {
  nums: number[];
  /** 칸 상태: idle / active / zero / one / two / done / wrong */
  cellStates?: string[];
  lo: number;
  mid: number;
  hi: number;
  /** 교환 호 [i, j]. 없으면 그리지 않는다 */
  swap?: [number, number] | null;
  /** 호 상태: hidden / candidate / swapped */
  swapState?: string;
  /** 단계 진행처럼 호가 나타났다 사라지는 그림이면 true (호 자리를 늘 비워 둔다) */
  reserveArc?: boolean;
  label: string;
}

const { nums, cellStates = [], lo, mid, hi, swap = null, swapState = 'hidden', reserveArc = false, label } = Astro.props;
const n = nums.length;

const CELL = 52;
const GAP = 6;
const PITCH = CELL + GAP;
const LEFT = 16;
const TIER = 16;
// 포인터 이름은 세 층으로 쌓는다. 같은 칸을 가리켜도 글자가 겹치지 않는다
const TIER_Y = { lo: 14, mid: 14 + TIER, hi: 14 + TIER * 2 };
const CELL_Y = TIER_Y.hi + 14;
const ARC_Y = CELL_Y + CELL + 4;
const arcDepth = (i: number, j: number) => 8 + Math.abs(j - i) * 7;
const hasArc = reserveArc || swap !== null;
const BRACKET_Y = hasArc ? ARC_Y + arcDepth(0, n - 1) + 34 : CELL_Y + CELL + 12;
const width = LEFT * 2 + n * PITCH - GAP;
const height = BRACKET_Y + 24;

const cx = (i: number) => LEFT + i * PITCH + CELL / 2;
const arcPath = ([i, j]: [number, number]) => {
  const x1 = cx(Math.min(i, j));
  const x2 = cx(Math.max(i, j));
  return `M ${x1} ${ARC_Y} Q ${(x1 + x2) / 2} ${ARC_Y + arcDepth(i, j) * 2} ${x2} ${ARC_Y}`;
};

// 구역 [from, to) 괄호. 빈 구역은 숨긴다
const regions = [
  { key: 'zero', text: '0 구역', from: 0, to: lo },
  { key: 'one', text: '1 구역', from: lo, to: mid },
  { key: 'unknown', text: '안 본 칸', from: mid, to: hi + 1 },
  { key: 'two', text: '2 구역', from: hi + 1, to: n },
];
const bracketPath = (from: number, to: number) => {
  const x1 = LEFT + from * PITCH + 3;
  const x2 = LEFT + to * PITCH - GAP - 3;
  return `M ${x1} ${BRACKET_Y - 5} V ${BRACKET_Y} H ${x2} V ${BRACKET_Y - 5}`;
};
const bracketMid = (from: number, to: number) => (LEFT + from * PITCH + LEFT + to * PITCH - GAP) / 2;
const pointers = [
  { key: 'lo', at: lo },
  { key: 'mid', at: mid },
  { key: 'hi', at: hi },
] as const;
const geo = JSON.stringify({ left: LEFT, pitch: PITCH, cell: CELL, arcY: ARC_Y, bracketY: BRACKET_Y, n });
---

{/* 칸 수가 적으면 그림이 부풀지 않도록 원래 크기 이상으로 늘리지 않는다 */}
<svg class="sc" viewBox={`0 0 ${width} ${height}`} style={`max-width: ${width}px`} role="img" aria-label={label} data-sc-figure data-geo={geo}>
  {/* 포인터: 이름 + 아래를 가리키는 작은 삼각형. x는 transform으로 옮긴다 */}
  {
    pointers.map(({ key, at }) => (
      <g class="sc-ptr" data-ptr={key} style={`transform: translateX(${cx(at)}px)`}>
        <text x="0" y={TIER_Y[key]} text-anchor="middle">{key}</text>
        <path d={`M -4 ${TIER_Y[key] + 3} L 4 ${TIER_Y[key] + 3} L 0 ${TIER_Y[key] + 7} Z`} />
      </g>
    ))
  }

  {/* 칸 */}
  {
    nums.map((value, i) => (
      <g class="sc-cell" data-cell={i} data-state={cellStates[i] ?? 'idle'}>
        <rect x={LEFT + i * PITCH} y={CELL_Y} width={CELL} height={CELL} rx="8" />
        <text class="sc-value" x={cx(i)} y={CELL_Y + CELL / 2} dy="0.36em" text-anchor="middle">{value}</text>
      </g>
    ))
  }

  {/* 교환 호 */}
  {
    hasArc && (
      <g class="sc-arc" data-sc-arc data-state={swap ? swapState : 'hidden'}>
        <path d={swap ? arcPath(swap) : ''} />
        <text x={swap ? (cx(swap[0]) + cx(swap[1])) / 2 : 0} y={swap ? ARC_Y + arcDepth(...swap) + 14 : 0} text-anchor="middle">교환</text>
      </g>
    )
  }

  {/* 네 구역 괄호 */}
  {
    regions.map(({ key, text, from, to }) => (
      <g class="sc-region" data-region={key} hidden={to <= from ? true : undefined}>
        <path d={bracketPath(from, Math.max(from, to))} />
        <text x={bracketMid(from, Math.max(from, to))} y={BRACKET_Y + 15} text-anchor="middle">{text}</text>
      </g>
    ))
  }
</svg>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */
  .sc {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  /* ── 포인터 ─────────────────────────── */
  .sc-ptr {
    transition: transform 0.3s ease;
  }

  .sc-ptr text {
    font-size: 12px;
    fill: var(--fg-dim);
  }

  .sc-ptr path {
    fill: var(--fg-faint);
  }

  .sc-ptr[data-ptr='mid'] text {
    fill: var(--exec-text);
    font-weight: 700;
  }

  .sc-ptr[data-ptr='mid'] path {
    fill: var(--exec);
  }

  /* ── 칸 ─────────────────────────────── */
  .sc-cell rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .sc-value {
    font-size: 16px;
    fill: var(--fg);
  }

  /* 아직 안 본 칸 */
  .sc-cell[data-state='idle'] rect {
    stroke-dasharray: 3 4;
  }

  .sc-cell[data-state='idle'] .sc-value {
    fill: var(--fg-dim);
  }

  /* 지금 읽는 칸 (mid) */
  .sc-cell[data-state='active'] rect {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .sc-cell[data-state='active'] .sc-value {
    fill: var(--exec-text);
    font-weight: 700;
  }

  /* 자리가 정해진 0과 2 */
  .sc-cell[data-state='zero'] rect,
  .sc-cell[data-state='two'] rect,
  .sc-cell[data-state='done'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .sc-cell[data-state='zero'] .sc-value,
  .sc-cell[data-state='two'] .sc-value,
  .sc-cell[data-state='done'] .sc-value {
    fill: var(--answer);
    font-weight: 700;
  }

  /* 가운데에 모인 1 */
  .sc-cell[data-state='one'] rect {
    fill: var(--stack-soft);
    stroke: var(--stack);
    stroke-width: 2;
  }

  .sc-cell[data-state='one'] .sc-value {
    fill: var(--stack-text);
    font-weight: 700;
  }

  /* 구역에 맞지 않는 값 */
  .sc-cell[data-state='wrong'] rect {
    fill: var(--removed-bg);
    stroke: var(--removed);
    stroke-width: 2;
    stroke-dasharray: 5 3;
  }

  .sc-cell[data-state='wrong'] .sc-value {
    fill: var(--removed);
    font-weight: 700;
  }

  /* ── 교환 호 ─────────────────────────── */
  .sc-arc path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .sc-arc text {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
  }

  .sc-arc[data-state='hidden'] {
    opacity: 0;
  }

  .sc-arc[data-state='candidate'] path {
    stroke: var(--stack);
    stroke-dasharray: 5 4;
  }

  .sc-arc[data-state='candidate'] text {
    fill: var(--stack-text);
  }

  .sc-arc[data-state='swapped'] path {
    stroke: var(--done-line);
  }

  .sc-arc[data-state='swapped'] text {
    fill: var(--done-text);
  }

  /* ── 구역 괄호 ───────────────────────── */
  .sc-region[hidden] {
    display: none;
  }

  .sc-region path {
    fill: none;
    stroke: var(--fg-faint);
    stroke-width: 1.25;
  }

  .sc-region text {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: var(--fg-dim);
  }

  .sc-region[data-region='unknown'] text {
    fill: var(--fg-faint);
  }
</style>
