---
/**
 * 1차원 DP의 대표 도형 — 집(nums) 줄 + dp 표 + dp[i]가 참조한 이전 칸으로의 화살표.
 *
 * 집도둑(House Robber) 기준: dp[i]는 "집 i까지 봤을 때 털 수 있는 최대 금액"이다. dp[i]는 두 칸만
 * 참조한다. 건너뛰기는 dp[i-1] 그대로, 털기는 dp[i-2] + nums[i]. dp 표 앞의 0 두 칸은 첫 집보다
 * 앞선 가상의 칸으로, 풀이 코드의 초깃값(prev2 = 0, prev1 = 0)과 같다. 그래서 첫 집과 둘째 집도
 * 같은 규칙으로 채워진다.
 *
 * 그리기만 맡는다. 단계 진행(HouseRobberTable)과 본문 정적 그림(HouseRobberChoice)이 같은 컴포넌트를 쓴다.
 * 상태는 data-state로 두므로 HouseRobberTable의 스크립트가 단계마다 바꿀 수 있다.
 */
interface Props {
  nums: number[];
  /** 집 상태: idle / active / answer */
  houseStates?: string[];
  /** dp 칸 상태 (앞의 0 두 칸 포함, 길이 n + 2): ghost / idle / pending / active / source / done / answer */
  cellStates?: string[];
  /** dp 칸에 적을 값 (앞의 0 두 칸 포함). idle 칸은 CSS로 숨긴다 */
  values: (number | string)[];
  /** 화살표 상태: 집마다 [건너뛰기, 털기] 순서로 2n개. hidden / candidate / win / lose / path */
  arcStates?: string[];
  /** 화살표 아래 글 (arcStates와 같은 순서) */
  arcLabels?: string[];
  label: string;
}

const { nums, houseStates = [], cellStates = [], values, arcStates = [], arcLabels = [], label } = Astro.props;
const n = nums.length;

const CELL = 50;
const GAP = 8;
const LEFT = 40;
const HOUSE_Y = 22;
const DP_Y = HOUSE_Y + CELL + 26;
const ARC_Y = DP_Y + CELL + 4;
const SKIP_DEPTH = 22;
const ROB_DEPTH = 46;
const colX = (col: number) => LEFT + col * (CELL + GAP);
const center = (col: number) => colX(col) + CELL / 2;
// dp 칸 i(0..n-1)는 앞의 0 두 칸 뒤, 열 i + 2에 있다
const dpCol = (i: number) => i + 2;
const width = LEFT + (n + 2) * (CELL + GAP) + 6;
const height = ARC_Y + ROB_DEPTH + 28;

const arcs = nums.flatMap((_, i) => [
  { kind: 'skip', from: dpCol(i - 1), to: dpCol(i), depth: SKIP_DEPTH },
  { kind: 'rob', from: dpCol(i - 2), to: dpCol(i), depth: ROB_DEPTH },
]);
const arcPath = ({ from, to, depth }: { from: number; to: number; depth: number }) => {
  const x1 = center(from) + 6;
  const x2 = center(to) - 6;
  return `M ${x1} ${ARC_Y} Q ${(x1 + x2) / 2} ${ARC_Y + depth * 2} ${x2} ${ARC_Y}`;
};
---

{/* 칸 수가 적으면 그림이 부풀지 않도록 원래 크기 이상으로 늘리지 않는다 */}
<svg class="dt" viewBox={`0 0 ${width} ${height}`} style={`max-width: ${width}px`} role="img" aria-label={label} data-dt-figure>
  <text class="dt-row" x={LEFT - 10} y={HOUSE_Y + CELL / 2} dy="0.36em" text-anchor="end">집</text>
  <text class="dt-row" x={LEFT - 10} y={DP_Y + CELL / 2} dy="0.36em" text-anchor="end">dp</text>

  {/* 집 줄 */}
  {
    nums.map((value, i) => (
      <g class="dt-house" data-house={i} data-state={houseStates[i] ?? 'idle'}>
        <rect x={colX(dpCol(i))} y={HOUSE_Y} width={CELL} height={CELL} rx="8" />
        <text class="dt-value" x={center(dpCol(i))} y={HOUSE_Y + CELL / 2} dy="0.36em" text-anchor="middle">{value}</text>
        <text class="dt-index" x={center(dpCol(i))} y={HOUSE_Y - 8} text-anchor="middle">{i}</text>
        <line class="dt-link" x1={center(dpCol(i))} y1={HOUSE_Y + CELL + 3} x2={center(dpCol(i))} y2={DP_Y - 3} />
      </g>
    ))
  }

  {/* dp 칸: 앞의 0 두 칸 + 집마다 한 칸 */}
  {
    values.map((value, col) => (
      <g class="dt-cell" data-cell={col} data-state={cellStates[col] ?? (col < 2 ? 'ghost' : 'idle')}>
        <rect x={colX(col)} y={DP_Y} width={CELL} height={CELL} rx="8" />
        <text class="dt-value" x={center(col)} y={DP_Y + CELL / 2} dy="0.36em" text-anchor="middle">{value}</text>
      </g>
    ))
  }

  {/* 참조 화살표: 건너뛰기(바로 앞 칸)와 털기(두 칸 앞).
      깊게 도는 털기 화살표를 먼저 그려야 건너뛰기 글 위를 지나가지 않는다.
      그래서 DOM 순서와 번호가 다르므로, 스크립트는 data-arc 값으로 상태를 찾는다. */}
  {
    arcs
      .map((arc, idx) => ({ arc, idx }))
      .sort((a, b) => (a.arc.kind === b.arc.kind ? a.idx - b.idx : a.arc.kind === 'rob' ? -1 : 1))
      .map(({ arc, idx }) => (
      <g class="dt-arc" data-arc={idx} data-kind={arc.kind} data-state={arcStates[idx] ?? 'hidden'}>
        <path d={arcPath(arc)} />
        <circle r="3.5" cx={center(arc.to) - 6} cy={ARC_Y} />
        <text x={(center(arc.from) + center(arc.to)) / 2} y={ARC_Y + arc.depth + 14} text-anchor="middle">{arcLabels[idx] ?? ''}</text>
      </g>
    ))
  }
</svg>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */
  .dt {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  .dt-row {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: var(--fg-dim);
  }

  .dt-index {
    font-size: 10px;
    fill: var(--node-idle-text);
  }

  .dt-value {
    font-size: 15px;
    fill: var(--fg);
    transition: fill 0.25s, opacity 0.2s;
  }

  /* ── 집 ─────────────────────────────── */
  .dt-house rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .dt-link {
    stroke: var(--node-line);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .dt-house[data-state='active'] rect {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .dt-house[data-state='active'] .dt-value {
    fill: var(--exec-text);
    font-weight: 700;
  }

  .dt-house[data-state='answer'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .dt-house[data-state='answer'] .dt-value {
    fill: var(--answer);
    font-weight: 700;
  }

  /* ── dp 칸 ───────────────────────────── */
  .dt-cell rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  /* 첫 집 앞의 가상 칸 (초깃값 0) */
  .dt-cell[data-state='ghost'] rect {
    fill: var(--done-fill);
    stroke-dasharray: 3 3;
  }

  .dt-cell[data-state='ghost'] .dt-value {
    fill: var(--done-text);
  }

  /* 아직 채우지 않은 칸 */
  .dt-cell[data-state='idle'] rect {
    stroke-dasharray: 2 4;
  }

  .dt-cell[data-state='idle'] .dt-value {
    opacity: 0;
  }

  /* 두 후보를 비교하는 중: 아직 값을 적지 않았다 */
  .dt-cell[data-state='pending'] rect,
  .dt-cell[data-state='active'] rect {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .dt-cell[data-state='pending'] .dt-value {
    opacity: 0;
  }

  .dt-cell[data-state='active'] .dt-value {
    fill: var(--exec-text);
    font-weight: 700;
  }

  .dt-cell[data-state='done'] rect {
    fill: var(--done-fill);
    stroke: var(--done-line);
  }

  .dt-cell[data-state='done'] .dt-value {
    fill: var(--done-text);
  }

  /* 두 후보가 읽는 칸 */
  .dt-cell[data-state='source'] rect {
    fill: var(--stack-soft);
    stroke: var(--stack);
    stroke-width: 2;
  }

  .dt-cell[data-state='source'] .dt-value {
    fill: var(--stack-text);
    font-weight: 700;
  }

  .dt-cell[data-state='answer'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .dt-cell[data-state='answer'] .dt-value {
    fill: var(--answer);
    font-weight: 700;
  }

  /* ── 참조 화살표 ─────────────────────── */
  .dt-arc path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    transition: opacity 0.25s, stroke 0.25s;
  }

  /* 다른 화살표가 글 위를 지나가도 읽히도록 바탕색 테두리를 두른다 */
  .dt-arc text {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .dt-arc[data-state='hidden'] {
    opacity: 0;
  }

  .dt-arc[data-state='candidate'] path {
    stroke: var(--stack);
    stroke-dasharray: 5 4;
  }

  .dt-arc[data-state='candidate'] circle,
  .dt-arc[data-state='candidate'] text {
    fill: var(--stack-text);
  }

  .dt-arc[data-state='win'] path,
  .dt-arc[data-state='path'] path {
    stroke: var(--answer);
    stroke-width: 2.5;
  }

  .dt-arc[data-state='win'] circle,
  .dt-arc[data-state='win'] text,
  .dt-arc[data-state='path'] circle {
    fill: var(--answer);
  }

  .dt-arc[data-state='lose'] {
    opacity: 0.35;
  }

  .dt-arc[data-state='lose'] path {
    stroke: var(--done-line);
    stroke-dasharray: 5 4;
  }

  .dt-arc[data-state='lose'] circle,
  .dt-arc[data-state='lose'] text {
    fill: var(--done-text);
  }

  /* 지난 화살표는 글을 숨긴다 (지금 칸의 두 후보만 읽히게) */
  .dt-arc[data-state='path'] text {
    opacity: 0;
  }
</style>
