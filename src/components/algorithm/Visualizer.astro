---
import './algo-theme.css';

/**
 * Visualizer — 알고리즘 항목의 공통 시각화 틀.
 *
 *   [되돌린다 | 되돌리지 않는다]        [처음부터] [이전] [▶ 자동 재생] [다음]   ← 조작부 (애플식 컨트롤)
 *   단계 ━━━━━●━━━━━━━━  5 / 22
 *   ┌ ● ● ●        상태 공간 트리 ─────────────────┐
 *   │  대표 도형 (figure 슬롯)       │ 변수 (watch)  │   ← 창 (화면, 누를 수 없음)
 *   ├ › 이번 단계에 일어난 일 한 줄 ─────────────────┤
 *   └──────────────────────────────────────────────┘
 *
 * 코드는 싣지 않는다. 코드 줄 하나하나에 도형을 맞추면 단계가 수십 개로 늘어
 * 오히려 읽기 어렵다. 한 단계는 도형이 바뀌는 사건 하나(노드로 내려감, 답 완성,
 * 되돌아옴)이고, 코드는 본문의 풀이 절에서 따로 읽는다.
 *
 * 누를 수 있는 것은 전부 창 밖 조작부에 있고, iOS·macOS 컨트롤 문법(회색 트랙
 * 세그먼트, 회색 바탕 버튼, 채운 주 동작, 흰 손잡이 슬라이더)을 따른다.
 * 창 안에는 누를 수 있는 요소를 두지 않는다.
 * 창은 페이지 테마를 따른다(라이트 페이지 → 밝은 창, 다크 페이지 → 어두운 창).
 *
 * 도형과 변수는 알고리즘별 컴포넌트가 figure·watch 슬롯으로 넘기고,
 * 'algo:step' 이벤트를 받아 스스로 그린다.
 *
 * steps: { [modeId]: { note: string; ...도형 데이터 }[] }
 */
interface Mode {
  id: string;
  /** 조작부 토글에 보일 이름 */
  label: string;
}

/** 창 아래 범례. 색이 무엇을 뜻하는지 본문을 읽지 않아도 알 수 있게 한다 */
interface LegendItem {
  state: 'active' | 'stack' | 'answer' | 'done' | 'idle';
  label: string;
}

interface Props {
  modes: Mode[];
  legend?: LegendItem[];
  steps: Record<string, { note: string }[]>;
  /** 창 제목 = 대표 도형 이름 */
  title: string;
  caption?: string;
}

const { modes, steps, title, caption, legend = [] } = Astro.props;
const first = steps[modes[0].id][0];
const total = steps[modes[0].id].length;
---

<figure class="viz algo-theme not-prose" data-viz data-steps={JSON.stringify(steps)} data-modes={JSON.stringify(modes)} aria-label={title}>
  <!-- 조작부: 누를 수 있는 것은 모두 여기 있다 -->
  <div class="viz-controls">
    <div class="viz-controls__row">
      {
        modes.length > 1 && (
          <div class="viz-seg" role="group" aria-label="비교할 방식">
            {modes.map((mode, index) => (
              <button type="button" class="viz-seg__opt" data-mode={mode.id} aria-pressed={index === 0 ? 'true' : 'false'}>
                {mode.label}
              </button>
            ))}
          </div>
        )
      }
      <div class="viz-transport">
        <button type="button" class="viz-btn" data-act="restart" disabled>
          <svg class="viz-btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5v9" /><path d="M12.5 3.8 6.2 8l6.3 4.2z" class="viz-fill" /></svg>
          처음부터
        </button>
        <button type="button" class="viz-btn" data-act="prev" disabled>
          <svg class="viz-btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
          이전
        </button>
        <button type="button" class="viz-btn" data-act="play">
          <svg class="viz-btn-icon viz-icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.5 8z" class="viz-fill" /></svg>
          <svg class="viz-btn-icon viz-icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
          <span data-el="playLabel">자동 재생</span>
        </button>
        <button type="button" class="viz-btn viz-btn--filled" data-act="next">
          다음
          <svg class="viz-btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3.5 4.5 4.5L6 12.5" /></svg>
        </button>
      </div>
    </div>
    <label class="viz-controls__row viz-step">
      <span class="viz-step__label">단계</span>
      <input class="viz-scrub" type="range" min="0" max={total - 1} value="0" step="1" data-el="scrub" style="--fill: 0%" />
      <span class="viz-step__count" data-el="count">1 / {total}</span>
    </label>
  </div>

  <!-- 창: 화면일 뿐, 안에는 누를 수 있는 요소가 없다 -->
  <div class="viz-window">
    <div class="viz-title" aria-hidden="true">
      <span class="viz-lights"><i></i><i></i><i></i></span>
      <span class="viz-title__text">{title}</span>
    </div>

    <div class="viz-main">
      <div class="viz-figure">
        <slot name="figure" />
      </div>
      <section class="viz-watch" aria-label="변수">
        <div class="viz-watch__head">변수</div>
        <slot name="watch" />
      </section>
    </div>

    <p class="viz-note" data-el="note" aria-live="polite">{first.note}</p>

    {
      legend.length > 0 && (
        <ul class="viz-legend" aria-label="색이 뜻하는 것">
          {legend.map((item) => (
            <li>
              <span class="viz-swatch" data-state={item.state} aria-hidden="true" />
              {item.label}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {caption && <figcaption class="viz-caption">{caption}</figcaption>}
</figure>

<style>
  /* 창 색(라이트·다크)은 algo-theme.css의 .algo-theme가 정의한다. */
  .viz {
    margin: 2.75rem 0;
    color: var(--fg);
  }

  /* ── 조작부 (창 밖) — iOS·macOS 컨트롤 문법 ──
     회색 트랙의 세그먼트, 회색 바탕에 파란 글자의 버튼, 주 동작 하나만 채운 파랑,
     흰 손잡이 슬라이더. 창 안의 '화면'과 달리 전부 눌리는 모양이다. */
  .viz-controls {
    --ctl-fill: rgba(118, 118, 128, 0.12);
    --ctl-fill-hover: rgba(118, 118, 128, 0.18);
    --ctl-fill-press: rgba(118, 118, 128, 0.26);
    --ctl-text: var(--color-accent);
    --ctl-disabled: rgba(60, 60, 67, 0.3);
    --seg-selected: #ffffff;
    --seg-selected-text: #1d1d1f;
    --seg-shadow: 0 3px 8px rgba(0, 0, 0, 0.12), 0 3px 1px rgba(0, 0, 0, 0.04);
    --track: rgba(118, 118, 128, 0.2);
    --focus: color-mix(in srgb, var(--color-accent) 45%, transparent);

    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-family: var(--font-sans);
  }

  :global(.dark) .viz-controls {
    --ctl-fill: rgba(118, 118, 128, 0.24);
    --ctl-fill-hover: rgba(118, 118, 128, 0.32);
    --ctl-fill-press: rgba(118, 118, 128, 0.4);
    --ctl-disabled: rgba(235, 235, 245, 0.3);
    --seg-selected: #636366;
    --seg-selected-text: #ffffff;
    --seg-shadow: 0 3px 8px rgba(0, 0, 0, 0.3), 0 3px 1px rgba(0, 0, 0, 0.12);
    --track: rgba(118, 118, 128, 0.32);
  }

  .viz-controls__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem 0.75rem;
  }

  /* 세그먼트: 회색 트랙 안에서 선택된 칸만 떠오른다 */
  .viz-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: 9px;
    background: var(--ctl-fill);
  }

  .viz-seg__opt {
    min-height: 1.875rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .viz-seg__opt:hover:not([aria-pressed='true']) {
    color: var(--color-text-primary);
  }

  .viz-seg__opt[aria-pressed='true'] {
    color: var(--seg-selected-text);
    background: var(--seg-selected);
    box-shadow: var(--seg-shadow);
  }

  .viz-transport {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  /* 버튼: 회색 바탕 + 파란 글자. 주 동작만 파랑으로 채운다 */
  .viz-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.125rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 10px;
    background: var(--ctl-fill);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ctl-text);
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 0.15s ease,
      transform 0.1s ease,
      filter 0.15s ease;
  }

  .viz-btn:hover:not(:disabled) {
    background: var(--ctl-fill-hover);
  }

  .viz-btn:active:not(:disabled) {
    background: var(--ctl-fill-press);
    transform: scale(0.97);
  }

  .viz-btn:disabled {
    color: var(--ctl-disabled);
    cursor: default;
  }

  .viz-btn--filled {
    color: #ffffff;
    background: var(--color-accent);
  }

  .viz-btn--filled:hover:not(:disabled) {
    background: var(--color-accent);
    filter: brightness(1.08);
  }

  .viz-btn--filled:active:not(:disabled) {
    background: var(--color-accent);
    filter: brightness(0.92);
  }

  .viz-btn--filled:disabled {
    color: var(--ctl-disabled);
    background: var(--ctl-fill);
  }

  .viz-btn-icon {
    width: 0.8125rem;
    height: 0.8125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .viz-btn-icon .viz-fill {
    fill: currentColor;
    stroke-width: 1;
  }

  .viz-icon-pause,
  .viz[data-playing] .viz-icon-play {
    display: none;
  }

  .viz[data-playing] .viz-icon-pause {
    display: block;
  }

  .viz-seg__opt:focus-visible,
  .viz-btn:focus-visible,
  .viz-scrub:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
  }

  /* 슬라이더: 얇은 트랙, 지나온 구간만 파랑, 흰 원형 손잡이 */
  .viz-step {
    justify-content: flex-start;
    flex-wrap: nowrap;
  }

  .viz-step__label,
  .viz-step__count {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .viz-step__label {
    font-weight: 600;
  }

  .viz-step__count {
    min-width: 3.25rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .viz-scrub {
    --thumb: 1.375rem;
    flex: 1;
    min-width: 0;
    height: var(--thumb);
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .viz-scrub::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--color-accent) var(--fill), var(--track) var(--fill));
  }

  .viz-scrub::-webkit-slider-thumb {
    width: var(--thumb);
    height: var(--thumb);
    margin-top: calc((4px - var(--thumb)) / 2);
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    box-shadow:
      0 0.5px 4px rgba(0, 0, 0, 0.12),
      0 6px 13px rgba(0, 0, 0, 0.12);
    -webkit-appearance: none;
    appearance: none;
  }

  .viz-scrub::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: var(--track);
  }

  .viz-scrub::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .viz-scrub::-moz-range-thumb {
    width: var(--thumb);
    height: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    box-shadow:
      0 0.5px 4px rgba(0, 0, 0, 0.12),
      0 6px 13px rgba(0, 0, 0, 0.12);
  }

  /* ── 창 (화면) ────────────────────────── */
  .viz-window {
    overflow: hidden;
    border: 1px solid var(--window-border);
    border-radius: 10px;
    background: var(--bg);
    box-shadow: var(--window-shadow);
  }

  .viz-title {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    background: var(--bg-side);
    border-bottom: 1px solid var(--line);
  }

  .viz-lights {
    position: absolute;
    left: 0.875rem;
    display: flex;
    gap: 0.4375rem;
  }

  .viz-lights i {
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .viz-lights i:nth-child(2) {
    background: #febc2e;
  }

  .viz-lights i:nth-child(3) {
    background: #28c840;
  }

  .viz-title__text {
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .viz-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
  }

  .viz-figure {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 1.5rem 1.25rem;
    background-image: radial-gradient(var(--figure-dot) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .viz-watch {
    min-width: 0;
    padding: 0.75rem 1rem 1rem;
    border-left: 1px solid var(--line);
    background: var(--bg-side);
  }

  .viz-watch__head {
    margin-bottom: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--fg-dim);
  }

  /* 이번 단계에 일어난 일 */
  .viz-note {
    min-height: 2.75rem;
    margin: 0;
    padding: 0.6875rem 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--fg);
    background: var(--bg-side);
  }

  .viz-note::before {
    content: '› ';
    color: var(--exec);
  }

  /* 범례: 도형의 상태 색과 같은 모양의 작은 원 */
  .viz-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.125rem;
    margin: 0;
    padding: 0.625rem 1rem 0.75rem;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 0.75rem;
    color: var(--fg-dim);
    background: var(--bg-side);
  }

  .viz-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
  }

  .viz-swatch {
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid var(--node-line);
    border-radius: 50%;
    background: var(--node-bg);
  }

  .viz-swatch[data-state='idle'] {
    border-style: dashed;
  }

  .viz-swatch[data-state='active'] {
    border: 2px solid var(--exec);
    background: var(--exec-bg);
  }

  .viz-swatch[data-state='stack'] {
    border: 2px solid var(--stack);
    background: var(--stack-soft);
  }

  .viz-swatch[data-state='answer'] {
    border-color: var(--answer);
    background: var(--answer-soft);
  }

  .viz-swatch[data-state='done'] {
    border-color: var(--done-line);
    background: var(--done-fill);
  }

  .viz-caption {
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
  }

  /* ── 좁은 화면 ────────────────────────── */
  @media (max-width: 44rem) {
    .viz-main {
      grid-template-columns: 1fr;
    }
    .viz-watch {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    /* 손가락으로 누르기 쉽게 한 줄을 네 칸으로 나눈다 */
    .viz-transport {
      width: 100%;
      margin-left: 0;
    }
    .viz-btn {
      flex: 1;
      min-height: 2.5rem;
      padding: 0 0.5rem;
    }
    .viz-seg {
      width: 100%;
    }
    .viz-seg__opt {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viz-btn:active:not(:disabled) {
      transform: none;
    }
    .viz :global(*) {
      transition: none !important;
    }
  }
</style>

<script>
  interface Step {
    note: string;
  }
  interface Mode {
    id: string;
    label: string;
  }

  const PLAY_INTERVAL = 900;

  document.querySelectorAll<HTMLElement>('[data-viz]').forEach((root) => {
    const all = JSON.parse(root.dataset.steps!) as Record<string, Step[]>;
    const modes = JSON.parse(root.dataset.modes!) as Mode[];
    const el = <T extends HTMLElement = HTMLElement>(name: string) => root.querySelector<T>(`[data-el="${name}"]`)!;
    const segs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode]'));
    const act = (name: string) => root.querySelector<HTMLButtonElement>(`[data-act="${name}"]`)!;
    const [restart, prev, play, next] = ['restart', 'prev', 'play', 'next'].map(act);
    const scrub = el<HTMLInputElement>('scrub');

    let mode = modes[0];
    let index = 0;
    let timer: number | undefined;

    const steps = () => all[mode.id];

    const render = () => {
      const list = steps();
      const step = list[index];
      const last = list.length - 1;

      el('note').textContent = step.note;
      el('count').textContent = `${index + 1} / ${list.length}`;
      scrub.max = String(last);
      scrub.value = String(index);
      // 슬라이더의 지나온 구간을 칠한다 (WebKit에는 progress 의사 요소가 없다)
      scrub.style.setProperty('--fill', `${last === 0 ? 100 : (index / last) * 100}%`);
      scrub.setAttribute('aria-valuetext', `${list.length}단계 중 ${index + 1}단계`);
      prev.disabled = index === 0;
      restart.disabled = index === 0;
      next.disabled = index === last;
      el('playLabel').textContent = timer ? '일시정지' : index === last ? '다시 재생' : '자동 재생';

      root.dispatchEvent(new CustomEvent('algo:step', { detail: { mode: mode.id, index, step } }));
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
      root.removeAttribute('data-playing');
    };

    const go = (target: number) => {
      index = Math.max(0, Math.min(steps().length - 1, target));
      render();
    };

    play.addEventListener('click', () => {
      if (timer) {
        stop();
        render();
        return;
      }
      if (index === steps().length - 1) index = 0;
      root.setAttribute('data-playing', '');
      timer = window.setInterval(() => {
        if (index >= steps().length - 1) {
          stop();
          render();
          return;
        }
        go(index + 1);
      }, PLAY_INTERVAL);
      render();
    });

    restart.addEventListener('click', () => {
      stop();
      go(0);
    });
    prev.addEventListener('click', () => {
      stop();
      go(index - 1);
    });
    next.addEventListener('click', () => {
      stop();
      go(index + 1);
    });
    scrub.addEventListener('input', () => {
      stop();
      go(Number(scrub.value));
    });

    segs.forEach((seg) =>
      seg.addEventListener('click', () => {
        stop();
        mode = modes.find((m) => m.id === seg.dataset.mode)!;
        segs.forEach((other) => other.setAttribute('aria-pressed', String(other === seg)));
        go(0);
      }),
    );

    // 조작부에 포커스가 있으면 방향키로 한 단계씩 넘긴다. 슬라이더는 자체 방향키를 쓴다.
    root.addEventListener('keydown', (event) => {
      if ((event.target as HTMLElement).matches('input')) return;
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        stop();
        go(index + (event.key === 'ArrowRight' ? 1 : -1));
        event.preventDefault();
      }
    });

    // 도형 컴포넌트의 스크립트가 나중에 실행되면 현재 단계를 다시 받아 간다.
    root.addEventListener('algo:ready', render);
    render();
  });
</script>
