---
/**
 * 다익스트라의 대표 도형 — 가중치 그래프 + 마을마다 거리 라벨.
 *
 * 마을(노드) 옆의 라벨이 출발지에서 그 마을까지 지금 알고 있는 가장 짧은 거리다. 처음에는 출발지만 0이고
 * 나머지는 ∞다. 거리가 가장 작은 마을을 확정하고, 그 마을에서 나가는 도로(간선)로 이웃의 라벨을 줄인다.
 *
 *   마을 상태: idle(∞) / queued(거리 후보) / active(지금 확정해 이웃을 보는 마을) / done(확정) / answer / over
 *   도로 상태: idle / tree(지금까지의 최단 경로) / try-ok(이번에 줄인 도로) / try-fail(줄이지 못한 도로)
 *
 * 그리기만 맡는다. 단계 진행(DijkstraWalk)과 본문 정적 그림(DijkstraScene)이 같은 컴포넌트를 쓴다.
 */
import { N, ROAD, POS } from './dijkstra-trace';

interface Props {
  nodeStates?: string[];
  edgeStates?: string[];
  dist?: (number | null)[];
  /** 줄이지 못한 후보 거리. 라벨 옆에 빨간 취소선으로 보인다 */
  cand?: (number | null)[];
  label: string;
}

const { nodeStates = [], edgeStates = [], dist = [], cand = [], label } = Astro.props;

const R = 18;
const width = 364;
const height = 246;
const villages = Array.from({ length: N }, (_, k) => k + 1);
const center = { x: width / 2, y: height / 2 };

const edgeLine = ([a, b]: [number, number, number]) => {
  const p = POS[a];
  const q = POS[b];
  const dx = q.x - p.x;
  const dy = q.y - p.y;
  const k = R / Math.hypot(dx, dy);
  return { x1: p.x + dx * k, y1: p.y + dy * k, x2: q.x - dx * k, y2: q.y - dy * k };
};
// 가중치는 도로 가운데에서 그래프 바깥쪽으로 조금 비켜 적는다
const weightAt = ([a, b]: [number, number, number]) => {
  const p = POS[a];
  const q = POS[b];
  const mx = (p.x + q.x) / 2;
  const my = (p.y + q.y) / 2;
  const len = Math.hypot(q.x - p.x, q.y - p.y);
  let nx = -(q.y - p.y) / len;
  let ny = (q.x - p.x) / len;
  if ((mx - center.x) * nx + (my - center.y) * ny < 0) {
    nx = -nx;
    ny = -ny;
  }
  return { x: mx + nx * 12, y: my + ny * 12 };
};
const labelY = (v: number) => (POS[v].label === 'above' ? POS[v].y - R - 13 : POS[v].y + R + 13);
const show = (d: number | null | undefined) => (d === null || d === undefined ? '∞' : String(d));
---

<svg class="dj" viewBox={`0 0 ${width} ${height}`} style={`max-width: ${width}px`} role="img" aria-label={label} data-dj-figure>
  {/* 도로: 마을보다 먼저, 원 테두리에서 끊는다 */}
  {ROAD.map((road, r) => <line class="dj-edge" data-edge={r} data-state={edgeStates[r] ?? 'idle'} {...edgeLine(road)} />)}
  {
    ROAD.map((road, r) => {
      const at = weightAt(road);
      return (
        <text class="dj-weight" data-weight={r} data-state={edgeStates[r] ?? 'idle'} x={at.x} y={at.y} dy="0.36em" text-anchor="middle">
          {road[2]}
        </text>
      );
    })
  }

  {/* 마을과 거리 라벨 */}
  {
    villages.map((v) => (
      <g class="dj-node" data-node={v} data-state={nodeStates[v - 1] ?? 'idle'}>
        <circle cx={POS[v].x} cy={POS[v].y} r={R} />
        <text class="dj-id" x={POS[v].x} y={POS[v].y} dy="0.36em" text-anchor="middle">{v}</text>
        <rect class="dj-badge" x={POS[v].x - 16} y={labelY(v) - 10} width="32" height="20" rx="10" />
        <text class="dj-dist" data-dist x={POS[v].x} y={labelY(v)} dy="0.36em" text-anchor="middle">{show(dist[v - 1])}</text>
        <g class="dj-cand" data-cand hidden={cand[v - 1] == null ? true : undefined}>
          <text x={POS[v].x + 30} y={labelY(v)} dy="0.36em" text-anchor="middle">{cand[v - 1] ?? ''}</text>
          <line x1={POS[v].x + 23} y1={labelY(v)} x2={POS[v].x + 37} y2={labelY(v)} />
        </g>
      </g>
    ))
  }
</svg>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */
  .dj {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  .dj [hidden] {
    display: none;
  }

  /* ── 도로 ─────────────────────────────── */
  .dj-edge {
    stroke: var(--node-line);
    stroke-width: 1.75;
    stroke-linecap: round;
    transition: stroke 0.25s, stroke-width 0.25s;
  }

  .dj-edge[data-state='tree'] {
    stroke: var(--stack);
    stroke-width: 3;
  }

  .dj-edge[data-state='try-ok'] {
    stroke: var(--exec);
    stroke-width: 3.5;
  }

  .dj-edge[data-state='try-fail'] {
    stroke: var(--removed);
    stroke-width: 2.5;
    stroke-dasharray: 6 4;
  }

  .dj-weight {
    font-size: 12px;
    fill: var(--fg-dim);
  }

  .dj-weight[data-state='tree'] {
    fill: var(--stack-text);
    font-weight: 700;
  }

  .dj-weight[data-state='try-ok'] {
    fill: var(--exec-text);
    font-weight: 700;
  }

  .dj-weight[data-state='try-fail'] {
    fill: var(--removed);
    font-weight: 700;
  }

  /* ── 마을 ─────────────────────────────── */
  .dj-node circle {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .dj-id {
    font-size: 14px;
    fill: var(--fg);
  }

  .dj-badge {
    fill: var(--bg-side);
    stroke: var(--line);
    stroke-width: 1;
  }

  .dj-dist {
    font-size: 12.5px;
    fill: var(--fg-dim);
  }

  .dj-cand text {
    font-size: 12px;
    font-weight: 700;
    fill: var(--removed);
  }

  .dj-cand line {
    stroke: var(--removed);
    stroke-width: 1.5;
  }

  /* 아직 거리를 모르는 마을 */
  .dj-node[data-state='idle'] circle {
    stroke-dasharray: 2 4;
  }

  .dj-node[data-state='idle'] .dj-id {
    fill: var(--node-idle-text);
  }

  /* 거리 후보가 있는 마을 (pq에 있음) */
  .dj-node[data-state='queued'] circle {
    fill: var(--stack-soft);
    stroke: var(--stack);
    stroke-width: 2;
  }

  .dj-node[data-state='queued'] .dj-id,
  .dj-node[data-state='queued'] .dj-dist {
    fill: var(--stack-text);
    font-weight: 700;
  }

  /* 지금 확정해 이웃을 보는 마을 */
  .dj-node[data-state='active'] circle {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .dj-node[data-state='active'] .dj-id,
  .dj-node[data-state='active'] .dj-dist {
    fill: var(--exec-text);
    font-weight: 700;
  }

  /* 확정한 마을 */
  .dj-node[data-state='done'] circle,
  .dj-node[data-state='over'] circle {
    fill: var(--done-fill);
    stroke: var(--done-line);
  }

  .dj-node[data-state='done'] .dj-id,
  .dj-node[data-state='done'] .dj-dist,
  .dj-node[data-state='over'] .dj-id,
  .dj-node[data-state='over'] .dj-dist {
    fill: var(--done-text);
    font-weight: 700;
  }

  .dj-node[data-state='answer'] circle {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .dj-node[data-state='answer'] .dj-id,
  .dj-node[data-state='answer'] .dj-dist {
    fill: var(--answer);
    font-weight: 700;
  }

  .dj-node[data-state='answer'] .dj-badge {
    stroke: var(--answer);
  }

  /* 이번 단계에 줄어든 거리 */
  .dj-node[data-changed] .dj-badge {
    fill: var(--changed-bg);
    stroke: var(--stack);
  }
</style>
