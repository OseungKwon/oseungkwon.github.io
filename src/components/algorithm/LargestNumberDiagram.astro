---
/**
 * 비교 함수 정렬의 대표 도형 — 수 카드 한 줄 + 두 카드를 비교 규칙에 넣은 저울(두 가지 이어 붙이기).
 *
 * LeetCode 179(Largest Number) 기준: 두 수 a, b 중 누가 앞에 설지는 크기가 아니라
 * 이어 붙인 결과로 정한다. a + b와 b + a를 나란히 적고, 더 큰 쪽의 앞 조각이 앞에 선다.
 * 카드 줄은 그 비교로 정해진 순서다. 끼워 넣는 중인 카드는 줄 위로 들려 있다.
 *
 * 그리기만 맡는다. 단계 진행(LargestNumberSort)과 본문 정적 그림(LargestNumberCompare)이 같은 컴포넌트를 쓴다.
 * 카드 위치는 style의 transform, 상태는 data-state로 두므로 LargestNumberSort의 스크립트가 단계마다 바꿀 수 있다.
 * 스크립트가 같은 좌표로 옮기도록 줄의 시작·간격·높이를 svg의 data 속성으로 알려 준다.
 */
interface Compare {
  /** 앞에 있던 수 (비교 함수의 a) */
  a: string;
  /** 꺼낸 수 (비교 함수의 b) */
  b: string;
}

interface Props {
  /** 카드에 적을 수 (문자열) */
  strs: string[];
  /** 카드마다 놓일 자리 번호 (기본: 제자리) */
  slots?: number[];
  /** 줄 위로 들어 올린 카드 번호 (-1이면 없음) */
  lift?: number;
  /** 카드 상태: idle / active / stack / done / answer */
  cardStates?: string[];
  /** 저울에 올린 두 수. 없으면 저울을 숨긴다 */
  compare?: Compare | null;
  /** 카드 위에 붙일 작은 이름표 (예: ['a', 'b']). 정적 그림용 */
  cardTags?: string[];
  /** 카드를 들어 올릴 자리를 위에 비워 둘지. 들 일이 없는 정적 그림은 false */
  liftSpace?: boolean;
  label: string;
}

const { strs, slots = strs.map((_, i) => i), lift = -1, cardStates = [], compare = null, cardTags = [], liftSpace = true, label } = Astro.props;
const n = strs.length;

const CARD_W = 56;
const CARD_H = 44;
const GAP = 10;
const PAD = 12;
const LIFT_Y = 6;
const ROW_Y = liftSpace ? LIFT_Y + CARD_H + 16 : cardTags.length ? 22 : LIFT_Y;
const PANEL_W = 244;
const ROW_H = 30;
const PANEL_Y = ROW_Y + CARD_H + 22;
const PANEL_GAP = 8;
const rowWidth = n * CARD_W + (n - 1) * GAP;
const width = Math.max(rowWidth, PANEL_W) + PAD * 2;
const height = PANEL_Y + ROW_H * 2 + PANEL_GAP + 6;
const rowLeft = (width - rowWidth) / 2;
const panelLeft = (width - PANEL_W) / 2;

/** 카드 i를 자리 slot에 두는 이동. 들린 카드는 줄 위에 있다 */
const place = (slot: number, lifted: boolean) =>
  `transform: translate(${rowLeft + slot * (CARD_W + GAP)}px, ${lifted ? LIFT_Y : ROW_Y}px)`;

const ab = compare ? compare.a + compare.b : '';
const ba = compare ? compare.b + compare.a : '';
// 이어 붙인 두 문자열은 길이가 같아서, 문자열 비교가 곧 수의 크기 비교다
const winner = !compare || ab === ba ? null : ab > ba ? 'ab' : 'ba';
const rowState = (row: 'ab' | 'ba') => (winner === null ? 'tie' : winner === row ? 'win' : 'lose');
const rows = [
  { id: 'ab', label: 'a + b', first: 'a', second: 'b' },
  { id: 'ba', label: 'b + a', first: 'b', second: 'a' },
] as const;
---

{/* 카드 수가 적으면 그림이 부풀지 않도록 원래 크기 이상으로 늘리지 않는다 */}
<svg class="ln" viewBox={`0 0 ${width} ${height}`} style={`max-width: ${width}px`} role="img" aria-label={label} data-ln-figure data-row-left={rowLeft} data-pitch={CARD_W + GAP} data-lift-y={LIFT_Y} data-row-y={ROW_Y}>
  {/* 수 카드 */}
  {
    strs.map((value, i) => (
      <g class="ln-card" data-card={i} data-state={cardStates[i] ?? 'idle'} style={place(slots[i], i === lift)}>
        <rect width={CARD_W} height={CARD_H} rx="9" />
        <text x={CARD_W / 2} y={CARD_H / 2} dy="0.36em" text-anchor="middle">{value}</text>
        {cardTags[i] && (
          <text class="ln-tag" x={CARD_W / 2} y={-8} text-anchor="middle">
            {cardTags[i]}
          </text>
        )}
      </g>
    ))
  }

  {/* 저울: 두 가지 이어 붙이기. 더 큰 쪽의 앞 조각이 앞에 선다 */}
  <g class="ln-panel" data-panel hidden={!compare}>
    {
      rows.map((row, r) => (
        <g class="ln-row" data-row={row.id} data-state={rowState(row.id)}>
          <rect x={panelLeft} y={PANEL_Y + r * (ROW_H + PANEL_GAP)} width={PANEL_W} height={ROW_H} rx="8" />
          <text class="ln-row__label" x={panelLeft + 12} y={PANEL_Y + r * (ROW_H + PANEL_GAP) + ROW_H / 2} dy="0.36em">
            {row.label}
          </text>
          {/* 조각 사이에 공백이 끼지 않도록 tspan은 한 줄로 둔다 */}
          <text class="ln-row__joined" x={panelLeft + 70} y={PANEL_Y + r * (ROW_H + PANEL_GAP) + ROW_H / 2} dy="0.36em"><tspan class={`ln-part ln-part--${row.first}`} data-part={row.first}>{compare?.[row.first] ?? ''}</tspan><tspan class={`ln-part ln-part--${row.second}`} data-part={row.second}>{compare?.[row.second] ?? ''}</tspan></text>
          <text class="ln-row__verdict" x={panelLeft + PANEL_W - 12} y={PANEL_Y + r * (ROW_H + PANEL_GAP) + ROW_H / 2} dy="0.36em" text-anchor="end">
            더 큼
          </text>
        </g>
      ))
    }
  </g>
</svg>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */
  .ln {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  .ln [hidden] {
    display: none;
  }

  /* ── 카드 ─────────────────────────────── */
  .ln-card {
    transition: transform 0.35s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .ln-card {
      transition: none;
    }
  }

  .ln-card rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .ln-card text {
    font-size: 16px;
    fill: var(--fg);
  }

  .ln-card .ln-tag {
    font-size: 11px;
    font-weight: 700;
    fill: var(--fg-dim);
  }

  /* 아직 보지 않은 수 */
  .ln-card[data-state='idle'] rect {
    stroke-dasharray: 3 3;
  }

  .ln-card[data-state='idle'] text {
    fill: var(--fg-dim);
  }

  /* 꺼내서 자리를 찾는 수 */
  .ln-card[data-state='active'] rect {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .ln-card[data-state='active'] text {
    fill: var(--exec-text);
    font-weight: 700;
  }

  /* 비교 상대 */
  .ln-card[data-state='stack'] rect {
    fill: var(--stack-soft);
    stroke: var(--stack);
    stroke-width: 2;
  }

  .ln-card[data-state='stack'] text {
    fill: var(--stack-text);
    font-weight: 700;
  }

  /* 순서를 정한 수 */
  .ln-card[data-state='done'] rect {
    fill: var(--done-fill);
    stroke: var(--done-line);
  }

  .ln-card[data-state='done'] text {
    fill: var(--done-text);
  }

  .ln-card[data-state='answer'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .ln-card[data-state='answer'] text {
    fill: var(--answer);
    font-weight: 700;
  }

  /* ── 저울 ─────────────────────────────── */
  .ln-row rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .ln-row__label {
    font-family: var(--font-sans);
    font-size: 11.5px;
    fill: var(--fg-dim);
  }

  .ln-row__joined {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .ln-part--a {
    fill: var(--stack-text);
  }

  .ln-part--b {
    fill: var(--exec-text);
  }

  .ln-row__verdict {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--answer);
    opacity: 0;
  }

  .ln-row[data-state='win'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .ln-row[data-state='win'] .ln-row__verdict {
    opacity: 1;
  }

  .ln-row[data-state='lose'] {
    opacity: 0.5;
  }
</style>
