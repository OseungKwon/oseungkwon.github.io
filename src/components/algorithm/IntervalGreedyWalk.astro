---
/**
 * 그리디 — 겹치지 않게 남기려면 몇 개를 빼야 하나(LeetCode 435).
 *
 * 대표 도형은 시간축 위의 구간 막대다(그리기는 IntervalGreedyDiagram).
 *
 *   정렬     → 막대가 끝나는 시각 순서의 행으로 미끄러져 간다
 *   남기기   → 지금 구간이 end 이후에 시작하면 남기고, end 선이 그 구간의 끝으로 옮겨 간다
 *   빼기     → end보다 먼저 시작하면 겹친 부분(시작 ~ end)이 빨갛게 덮이고 removed가 1 늘어난다
 *
 * 지금 보는 구간은 한 단계 동안 노랑으로 두고, 다음 단계에서 남긴 구간(청록)이나 뺀 구간(회색)이 된다.
 * 단계는 빌드 시점에 trace()가 실제로 풀이를 돌려 만든다.
 */
import Visualizer from './Visualizer.astro';
import IntervalGreedyDiagram from './IntervalGreedyDiagram.astro';

// LeetCode 435 예제 1의 네 구간 뒤에 세 구간을 더했다. 예제만으로는 단계가 너무 짧다.
const intervals: [number, number][] = [
  [1, 2],
  [2, 3],
  [3, 4],
  [1, 3],
  [5, 8],
  [2, 6],
  [4, 7],
];
const n = intervals.length;

// 구간: i 아직 / a 지금 / k 남김 / d 뺌
interface Step {
  note: string;
  rows: string;
  states: string;
  end: number | null;
  overlap: [number, number, number] | null;
  cur: [number, number] | null;
  removed: number;
  endChanged?: boolean;
  removedChanged?: boolean;
  result?: number;
}

const noBatchim = (x: number) => '2459'.includes(String(Math.abs(x)).at(-1)!);
const topic = (x: number) => (noBatchim(x) ? '는' : '은');
const direction = (x: number) => ('1245789'.includes(String(Math.abs(x)).at(-1)!) ? '로' : '으로');
const count = (x: number) => ['영', '한', '두', '세', '네', '다섯', '여섯', '일곱'][x];
const iv = ([s, f]: [number, number]) => `[${s}, ${f}]`;

// 풀이와 같은 정렬: 끝나는 시각 순. Array.prototype.sort는 안정 정렬이라 끝이 같으면 입력 순서를 지킨다.
const sorted = intervals.map((_, id) => id).sort((a, b) => intervals[a][1] - intervals[b][1]);

function trace(): Step[] {
  const steps: Step[] = [];
  const cls = intervals.map(() => 'i');
  const rowOf = intervals.map((_, id) => id);
  let end: number | null = null; // 코드의 -Infinity
  let removed = 0;

  const snap = (note: string, extra: Partial<Step> = {}) => {
    steps.push({
      note,
      rows: rowOf.join(''),
      states: cls.join(''),
      end,
      overlap: null,
      cur: null,
      removed,
      ...extra,
    });
  };

  snap(`입력 순서대로 놓인 구간 ${count(n)} 개입니다. "다음"을 누르면 끝나는 시각이 빠른 순서로 정렬합니다`);

  sorted.forEach((id, row) => (rowOf[id] = row));
  snap(`끝나는 시각이 빠른 구간이 위로 오게 정렬했습니다. 맨 위 ${iv(intervals[sorted[0]])}부터 하나씩 봅니다`);

  let prev: { id: number; kept: boolean } | null = null;
  for (const id of sorted) {
    if (prev) cls[prev.id] = prev.kept ? 'k' : 'd';
    cls[id] = 'a';
    const [start, finish] = intervals[id];
    const name = `${iv(intervals[id])}${topic(finish)}`;

    if (end === null || start >= end) {
      // ② 겹치지 않으면 남긴다
      const why =
        end === null
          ? `${name} 처음 보는 구간이라 겹칠 것이 없습니다`
          : start === end
            ? `${name} end ${end}에서 바로 시작해 겹치지 않습니다`
            : `${name} end ${end}보다 뒤에 시작해 겹치지 않습니다`;
      end = finish;
      snap(`${why}. 남기고 end를 ${finish}${direction(finish)} 옮깁니다`, { cur: [start, finish], endChanged: true });
      prev = { id, kept: true };
    } else {
      // ③ 겹치면 뺀다
      removed++;
      snap(`${name} end ${end}보다 먼저 시작해 ${start}부터 ${end}까지 겹칩니다. 빼고 removed를 ${removed}${direction(removed)} 늘립니다`, {
        cur: [start, finish],
        overlap: [id, start, end],
        removedChanged: true,
      });
      prev = { id, kept: false };
    }
  }
  if (prev) cls[prev.id] = prev.kept ? 'k' : 'd';

  const kept = n - removed;
  snap(`구간 ${count(kept)} 개를 남겼으니 뺀 구간은 ${count(removed)} 개입니다. 답은 ${removed}입니다`, {
    result: removed,
  });
  return steps;
}

const steps = trace();

// ── 검증: 끝 결과가 모든 부분집합을 직접 따진 최솟값과 같아야 하고, 같은 풀이가 LeetCode 435 예제 세 개를 맞혀야 한다.
function greedy(list: [number, number][]) {
  const copy = list.map(([s, f]) => [s, f] as [number, number]).sort((a, b) => a[1] - b[1]);
  let end = -Infinity;
  let removed = 0;
  for (const [start, finish] of copy) {
    if (start >= end) end = finish;
    else removed++;
  }
  return removed;
}
function brute(list: [number, number][]) {
  let best = 0;
  for (let mask = 0; mask < 1 << list.length; mask++) {
    const pick = list.filter((_, i) => (mask >> i) & 1).sort((a, b) => a[0] - b[0]);
    if (pick.every((x, i) => i === 0 || pick[i - 1][1] <= x[0])) best = Math.max(best, pick.length);
  }
  return list.length - best;
}
const examples: [[number, number][], number][] = [
  [[[1, 2], [2, 3], [3, 4], [1, 3]], 1],
  [[[1, 2], [1, 2], [1, 2]], 2],
  [[[1, 2], [2, 3]], 0],
];
if (steps.at(-1)!.result !== brute(intervals) || examples.some(([list, out]) => greedy(list) !== out)) {
  throw new Error('IntervalGreedyWalk: 결과가 완전 탐색 값이나 LeetCode 435 예제 출력과 다릅니다.');
}
if (steps.length < 10 || steps.length > 25) {
  throw new Error(`IntervalGreedyWalk: 단계 수 ${steps.length}가 10~25를 벗어났습니다.`);
}

const first = steps[0];
const STATE: Record<string, string> = { i: 'idle', a: 'active', k: 'kept', d: 'dropped' };
---

<Visualizer
  modes={[{ id: 'main', label: '기본' }]}
  steps={{ main: steps }}
  title="구간 막대 · 끝나는 시각 순으로 남기기"
  caption="LeetCode 435 예제 1의 네 구간에 세 구간을 더한 입력입니다. 빌드할 때 풀이를 실제로 돌려 기록한 단계입니다."
  legend={[
    { state: 'active', label: '지금 보는 구간' },
    { state: 'answer', label: '남긴 구간' },
    { state: 'done', label: '겹쳐서 뺀 구간' },
    { state: 'stack', label: '마지막으로 남긴 구간의 끝 (end)' },
  ]}
>
  <Fragment slot="watch">
    <dl class="gw" data-ig-watch>
      <div class="gw-row">
        <dt>[start, finish]</dt>
        <dd><span class="gw-num" data-w="cur">–</span></dd>
      </div>
      <div class="gw-row">
        <dt>end</dt>
        <dd><span class="gw-num" data-w="end">-Infinity</span><span class="gw-hint">남긴 구간의 끝</span></dd>
      </div>
      <div class="gw-row">
        <dt>removed</dt>
        <dd><span class="gw-num" data-w="removed">0</span><span class="gw-hint">뺀 구간 수</span></dd>
      </div>
      <div class="gw-row">
        <dt>return</dt>
        <dd><span class="gw-num" data-w="result">–</span></dd>
      </div>
    </dl>
  </Fragment>

  <Fragment slot="figure">
    <IntervalGreedyDiagram
      intervals={intervals}
      rows={[...first.rows].map(Number)}
      states={[...first.states].map((c) => STATE[c])}
      end={first.end}
      overlap={first.overlap}
      label={`구간 ${n}개를 시간축에 놓은 그림`}
    />
  </Fragment>
</Visualizer>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 정의한다. */
  .gw {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5rem;
  }

  .gw-row {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5rem;
  }

  .gw-row dt {
    color: var(--t-var);
    white-space: nowrap;
  }

  .gw-row dt::after {
    content: ':';
    color: var(--fg);
  }

  .gw-row dd {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
    white-space: nowrap;
  }

  .gw-num {
    color: var(--t-num);
  }

  .gw-hint {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--fg-faint);
  }

  .gw [data-changed] {
    border-radius: 2px;
    background: var(--changed-bg);
    box-shadow: 0 0 0 2px var(--changed-bg);
  }
</style>

<script>
  interface Step {
    rows: string;
    states: string;
    end: number | null;
    overlap: [number, number, number] | null;
    cur: [number, number] | null;
    removed: number;
    endChanged?: boolean;
    removedChanged?: boolean;
    result?: number;
  }

  const STATE: Record<string, string> = { i: 'idle', a: 'active', k: 'kept', d: 'dropped' };

  document.querySelectorAll<SVGSVGElement>('[data-ig-figure]').forEach((figure) => {
    // 같은 도형이 본문의 정적 그림(IntervalGreedyRule)에도 쓰이므로, Visualizer 안에 있는 것만 움직인다.
    const root = figure.closest<HTMLElement>('[data-viz]');
    if (!root) return;
    const watch = root.querySelector<HTMLElement>('[data-ig-watch]')!;
    const w = (name: string) => watch.querySelector<HTMLElement>(`[data-w="${name}"]`)!;
    const top = Number(figure.dataset.top);
    const rowH = Number(figure.dataset.row);
    const unit = Number(figure.dataset.unit);
    const left = Number(figure.dataset.left);
    const lo = Number(figure.dataset.lo);
    const tx = (t: number) => left + (t - lo) * unit;
    const bars = Array.from(figure.querySelectorAll<SVGGElement>('[data-iv]'));
    const overlap = figure.querySelector<SVGGElement>('[data-ig-overlap]')!;
    const overlapRect = overlap.querySelector('rect')!;
    const endLine = figure.querySelector<SVGGElement>('[data-ig-end]')!;

    const set = (name: string, value: string, changed: boolean) => {
      const el = w(name);
      el.textContent = value;
      el.toggleAttribute('data-changed', changed);
    };

    const render = (step: Step) => {
      bars.forEach((bar, id) => {
        bar.setAttribute('data-state', STATE[step.states[id]]);
        bar.style.transform = `translate(0px, ${top + Number(step.rows[id]) * rowH}px)`;
      });

      if (step.overlap) {
        const [id, from, to] = step.overlap;
        overlapRect.setAttribute('x', String(tx(from)));
        overlapRect.setAttribute('width', String(tx(to) - tx(from)));
        overlap.style.transform = `translate(0px, ${top + Number(step.rows[id]) * rowH}px)`;
        overlap.style.display = '';
      } else {
        overlap.style.display = 'none';
      }

      if (step.end === null) {
        endLine.style.display = 'none';
      } else {
        endLine.style.display = '';
        endLine.style.transform = `translate(${tx(step.end)}px, 0px)`;
      }

      set('cur', step.cur ? `[${step.cur[0]}, ${step.cur[1]}]` : '–', false);
      set('end', step.end === null ? '-Infinity' : String(step.end), Boolean(step.endChanged));
      set('removed', String(step.removed), Boolean(step.removedChanged));
      set('result', step.result === undefined ? '–' : String(step.result), step.result !== undefined);
    };

    root.addEventListener('algo:step', (event) => render((event as CustomEvent).detail.step));
    root.dispatchEvent(new CustomEvent('algo:ready'));
  });
</script>
