---
/**
 * 구간 그리디의 대표 도형 — 시간축 위에 구간마다 막대 하나.
 *
 * 구간 하나가 한 행이고, 막대는 시작 시각부터 끝 시각까지 걸친다. 정렬하면 행 순서가 바뀌는데,
 * 막대는 구간마다 하나씩 그려 두고 행 위치만 transform으로 옮긴다. 그래서 정렬 단계에서 막대가
 * 제자리로 미끄러져 간다.
 *
 * 세로 점선(end)은 마지막으로 남긴 구간이 끝나는 시각이다. 다음 구간이 이 선보다 먼저 시작하면
 * 겹치므로, 겹친 구간(시작 ~ end)을 빨간 칸으로 덮어 보인다.
 *
 * 그리기만 맡는다. 단계 진행(IntervalGreedyWalk)과 본문 정적 그림(IntervalGreedyRule)이 같은 컴포넌트를 쓴다.
 * 상태는 data-state로 두므로 IntervalGreedyWalk의 스크립트가 단계마다 바꿀 수 있다.
 */
interface Props {
  intervals: [number, number][];
  /** 구간마다 놓일 행 번호 (기본: 입력 순서) */
  rows?: number[];
  /** 구간 상태: idle / active / kept / dropped */
  states?: string[];
  /** 마지막으로 남긴 구간의 끝. null이면 선을 숨긴다 */
  end?: number | null;
  /** 겹친 부분: [구간 번호, 시작, 끝] */
  overlap?: [number, number, number] | null;
  label: string;
}

const { intervals, rows = intervals.map((_, i) => i), states = [], end = null, overlap = null, label } = Astro.props;
const n = intervals.length;

const LABEL_W = 60;
const UNIT = 38;
const ROW = 30;
const BAR_H = 16;
const TOP = 26;
const lo = Math.min(0, ...intervals.map(([s]) => s));
const hi = Math.max(...intervals.map(([, f]) => f));
const tx = (t: number) => LABEL_W + (t - lo) * UNIT;
const rowY = (row: number) => TOP + row * ROW;
const axisY = rowY(n) + 4;
const width = tx(hi) + 14;
const height = axisY + 26;
const ticks = Array.from({ length: hi - lo + 1 }, (_, i) => lo + i);
const show = (value: number | null) => (value === null ? 'display: none' : '');
---

{/* 구간이 적으면 그림이 부풀지 않도록 원래 크기 이상으로 늘리지 않는다 */}
<svg
  class="ig"
  viewBox={`0 0 ${width} ${height}`}
  style={`max-width: ${width}px`}
  role="img"
  aria-label={label}
  data-ig-figure
  data-top={TOP}
  data-row={ROW}
  data-unit={UNIT}
  data-left={LABEL_W}
  data-lo={lo}
>
  {/* 시간축: 눈금마다 옅은 세로선 */}
  {
    ticks.map((t) => (
      <g class="ig-tick">
        <line x1={tx(t)} y1={TOP - 6} x2={tx(t)} y2={axisY} />
        <text x={tx(t)} y={axisY + 16} text-anchor="middle">{t}</text>
      </g>
    ))
  }
  <line class="ig-axis" x1={tx(lo)} y1={axisY} x2={tx(hi)} y2={axisY} />

  {/* 구간 막대: 구간마다 하나, 행 위치는 transform */}
  {
    intervals.map(([start, finish], i) => (
      <g class="ig-iv" data-iv={i} data-state={states[i] ?? 'idle'} style={`transform: translate(0px, ${rowY(rows[i])}px)`}>
        <text class="ig-label" x={LABEL_W - 10} y={BAR_H / 2} dy="0.36em" text-anchor="end">[{start}, {finish}]</text>
        <rect x={tx(start)} y="0" width={tx(finish) - tx(start)} height={BAR_H} rx="4" />
      </g>
    ))
  }

  {/* 겹친 부분: 지금 구간의 시작부터 end까지 */}
  <g
    class="ig-overlap"
    data-ig-overlap
    style={overlap ? `transform: translate(0px, ${rowY(rows[overlap[0]])}px)` : 'display: none'}
  >
    <rect
      x={overlap ? tx(overlap[1]) : 0}
      y="-3"
      width={overlap ? tx(overlap[2]) - tx(overlap[1]) : 0}
      height={BAR_H + 6}
      rx="4"
    />
  </g>

  {/* end 선: 마지막으로 남긴 구간이 끝나는 시각 */}
  <g class="ig-end" data-ig-end style={end === null ? show(end) : `transform: translate(${tx(end)}px, 0px)`}>
    <line x1="0" y1={TOP - 10} x2="0" y2={axisY} />
    <text x="0" y={TOP - 14} text-anchor="middle">end</text>
  </g>
</svg>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 정의한다. */
  .ig {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  .ig-tick line {
    stroke: var(--line);
    stroke-width: 1;
  }

  .ig-tick text {
    font-size: 10px;
    fill: var(--node-idle-text);
  }

  .ig-axis {
    stroke: var(--node-line);
    stroke-width: 1.5;
  }

  /* ── 구간 막대 ───────────────────────── */
  .ig-iv {
    transition: transform 0.4s ease;
  }

  .ig-iv rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s, opacity 0.25s;
  }

  .ig-label {
    font-size: 11.5px;
    fill: var(--fg-dim);
    transition: fill 0.25s, opacity 0.25s;
  }

  /* 아직 보지 않은 구간 */
  .ig-iv[data-state='idle'] rect {
    stroke-dasharray: 3 3;
  }

  /* 지금 보는 구간 */
  .ig-iv[data-state='active'] rect {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .ig-iv[data-state='active'] .ig-label {
    fill: var(--exec-text);
    font-weight: 700;
  }

  /* 남긴 구간 */
  .ig-iv[data-state='kept'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .ig-iv[data-state='kept'] .ig-label {
    fill: var(--answer);
    font-weight: 700;
  }

  /* 겹쳐서 뺀 구간: 흐리게, 이름에 취소선 */
  .ig-iv[data-state='dropped'] rect {
    fill: var(--done-fill);
    stroke: var(--done-line);
    opacity: 0.6;
  }

  .ig-iv[data-state='dropped'] .ig-label {
    fill: var(--done-text);
    text-decoration: line-through;
  }

  /* ── 겹친 부분 ───────────────────────── */
  .ig-overlap {
    transition: transform 0.3s ease;
  }

  .ig-overlap rect {
    fill: var(--removed-bg);
    stroke: var(--removed);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }

  /* ── end 선 ─────────────────────────── */
  .ig-end {
    transition: transform 0.35s ease;
  }

  .ig-end line {
    stroke: var(--stack);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }

  .ig-end text {
    font-size: 11px;
    font-weight: 700;
    fill: var(--stack-text);
  }
</style>
