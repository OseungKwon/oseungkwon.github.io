---
/**
 * 누적 합 + 빈도 Map — 합이 k인 연속 구간 세기(LeetCode 560).
 *
 * 대표 도형은 "원본 줄 위에 누적 줄"이다. 위 줄은 nums 칸, 아래 줄은 칸 사이 울타리 기둥에
 * 선 누적 합이다. 기둥 0은 첫 칸 앞(누적 합 0), 기둥 j는 j번째 칸 뒤다. 그래서 기둥 i와 j
 * 사이의 칸들이 곧 구간 nums[i..j-1]이고, 그 합은 prefix[j] - prefix[i]다.
 *
 *   기둥에 도착   → 누적 합이 드러나고, prefix - k였던 앞 기둥들과 호로 이어진다
 *                   (호 아래 칸들 = 합이 k인 구간)
 *   Map에 적기    → 이번 누적 합을 몇 번째로 봤는지 기록한다
 *
 * '0 없이 시작' 모드는 Map을 {0: 1}이 아니라 빈 채로 시작한다. 기둥 0과 이어지는 구간,
 * 즉 첫 칸부터 시작하는 구간을 놓쳐 결과가 하나 모자란다.
 *
 * 단계는 빌드 시점에 trace()가 실제로 풀이를 돌려 만든다.
 */
import Visualizer from './Visualizer.astro';
import PrefixSumDiagram from './PrefixSumDiagram.astro';

const nums = [1, 2, 3, -2, 2, 1, 2];
const k = 3;

// ── 누적 합 (기둥 0..n)
const prefix = [0];
for (const x of nums) prefix.push(prefix.at(-1)! + x);
const n = nums.length;

// 이 입력에서 나올 수 있는 모든 짝(i < j, prefix[j] - prefix[i] = k). 호를 미리 그려 두려고 모은다.
const pairs: [number, number][] = [];
for (let j = 1; j <= n; j++) for (let i = 0; i < j; i++) if (prefix[j] - prefix[i] === k) pairs.push([i, j]);

// Map에 들어갈 수 있는 값을 처음 나온 순서로
const mapKeys = [...new Set(prefix)];

// ── 실행 기록
// 칸: n 보통 / a 방금 더한 칸 / w 이번에 찾은 구간 / x 놓친 구간
// 기둥: i 아직 / a 지금 / w 짝이 된 앞 기둥 / d 지나옴 / x 놓친 짝
// 호: h 숨김 / w 이번에 찾음 / d 전에 찾음 / x 이번에 놓침 / m 전에 놓침
interface Step {
  note: string;
  cells: string;
  posts: string;
  arcs: string;
  prefix: number | null;
  target: number | null;
  map: Record<string, number>;
  changedKey?: number;
  hitKey?: number;
  result: number;
  resultChanged?: boolean;
  short?: boolean;
}

const noBatchim = (n: number) => '2459'.includes(String(Math.abs(n)).at(-1)!);
const topic = (n: number) => (noBatchim(n) ? '는' : '은');
const particle = (n: number) => (noBatchim(n) ? '를' : '을');
const show = (arr: number[]) => `[${arr.join(', ')}]`;

function trace(seed: boolean): Step[] {
  const count = new Map<number, number>();
  if (seed) count.set(0, 1);
  let result = 0;
  const steps: Step[] = [];
  const arcState = pairs.map(() => 'h');

  const snap = (note: string, at: number, extra: Partial<Step> & { cells?: string; posts?: string } = {}) => {
    const posts = extra.posts ?? prefix.map((_, i) => (i === at ? 'a' : i < at ? 'd' : 'i')).join('');
    steps.push({
      note,
      cells: extra.cells ?? 'n'.repeat(n),
      posts,
      arcs: arcState.join(''),
      prefix: at >= 0 ? prefix[at] : null,
      target: null,
      map: Object.fromEntries(count),
      result,
      ...extra,
    });
  };

  snap(
    seed
      ? '아직 한 칸도 더하지 않은 기둥 0에서 시작합니다. 누적 합 0을 Map에 1번으로 적어 둡니다'
      : 'Map을 비워 둔 채 기둥 0에서 시작합니다',
    0,
  );

  for (let j = 1; j <= n; j++) {
    const p = prefix[j];
    const target = p - k;
    // 지난 단계에서 찾은 호는 흐리게
    arcState.forEach((s, a) => {
      if (s === 'w') arcState[a] = 'd';
      if (s === 'x') arcState[a] = 'm';
    });

    // ① 도착하고, prefix - k였던 앞 기둥을 찾는다
    const found = count.get(target) ?? 0;
    const cells = [...'n'.repeat(n)];
    const posts = prefix.map((_, i) => (i === j ? 'a' : i < j ? 'd' : 'i'));
    const matched: number[] = [];
    let missed: number | null = null;
    pairs.forEach(([a, b], idx) => {
      if (b !== j) return;
      const counted = seed || a !== 0;
      if (counted) {
        arcState[idx] = 'w';
        posts[a] = 'w';
        matched.push(a);
        for (let c = a; c < b; c++) cells[c] = 'w';
      } else {
        arcState[idx] = 'x';
        posts[a] = 'x';
        missed = a;
        for (let c = a; c < b; c++) cells[c] = 'x';
      }
    });
    if (cells[j - 1] === 'n') cells[j - 1] = 'a';
    result += found;

    const head = `${nums[j - 1]}${particle(nums[j - 1])} 더해 기둥 ${j}에 왔습니다. 누적 합 ${p}에서 ${k}${particle(k)} 빼면 ${target}`;
    let note: string;
    if (missed !== null) {
      note = `${head}. 기둥 0이 짝인데 Map에 0이 없어 ${show(nums.slice(0, j))}${particle(nums[j - 1])} 놓칩니다`;
    } else if (found === 0) {
      note = `${head}. ${target}${topic(target)} 아직 Map에 없어 찾은 구간이 없습니다`;
    } else {
      const spans = matched.map((a) => show(nums.slice(a, j))).join(', ');
      note = `${head}. ${target}${topic(target)} Map에 ${found}번 있으니 구간 ${found}개: ${spans}`;
    }
    snap(note, j, {
      cells: cells.join(''),
      posts: posts.join(''),
      target,
      hitKey: found > 0 ? target : undefined,
      resultChanged: found > 0,
    });

    // ② 이번 누적 합을 Map에 적는다
    const times = (count.get(p) ?? 0) + 1;
    count.set(p, times);
    const last = j === n;
    const record = times === 1 ? `누적 합 ${p}${particle(p)} Map에 처음 적습니다` : `누적 합 ${p}${topic(p)} 두 번째라 Map의 횟수를 ${times}로 올립니다`;
    snap(
      last
        ? `${record}. 끝까지 걸었고, 합이 ${k}인 구간은 모두 ${result}개입니다`
        : record,
      j,
      { changedKey: p, short: last && !seed },
    );
  }
  return steps;
}

const seedSteps = trace(true);
const emptySteps = trace(false);

// 검증: 처음 세 칸은 LeetCode 560 예제 2(nums = [1, 2, 3], k = 3 → 2)와 같다.
// 단계는 시작 1개 + 기둥마다 2개(짝 찾기, Map에 적기)라, 기둥 j를 마친 단계는 2 * j번째다.
const afterThree = seedSteps[2 * 3].result;
// 끝 결과는 모든 구간을 직접 더해 센 값과 같아야 한다.
let brute = 0;
for (let i = 0; i < n; i++) for (let j = i + 1; j <= n; j++) if (nums.slice(i, j).reduce((a, b) => a + b, 0) === k) brute++;
const startsAtZero = pairs.filter(([a]) => a === 0).length;
if (afterThree !== 2 || seedSteps.at(-1)!.result !== brute || emptySteps.at(-1)!.result !== brute - startsAtZero) {
  throw new Error('PrefixSumWalk: 결과가 예제 2 출력이나 직접 센 구간 수와 다릅니다.');
}

const MODES = [
  { id: 'seed', label: '{0: 1}로 시작' },
  { id: 'empty', label: '빈 Map으로 시작' },
];
const first = seedSteps[0];
const CELL_STATE: Record<string, string> = { n: 'idle', a: 'active', w: 'answer', x: 'wrong' };
const POST_STATE: Record<string, string> = { i: 'idle', a: 'active', w: 'answer', d: 'done', x: 'wrong' };
---

<Visualizer
  modes={MODES}
  steps={{ seed: seedSteps, empty: emptySteps }}
  title={`누적 합 · nums = [${nums.join(', ')}], k = ${k}`}
  caption="앞 세 칸은 LeetCode 560 예제 2(nums = [1, 2, 3], k = 3 → 2)와 같습니다. 빌드할 때 풀이를 실제로 돌려 기록한 단계입니다."
  legend={[
    { state: 'active', label: '지금 선 기둥' },
    { state: 'answer', label: '이번에 찾은 구간과 짝 기둥' },
    { state: 'done', label: '지나온 기둥' },
    { state: 'idle', label: '아직 안 간 기둥' },
  ]}
>
  <Fragment slot="watch">
    <dl class="pw" data-ps-watch>
      <div class="pw-row">
        <dt>prefix</dt>
        <dd><span class="pw-num" data-w="prefix">0</span></dd>
      </div>
      <div class="pw-row">
        <dt>prefix - k</dt>
        <dd><span class="pw-num" data-w="target">–</span></dd>
      </div>
      <div class="pw-row pw-row--map">
        <dt>count</dt>
        {/* 원소 사이에 템플릿 줄바꿈이 끼면 공백이 생긴다. 한 줄로 둔다. */}
        <dd class="pw-map">{mapKeys.map((key) => <span class="pw-chip" data-key={key} hidden><span class="pw-key">{key}</span><span class="pw-arrow">:</span><span class="pw-times" data-times>0</span></span>)}</dd>
      </div>
      <div class="pw-row">
        <dt>result</dt>
        <dd><span class="pw-result" data-w="result">0</span></dd>
      </div>
    </dl>
  </Fragment>

  <Fragment slot="figure">
    <PrefixSumDiagram
      nums={nums}
      pairs={pairs}
      cellStates={[...first.cells].map((c) => CELL_STATE[c])}
      postStates={[...first.posts].map((c) => POST_STATE[c])}
      label={`nums = [${nums.join(', ')}]의 누적 합과 합이 ${k}인 구간`}
    />
  </Fragment>
</Visualizer>

<style>
  /* 색 변수(--exec, --stack, --answer, --node-* 등)는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */

  /* ── 변수 ─────────────────────────────── */
  .pw {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5rem;
  }

  .pw-row {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
    white-space: nowrap;
  }

  .pw-row--map {
    flex-direction: column;
    gap: 0.25rem;
  }

  .pw-row dt {
    color: var(--t-var);
  }

  .pw-row:not(.pw-row--map) dt::after {
    content: ':';
    color: var(--fg);
  }

  .pw-row dd {
    margin: 0;
    color: var(--fg);
  }

  .pw-num,
  .pw-result {
    color: var(--t-num);
  }

  .pw-map {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .pw-chip {
    display: inline-flex;
    gap: 0.125rem;
    padding: 0 0.4375rem;
    border: 1px solid var(--node-line);
    border-radius: 6px;
    color: var(--fg);
    background: var(--node-bg);
  }

  .pw-chip[hidden] {
    display: none;
  }

  .pw-key {
    color: var(--t-num);
  }

  .pw-arrow {
    color: var(--fg-dim);
  }

  /* 이번에 찾은 값 */
  .pw-chip[data-hit] {
    border-color: var(--answer);
    background: var(--answer-soft);
  }

  /* 이번에 적은 값 */
  .pw-chip[data-changed],
  .pw [data-changed] {
    background: var(--changed-bg);
    border-color: transparent;
  }

  .pw-result[data-short] {
    color: var(--removed);
  }
</style>

<script>
  interface Step {
    cells: string;
    posts: string;
    arcs: string;
    prefix: number | null;
    target: number | null;
    map: Record<string, number>;
    changedKey?: number;
    hitKey?: number;
    result: number;
    resultChanged?: boolean;
    short?: boolean;
  }

  const CELL: Record<string, string> = { n: 'idle', a: 'active', w: 'answer', x: 'wrong' };
  const POST: Record<string, string> = { i: 'idle', a: 'active', w: 'answer', d: 'done', x: 'wrong' };
  const ARC: Record<string, string> = { h: 'hidden', w: 'found', d: 'past', x: 'missed', m: 'missed-past' };

  document.querySelectorAll<SVGSVGElement>('[data-ps-figure]').forEach((figure) => {
    // 같은 도형이 본문의 정적 그림(PrefixSumSpan)에도 쓰이므로, Visualizer 안에 있는 것만 움직인다.
    const root = figure.closest<HTMLElement>('[data-viz]');
    if (!root) return;
    const watch = root.querySelector<HTMLElement>('[data-ps-watch]')!;
    const w = (name: string) => watch.querySelector<HTMLElement>(`[data-w="${name}"]`)!;
    const cells = Array.from(figure.querySelectorAll<SVGGElement>('[data-cell]'));
    const posts = Array.from(figure.querySelectorAll<SVGGElement>('[data-post]'));
    const arcs = Array.from(figure.querySelectorAll<SVGPathElement>('[data-arc]'));
    const chips = Array.from(watch.querySelectorAll<HTMLElement>('[data-key]'));

    const render = (step: Step) => {
      cells.forEach((el, i) => el.setAttribute('data-state', CELL[step.cells[i]]));
      posts.forEach((el, i) => el.setAttribute('data-state', POST[step.posts[i]]));
      arcs.forEach((el, i) => el.setAttribute('data-state', ARC[step.arcs[i]]));

      w('prefix').textContent = step.prefix === null ? '–' : String(step.prefix);
      w('target').textContent = step.target === null ? '–' : String(step.target);

      chips.forEach((chip) => {
        const key = chip.dataset.key!;
        const times = step.map[key];
        chip.hidden = times === undefined;
        chip.querySelector('[data-times]')!.textContent = String(times ?? 0);
        chip.toggleAttribute('data-changed', String(step.changedKey) === key);
        chip.toggleAttribute('data-hit', String(step.hitKey) === key);
      });

      const result = w('result');
      result.textContent = String(step.result);
      result.toggleAttribute('data-changed', Boolean(step.resultChanged));
      result.toggleAttribute('data-short', Boolean(step.short));
    };

    root.addEventListener('algo:step', (event) => render((event as CustomEvent).detail.step));
    root.dispatchEvent(new CustomEvent('algo:ready'));
  });
</script>
