---
/**
 * 다익스트라 — 프로그래머스 「배달」 예제 1에서 1번 마을로부터 각 마을까지의 최단 거리를 구하는 과정.
 *
 * 대표 도형은 가중치 그래프와 마을마다 붙은 거리 라벨이다(그리기는 DijkstraDiagram).
 *
 *   확정       → pq에서 거리가 가장 작은 마을을 꺼내 그 거리를 확정한다
 *   완화       → 확정한 마을에서 나가는 도로로 이웃에 가 보고, 더 짧으면 이웃의 라벨을 줄인다
 *   완화 실패  → 더 짧지 않으면 라벨을 그대로 두고, 계산한 후보 거리를 한 단계 동안 빨간 취소선으로 남긴다
 *
 * 이미 확정한 이웃으로 가는 도로는 라벨을 줄일 수 없어 도형이 바뀌지 않으므로 단계로 남기지 않는다.
 * 계산은 dijkstra-trace.ts에 있고, 빌드 시점에 실제로 돌려 단계를 만든다.
 */
import Visualizer from './Visualizer.astro';
import DijkstraDiagram from './DijkstraDiagram.astro';
import { EXPECTED, K, N, ROAD, solution, traceDijkstra } from './dijkstra-trace';

const steps = traceDijkstra();

// 검증: 예제 1 출력(4)과 같아야 하고, 참고 풀이와 같은 값을 내야 한다.
const final = steps.at(-1)!;
if (final.result !== EXPECTED || solution(N, ROAD, K) !== EXPECTED) {
  throw new Error('DijkstraWalk: 결과가 프로그래머스 배달 예제 1 출력(4)과 다릅니다.');
}

const first = steps[0];
const pqSlots = Math.max(...steps.map((s) => s.pq.length + (s.popped ? 1 : 0)));
const NODE: Record<string, string> = { i: 'idle', q: 'queued', a: 'active', d: 'done', w: 'answer', o: 'over' };
const EDGE: Record<string, string> = { i: 'idle', t: 'tree', y: 'try-ok', f: 'try-fail' };
const roadText = ROAD.map((r) => `[${r.join(',')}]`).join(',');
---

<Visualizer
  modes={[{ id: 'main', label: '기본' }]}
  steps={{ main: steps }}
  title={`가중치 그래프 · N = ${N}, K = ${K}`}
  caption={`프로그래머스 「배달」 예제 1 (road = [${roadText}]). 빌드할 때 풀이를 실제로 돌려 기록한 단계입니다.`}
  legend={[
    { state: 'active', label: '지금 확정해 이웃을 보는 마을' },
    { state: 'stack', label: '거리 후보가 있는 마을 · 지금까지의 최단 경로' },
    { state: 'done', label: '거리를 확정한 마을' },
    { state: 'answer', label: `${K}시간 안에 닿는 마을` },
  ]}
>
  <Fragment slot="watch">
    <dl class="djw" data-dj-watch>
      <div class="djw-row">
        <dt>dist</dt>
        {/* 원소 사이에 템플릿 줄바꿈이 끼면 공백이 생긴다. 한 줄로 둔다 */}
        <dd>[{first.dist.map((d, k) => <span class="djw-item"><span class="djw-sep">, </span><span class="djw-num" data-dist={k}>{d ?? '∞'}</span></span>)}]<span class="djw-hint">1~{N}번 마을</span></dd>
      </div>
      <div class="djw-row djw-row--pq">
        <dt>pq</dt>
        <dd>[{Array.from({ length: pqSlots }, (_, i) => <span class="djw-item" data-pq={i} hidden><span class="djw-sep">, </span><span class="djw-num" data-v /></span>)}]</dd>
      </div>
      <div class="djw-row">
        <dt>result</dt>
        <dd><span class="djw-result" data-w="result">–</span></dd>
      </div>
    </dl>
  </Fragment>

  <Fragment slot="figure">
    <DijkstraDiagram
      nodeStates={[...first.nodes].map((c) => NODE[c])}
      edgeStates={[...first.edges].map((c) => EDGE[c])}
      dist={first.dist}
      label={`마을 ${N}개와 도로 ${ROAD.length}개로 된 가중치 그래프에서 1번 마을로부터의 최단 거리를 구하는 과정`}
    />
  </Fragment>
</Visualizer>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */
  .djw {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5rem;
  }

  .djw-row {
    display: flex;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .djw-row dt {
    min-width: 3rem;
    color: var(--t-var);
  }

  .djw-row dt::after {
    content: ':';
    color: var(--fg);
  }

  .djw-row dd {
    margin: 0;
    color: var(--fg);
  }

  .djw-row--pq dd {
    white-space: normal;
  }

  .djw-item[hidden] {
    display: none;
  }

  /* 맨 앞 원소의 쉼표는 숨긴다 */
  .djw-item:first-child .djw-sep,
  .djw-item[data-first] .djw-sep {
    display: none;
  }

  .djw-num,
  .djw-result {
    color: var(--t-num);
  }

  .djw-hint {
    margin-left: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--fg-faint);
  }

  /* 방금 pq에서 꺼낸 값 */
  .djw-item[data-popped] .djw-num {
    color: var(--removed);
    text-decoration: line-through;
  }

  .djw [data-changed] {
    border-radius: 2px;
    background: var(--changed-bg);
    box-shadow: 0 0 0 2px var(--changed-bg);
  }
</style>

<script>
  import type { Step } from './dijkstra-trace';

  const NODE: Record<string, string> = { i: 'idle', q: 'queued', a: 'active', d: 'done', w: 'answer', o: 'over' };
  const EDGE: Record<string, string> = { i: 'idle', t: 'tree', y: 'try-ok', f: 'try-fail' };

  document.querySelectorAll<SVGSVGElement>('[data-dj-figure]').forEach((figure) => {
    // 같은 도형이 본문의 정적 그림에도 쓰이므로, Visualizer 안에 있는 것만 움직인다.
    const root = figure.closest<HTMLElement>('[data-viz]');
    if (!root) return;
    const watch = root.querySelector<HTMLElement>('[data-dj-watch]')!;
    const nodes = Array.from(figure.querySelectorAll<SVGGElement>('[data-node]'));
    const edges = Array.from(figure.querySelectorAll<SVGLineElement>('[data-edge]'));
    const weights = Array.from(figure.querySelectorAll<SVGTextElement>('[data-weight]'));
    const distEls = Array.from(watch.querySelectorAll<HTMLElement>('[data-dist]'));
    const pqEls = Array.from(watch.querySelectorAll<HTMLElement>('[data-pq]'));
    const result = watch.querySelector<HTMLElement>('[data-w="result"]')!;

    const render = (step: Step) => {
      nodes.forEach((el, k) => {
        el.setAttribute('data-state', NODE[step.nodes[k]]);
        el.toggleAttribute('data-changed', step.changed === k + 1);
        el.querySelector('[data-dist]')!.textContent = step.dist[k] === null ? '∞' : String(step.dist[k]);
        const cand = el.querySelector<SVGGElement>('[data-cand]')!;
        if (step.cand[k] === null) {
          cand.setAttribute('hidden', '');
        } else {
          cand.removeAttribute('hidden');
          cand.querySelector('text')!.textContent = String(step.cand[k]);
        }
      });
      edges.forEach((el, r) => el.setAttribute('data-state', EDGE[step.edges[r]]));
      weights.forEach((el, r) => el.setAttribute('data-state', EDGE[step.edges[r]]));

      distEls.forEach((el, k) => {
        el.textContent = step.dist[k] === null ? '∞' : String(step.dist[k]);
        el.toggleAttribute('data-changed', step.changed === k + 1);
      });

      // pq: 방금 꺼낸 값을 한 단계 동안 취소선으로 앞에 남기고, 이어서 남은 값 (거리 순)
      const items = [...(step.popped ? [{ v: step.popped, popped: true }] : []), ...step.pq.map((v) => ({ v, popped: false }))];
      pqEls.forEach((el, i) => {
        const item = items[i];
        el.hidden = !item;
        el.toggleAttribute('data-first', i === 0);
        el.toggleAttribute('data-popped', Boolean(item?.popped));
        el.querySelector('[data-v]')!.textContent = item ? `[${item.v.join(', ')}]` : '';
      });

      result.textContent = step.result === null ? '–' : String(step.result);
      result.toggleAttribute('data-changed', step.result !== null);
    };

    root.addEventListener('algo:step', (event) => render((event as CustomEvent).detail.step));
    root.dispatchEvent(new CustomEvent('algo:ready'));
  });
</script>
