---
/**
 * 누적 합의 대표 도형 — nums 칸 줄 + 칸 사이 기둥(누적 합) + 기둥을 잇는 호.
 *
 * 기둥 0은 첫 칸 앞(누적 합 0), 기둥 j는 j번째 칸 nums[j-1]의 뒤다. 기둥 i와 j 사이의 칸이
 * 구간 nums[i..j-1]이고, 그 합은 prefix[j] - prefix[i]다. 호는 그런 두 기둥을 잇는다.
 *
 * 그리기만 맡는다. 단계 진행(PrefixSumWalk)과 본문 속 정적 그림(PrefixSumSpan)이 같은
 * 컴포넌트를 써서, 독자는 본문의 작은 그림과 아래 시각화를 같은 도형으로 읽는다.
 * 상태는 data-state로 두므로 PrefixSumWalk의 스크립트가 단계마다 바꿀 수 있다.
 */
interface Props {
  nums: number[];
  /** 이을 수 있는 기둥 쌍 [i, j]. 단계 진행에서는 나올 수 있는 모든 쌍을 미리 그려 둔다 */
  pairs?: [number, number][];
  cellStates?: string[];
  postStates?: string[];
  arcStates?: string[];
  /** 호 아래 설명 (예: "4 − 3 = 1"). pairs와 같은 순서 */
  arcLabels?: (string | undefined)[];
  label: string;
}

const { nums, pairs = [], cellStates = [], postStates = [], arcStates = [], arcLabels = [], label } = Astro.props;

const prefix = [0];
for (const x of nums) prefix.push(prefix.at(-1)! + x);
const n = nums.length;

const CELL = 54;
const LEFT = 22;
const CELL_TOP = 26;
const CELL_H = 42;
const POST_Y = 112;
const R = 15;
const ARC_Y = POST_Y + R + 6;
const postX = (i: number) => LEFT + i * CELL;
const arcDepth = (i: number, j: number) => 14 + (j - i) * 9;
const deepest = Math.max(0, ...pairs.map(([i, j]) => arcDepth(i, j)));
const hasLabel = arcLabels.some(Boolean);
const width = LEFT * 2 + n * CELL;
const height = (pairs.length ? ARC_Y + deepest : POST_Y + R) + (hasLabel ? 30 : 12);
const arcPath = ([i, j]: [number, number]) => {
  const x1 = postX(i);
  const x2 = postX(j);
  return `M ${x1} ${ARC_Y} Q ${(x1 + x2) / 2} ${ARC_Y + arcDepth(i, j) * 2} ${x2} ${ARC_Y}`;
};
---

{/* 칸 수가 적으면 그림이 부풀지 않도록 원래 크기 이상으로 늘리지 않는다 */}
<svg class="ps" viewBox={`0 0 ${width} ${height}`} style={`max-width: ${width}px`} role="img" aria-label={label} data-ps-figure>
  {/* 위 줄: nums 칸 */}
  {
    nums.map((value, i) => (
      <g class="ps-cell" data-cell={i} data-state={cellStates[i] ?? 'idle'}>
        <rect x={postX(i) + 3} y={CELL_TOP} width={CELL - 6} height={CELL_H} rx="8" />
        <text x={postX(i) + CELL / 2} y={CELL_TOP + CELL_H / 2} dy="0.36em" text-anchor="middle">{value}</text>
        <text class="ps-index" x={postX(i) + CELL / 2} y={CELL_TOP - 9} text-anchor="middle">{i}</text>
      </g>
    ))
  }
  {/* 칸 사이 울타리 → 기둥 */}
  {prefix.map((_, i) => <line class="ps-fence" x1={postX(i)} y1={CELL_TOP - 2} x2={postX(i)} y2={POST_Y - R} />)}
  {/* 호: 두 기둥을 잇는다 */}
  {pairs.map((pair, idx) => <path class="ps-arc" data-arc={idx} data-state={arcStates[idx] ?? 'hidden'} d={arcPath(pair)} />)}
  {
    pairs.map(([i, j], idx) =>
      arcLabels[idx] ? (
        <text class="ps-arc-label" x={(postX(i) + postX(j)) / 2} y={ARC_Y + arcDepth(i, j) + 18} text-anchor="middle">
          {arcLabels[idx]}
        </text>
      ) : null,
    )
  }
  {/* 아래 줄: 기둥의 누적 합 */}
  {
    prefix.map((value, i) => (
      <g class="ps-post" data-post={i} data-state={postStates[i] ?? 'done'}>
        <circle cx={postX(i)} cy={POST_Y} r={R} />
        <text x={postX(i)} y={POST_Y} dy="0.36em" text-anchor="middle">{value}</text>
        <text class="ps-index" x={postX(i)} y={POST_Y - R - 6} text-anchor="middle">{i}</text>
      </g>
    ))
  }
</svg>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */

  .ps {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  /* ── nums 칸 ─────────────────────────── */
  .ps-cell rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .ps-cell text {
    font-size: 15px;
    fill: var(--fg);
  }

  .ps-cell .ps-index {
    font-size: 10px;
    fill: var(--node-idle-text);
  }

  .ps-cell[data-state='active'] rect {
    stroke: var(--exec);
    stroke-width: 2;
  }

  .ps-cell[data-state='answer'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .ps-cell[data-state='answer'] text:not(.ps-index) {
    fill: var(--answer);
    font-weight: 700;
  }

  .ps-cell[data-state='wrong'] rect {
    fill: var(--removed-bg);
    stroke: var(--removed);
    stroke-dasharray: 4 3;
  }

  /* ── 울타리와 기둥 ──────────────────── */
  .ps-fence {
    stroke: var(--node-line);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .ps-post circle {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .ps-post text {
    font-size: 13px;
    fill: var(--fg);
    transition: opacity 0.2s;
  }

  /* 아직 안 간 기둥은 누적 합을 모른다 */
  .ps-post[data-state='idle'] circle {
    stroke-dasharray: 2 4;
  }

  .ps-post[data-state='idle'] text {
    opacity: 0;
  }

  .ps-post[data-state='done'] circle {
    fill: var(--done-fill);
    stroke: var(--done-line);
  }

  .ps-post[data-state='done'] text {
    fill: var(--done-text);
  }

  .ps-post[data-state='active'] circle {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .ps-post[data-state='active'] text {
    fill: var(--exec-text);
    font-weight: 700;
  }

  .ps-post[data-state='answer'] circle {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-width: 2;
  }

  .ps-post[data-state='answer'] text {
    fill: var(--answer);
    font-weight: 700;
  }

  .ps-post[data-state='wrong'] circle {
    fill: var(--removed-bg);
    stroke: var(--removed);
    stroke-dasharray: 4 3;
  }

  .ps-post[data-state='wrong'] text {
    fill: var(--removed);
  }

  /* ── 호 ──────────────────────────────── */
  .ps-arc {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    transition: opacity 0.25s;
  }

  .ps-arc[data-state='hidden'] {
    opacity: 0;
  }

  .ps-arc[data-state='found'] {
    stroke: var(--answer);
    stroke-width: 2.5;
  }

  .ps-arc[data-state='past'] {
    stroke: var(--done-line);
    opacity: 0.55;
  }

  .ps-arc[data-state='missed'] {
    stroke: var(--removed);
    stroke-dasharray: 5 4;
  }

  .ps-arc[data-state='missed-past'] {
    stroke: var(--removed);
    stroke-dasharray: 5 4;
    opacity: 0.4;
  }

  .ps-arc-label {
    font-size: 12px;
    fill: var(--answer);
    font-weight: 700;
  }

  /* 기둥 번호는 아직 안 간 기둥에서도 보인다 (누적 합 값만 숨긴다) */
  .ps-post[data-state] .ps-index {
    font-size: 9px;
    font-weight: 400;
    fill: var(--node-idle-text);
    opacity: 1;
  }
</style>
