---
/**
 * 단조 스택의 대표 도형 — 입력 칸 줄 + 오른쪽의 세로 스택.
 *
 *   ⌒+4⌒                          ┌    ┐
 *   [73][74][75][71][69][72][76][73]   │ 69 │ ← 맨 위
 *    0   1   2   3   4   5   6   7     │ 71 │
 *   [1 ][1 ][  ][  ][  ][  ][  ][  ]   │ 75 │
 *                                      └────┘ stack
 *
 * 칸 줄은 temperatures, 그 아래 작은 칸 줄은 answer다. 스택에서 꺼낸 날의 답이 정해지면 그날에서
 * 더 따뜻한 날까지 호를 긋고 날짜 차이(+2)를 적는다. 호는 최종 답을 미리 계산해 전부 그려 두고
 * 답이 정해진 것만 보인다.
 *
 * 그리기만 맡는다. 단계 진행(MonotonicStackWalk)과 본문 정적 그림(MonotonicStackSnapshot)이 같은
 * 컴포넌트를 쓴다. 단계 진행 스크립트가 스택 칸의 글자를 바꿀 수 있도록 온도를 data-temps에 적어 둔다.
 */
import { dailyTemperatures } from './daily-temperatures';

interface StackEntry {
  day: number;
  /** stack 기다리는 중 / active 방금 올림 / removed 방금 꺼냄 */
  state: 'stack' | 'active' | 'removed';
}

interface Props {
  temperatures: number[];
  /** 칸 상태: idle 아직 안 봄 / active 오늘 / stack 스택에서 기다림 / done 답이 정해짐 */
  cellStates: string[];
  /** 정해진 답. 아직 정해지지 않았으면 null */
  answers: (number | null)[];
  /** 이번에 답이 정해진 날 */
  fresh?: number[];
  /** 바닥부터 맨 위 순서 */
  stack: StackEntry[];
  /** 스택 칸 수. 단계 진행은 가장 높이 쌓인 순간에 맞춰 미리 그린다 */
  slots: number;
  label: string;
}

const { temperatures, cellStates, answers, fresh = [], stack, slots, label } = Astro.props;
const n = temperatures.length;
const finalAnswer = dailyTemperatures(temperatures);

const CELL = 40;
const GAP = 6;
const PITCH = CELL + GAP;
const PAD = 8;
const ANS_H = 26;
const SLOT_H = 28;
const SLOT_GAP = 4;
const SLOT_W = 50;
const STACK_INSET = 6;

// 호 높이는 날짜 차이에 비례한다. 같은 날로 모이는 호끼리 겹치지 않게 한다
const arcHeight = (d: number) => 10 + 12 * d;
const maxGap = Math.max(0, ...finalAnswer);
const arcSpace = maxGap > 0 ? arcHeight(maxGap) + 18 : 8;
const blockH = CELL + 18 + ANS_H;
const stackH = STACK_INSET * 2 + slots * SLOT_H + (slots - 1) * SLOT_GAP;
const CELL_Y = Math.max(arcSpace, stackH - blockH + 8);
const ANS_Y = CELL_Y + CELL + 18;
const BOTTOM = ANS_Y + ANS_H;

const rowRight = PAD + n * PITCH - GAP;
const SX = rowRight + 26;
const width = SX + SLOT_W + STACK_INSET * 2 + PAD;
const height = BOTTOM + 22;

const cx = (i: number) => PAD + i * PITCH + CELL / 2;
const slotY = (j: number) => BOTTOM - STACK_INSET - (j + 1) * SLOT_H - j * SLOT_GAP;

const arcs = finalAnswer
  .map((d, from) => ({ from, to: from + d, d }))
  .filter((arc) => arc.d > 0)
  .map((arc) => {
    const y = CELL_Y - 4;
    const h = arcHeight(arc.d);
    // 3차 베지어의 꼭짓점은 제어점 높이의 3/4 지점에 온다
    const c = y - h / 0.75;
    return {
      ...arc,
      path: `M ${cx(arc.from)} ${y} C ${cx(arc.from)} ${c}, ${cx(arc.to)} ${c}, ${cx(arc.to)} ${y}`,
      labelX: (cx(arc.from) + cx(arc.to)) / 2,
      labelY: y - h - 5,
    };
  });

const answerState = (day: number) => (answers[day] === null ? 'idle' : fresh.includes(day) ? 'fresh' : 'answer');
const arcState = (day: number) => (answers[day] === null || answers[day] === 0 ? null : fresh.includes(day) ? 'fresh' : 'answer');
---

{/* 칸 수가 적으면 그림이 부풀지 않도록 원래 크기 이상으로 늘리지 않는다 */}
<svg
  class="ms-fig"
  viewBox={`0 0 ${width} ${height}`}
  style={`max-width: ${width}px`}
  role="img"
  aria-label={label}
  data-ms-figure
  data-temps={JSON.stringify(temperatures)}
>
  {/* 답 호: 꺼낸 날 → 더 따뜻한 날 */}
  {
    arcs.map((arc) => (
      <g class="ms-arc" data-arc={arc.from} data-state={arcState(arc.from) ?? 'answer'} hidden={arcState(arc.from) ? undefined : true}>
        <path d={arc.path} />
        <text x={arc.labelX} y={arc.labelY} text-anchor="middle">+{arc.d}</text>
      </g>
    ))
  }

  {
    temperatures.map((t, i) => (
      <g class="ms-cell" data-cell={i} data-state={cellStates[i] ?? 'idle'}>
        <rect x={PAD + i * PITCH} y={CELL_Y} width={CELL} height={CELL} rx="8" />
        <text class="ms-temp" x={cx(i)} y={CELL_Y + CELL / 2} dy="0.36em" text-anchor="middle">{t}</text>
        <text class="ms-index" x={cx(i)} y={CELL_Y + CELL + 13} text-anchor="middle">{i}</text>
      </g>
    ))
  }

  {
    temperatures.map((_, i) => (
      <g class="ms-ans" data-ans={i} data-state={answerState(i)}>
        <rect x={PAD + i * PITCH + 3} y={ANS_Y} width={CELL - 6} height={ANS_H} rx="6" />
        <text x={cx(i)} y={ANS_Y + ANS_H / 2} dy="0.36em" text-anchor="middle">{answers[i] ?? ''}</text>
      </g>
    ))
  }
  <text class="ms-caption" x={PAD} y={BOTTOM + 16}>answer</text>

  {/* 스택: 위가 열린 통. 칸은 바닥(0)부터 쌓인다 */}
  <path
    class="ms-stack"
    d={`M ${SX} ${BOTTOM - stackH} V ${BOTTOM} H ${SX + SLOT_W + STACK_INSET * 2} V ${BOTTOM - stackH}`}
  />
  {
    Array.from({ length: slots }, (_, j) => {
      const entry = stack[j];
      return (
        <g class="ms-slot" data-slot={j} data-state={entry?.state ?? 'stack'} hidden={entry ? undefined : true}>
          <rect x={SX + STACK_INSET} y={slotY(j)} width={SLOT_W} height={SLOT_H} rx="6" />
          <text x={SX + STACK_INSET + SLOT_W / 2} y={slotY(j) + SLOT_H / 2} dy="0.36em" text-anchor="middle">
            {entry ? temperatures[entry.day] : ''}
          </text>
        </g>
      );
    })
  }
  <text class="ms-caption" x={SX + STACK_INSET + SLOT_W / 2} y={BOTTOM + 16} text-anchor="middle">stack</text>
</svg>

<style>
  /* 색 변수는 algo-theme.css의 .algo-theme가 라이트·다크별로 정의한다. */
  .ms-fig {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }

  .ms-fig [hidden],
  .ms-slot[hidden],
  .ms-arc[hidden] {
    display: none;
  }

  .ms-cell rect {
    fill: var(--node-bg);
    stroke: var(--node-line);
    stroke-width: 1.5;
    transition: fill 0.25s, stroke 0.25s;
  }

  .ms-temp {
    font-size: 18px;
    fill: var(--fg);
  }

  .ms-index {
    font-size: 12px;
    fill: var(--fg-faint);
  }

  .ms-caption {
    font-size: 12px;
    fill: var(--fg-dim);
  }

  /* 아직 보지 않은 날 */
  .ms-cell[data-state='idle'] rect {
    stroke-dasharray: 3 4;
  }

  .ms-cell[data-state='idle'] .ms-temp {
    fill: var(--node-idle-text);
  }

  /* 오늘 (i) */
  .ms-cell[data-state='active'] rect {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .ms-cell[data-state='active'] .ms-temp {
    fill: var(--exec-text);
    font-weight: 700;
  }

  /* 스택에서 더 따뜻한 날을 기다리는 날 */
  .ms-cell[data-state='stack'] rect {
    fill: var(--stack-soft);
    stroke: var(--stack);
    stroke-width: 2;
  }

  .ms-cell[data-state='stack'] .ms-temp {
    fill: var(--stack-text);
    font-weight: 700;
  }

  /* 답이 정해진 날 */
  .ms-cell[data-state='done'] rect {
    fill: var(--done-fill);
    stroke: var(--done-line);
  }

  .ms-cell[data-state='done'] .ms-temp {
    fill: var(--done-text);
  }

  .ms-ans rect {
    fill: none;
    stroke: var(--node-line);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
    transition: fill 0.25s, stroke 0.25s;
  }

  .ms-ans text {
    font-size: 16px;
    font-weight: 700;
    fill: var(--answer);
  }

  .ms-ans[data-state='answer'] rect,
  .ms-ans[data-state='fresh'] rect {
    fill: var(--answer-soft);
    stroke: var(--answer);
    stroke-dasharray: none;
  }

  .ms-ans[data-state='fresh'] rect {
    stroke-width: 2.5;
  }

  .ms-arc path {
    fill: none;
    stroke: var(--answer);
    stroke-width: 1.5;
    opacity: 0.55;
  }

  /* 다른 호가 글자 뒤를 지나가도 읽히도록 창 바탕색 테두리를 두른다 */
  .ms-arc text {
    font-size: 13px;
    font-weight: 700;
    fill: var(--answer);
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
    paint-order: stroke;
    opacity: 0.7;
  }

  .ms-arc[data-state='fresh'] path {
    stroke-width: 2.5;
    opacity: 1;
  }

  .ms-arc[data-state='fresh'] text {
    opacity: 1;
  }

  .ms-stack {
    fill: none;
    stroke: var(--fg-faint);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .ms-slot rect {
    fill: var(--stack-soft);
    stroke: var(--stack);
    stroke-width: 1.5;
  }

  .ms-slot text {
    font-size: 16px;
    font-weight: 700;
    fill: var(--stack-text);
  }

  /* 방금 올린 오늘 */
  .ms-slot[data-state='active'] rect {
    fill: var(--exec-bg);
    stroke: var(--exec);
    stroke-width: 2.5;
  }

  .ms-slot[data-state='active'] text {
    fill: var(--exec-text);
  }

  /* 방금 꺼낸 날: 한 단계 동안 취소선으로 남긴다 */
  .ms-slot[data-state='removed'] rect {
    fill: var(--removed-bg);
    stroke: var(--removed);
    stroke-dasharray: 5 3;
  }

  .ms-slot[data-state='removed'] text {
    fill: var(--removed);
    text-decoration: line-through;
  }
</style>
