---
import type { CollectionEntry } from 'astro:content';
import PostListItem from '../PostListItem.astro';
import { getRelatedPosts } from '../../utils/tags';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const related = await getRelatedPosts(post);

const formatDate = (d: Date) => d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });
---

{
  related.length > 0 && (
    <nav class="mt-10 border-t-[0.5px] border-token-primary pt-6" aria-label="관련 글">
      <h2 class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-token-secondary">함께 읽기</h2>
      <div class="mt-4 flex flex-col gap-3">
        {related.map((item) => (
          <PostListItem
            title={item.data.title}
            description={item.data.description}
            date={formatDate(item.data.pubDate)}
            image={item.data.heroImage}
            href={`${import.meta.env.BASE_URL}post/${item.id}/`}
            category={item.data.category}
            tags={item.data.tags}
          />
        ))}
      </div>
    </nav>
  )
}
