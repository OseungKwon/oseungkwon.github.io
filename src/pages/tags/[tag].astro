---
import PostListItem from '../../components/PostListItem.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getTagGroups } from '../../utils/tags';

export async function getStaticPaths() {
  const groups = await getTagGroups();
  return groups.map((group) => ({
    params: { tag: group.slug },
    props: group,
  }));
}

const { name, posts, indexable } = Astro.props;

const formatDate = (d: Date) => d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });

// 검색 결과에 그대로 노출되는 문장이라, 태그 이름과 글 수를 앞에 두고
// 실제 다루는 글 제목을 이어 붙여 무엇을 볼 수 있는 목록인지 드러낸다.
const description = `${name} 주제로 쓴 글 ${posts.length}편. ${posts
  .slice(0, 3)
  .map((post) => post.data.title)
  .join(', ')} 등을 정리했습니다.`;
---

<SiteLayout
  title={`${name} 글 모음`}
  description={description}
  breadcrumbs={[{ name: '주제별 글', href: '/tags/' }, { name, href: `/tags/${Astro.params.tag}/` }]}
  noindex={!indexable}
>
  <section class="pt-7 pb-1 sm:pt-11">
    <h1 class="max-w-4xl text-[17px] font-semibold leading-[1.6] tracking-tight text-token-primary break-keep sm:text-[19px]">
      {name} 주제로 쓴 글 {posts.length}편
    </h1>
  </section>

  <div class="mt-9 sm:mt-12">
    <div class="flex items-baseline gap-3">
      <h2 class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-token-secondary">{name}</h2>
      <span class="font-mono text-xs font-bold text-token-accent">{posts.length}</span>
    </div>
    <div class="mt-4 flex flex-col gap-3">
      {
        posts.map((post) => (
          <PostListItem
            title={post.data.title}
            description={post.data.description}
            date={formatDate(post.data.pubDate)}
            image={post.data.heroImage}
            href={`${import.meta.env.BASE_URL}post/${post.id}/`}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </div>

  <div class="mt-10 border-t-[0.5px] border-token-primary pt-6 sm:mt-14">
    <a href="/tags/" class="press inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold text-token-nav transition-colors hover:bg-token-hover hover:text-token-primary">
      ← 다른 주제 보기
    </a>
  </div>
</SiteLayout>
