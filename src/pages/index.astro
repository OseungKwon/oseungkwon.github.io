---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArchivePostItem from '../components/ArchivePostItem.astro';
import { getPublishedPosts } from '../utils/posts';
import { getTagGroups } from '../utils/tags';

const BASE = import.meta.env.BASE_URL;
const posts = (await getPublishedPosts()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateFormatter = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const formatDate = (date: Date) => dateFormatter.format(date).replaceAll('-', '.');
const groups = await getTagGroups();
---

<SiteLayout>
  <div class="home-archive">
    <h1 class="sr-only">오승의 기술블로그 글 목록</h1>
    <nav id="topics" class="topic-nav" aria-label="글 주제">
      <span class="archive-count">전체 글 <span>{posts.length}</span></span>
      <details>
        <summary>주제별로 보기</summary>
        <div class="topic-directory">
          {
            groups.map((group) => (
              <a href={`${BASE}tags/${group.slug}/`} data-astro-prefetch="tap">
                {group.name}
                <span>{group.posts.length}</span>
              </a>
            ))
          }
        </div>
      </details>
    </nav>
    <div class="post-list">
      {
        posts.map((post) => (
          <ArchivePostItem
            title={post.data.title}
            description={post.data.description}
            date={formatDate(post.data.pubDate)}
            datetime={post.data.pubDate.toISOString()}
            href={`${BASE}post/${post.id}/`}
          />
        ))
      }
    </div>
  </div>
</SiteLayout>

<style>
  .home-archive {
    max-width: 840px;
    margin-inline: auto;
    padding-block: 28px 48px;
  }
  .topic-nav {
    position: relative;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--color-border-primary);
    scroll-margin-top: 100px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }
  .archive-count {
    position: absolute;
    top: 13px;
    left: 0;
    font-weight: 600;
  }
  .archive-count span {
    margin-left: 8px;
    color: var(--color-text-date);
    font-weight: 400;
  }
  summary {
    width: fit-content;
    min-height: 44px;
    margin-left: auto;
    padding-block: 12px;
    cursor: pointer;
  }
  .topic-directory {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 20px;
    padding-block: 12px 20px;
  }
  .topic-directory a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 14px;
  }
  .topic-directory span {
    font-size: 12px;
    color: var(--color-text-date);
  }
  .topic-directory a:hover {
    color: var(--color-link);
  }
  .topic-directory a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
    border-radius: 3px;
  }
  @media (max-width: 639px) {
    .home-archive {
      padding-top: 20px;
    }
    .topic-nav {
      margin-bottom: 8px;
    }
  }
</style>
