---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import { getPublishedPosts } from '../utils/posts';
import { getTagGroups, MIN_POSTS_PER_TAG } from '../utils/tags';

const posts = (await getPublishedPosts()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (d: Date) => d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });

const [featured, ...rest] = posts;

const groups = await getTagGroups();
const topics = groups.filter((group) => group.posts.length >= MIN_POSTS_PER_TAG);
const otherTags = groups.filter((group) => group.posts.length < MIN_POSTS_PER_TAG);
---

<SiteLayout>
  <!-- 섹션 라벨이 페이지 성격을 말하므로 보이는 소개 문장은 두지 않는다.
       제목 계층은 스크린리더와 검색엔진을 위해 숨긴 h1으로 유지한다. -->
  <h1 class="sr-only">오승의 기술블로그 글 목록</h1>

  <!-- 최신 글: 카드형 featured. '지난 글'과 짝을 이루는 라벨을 달아
       카드가 시퀀스의 첫 항목으로 읽히게 한다. -->
  {
    featured && (
      <div class="pt-7 sm:pt-11">
        <h2 class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-token-secondary">최신 글</h2>
        <div class="featured-halo">
          <FeaturedPost
            title={featured.data.title}
            description={featured.data.description}
            date={formatDate(featured.data.pubDate)}
            href={`${import.meta.env.BASE_URL}post/${featured.id}/`}
            category={featured.data.category}
            tags={featured.data.tags}
          />
        </div>
      </div>
    )
  }

  <div class="mt-10 border-t-[0.5px] border-token-primary pt-6 sm:mt-14">
    <div class="flex items-baseline gap-3">
      <h2 class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-token-secondary">지난 글</h2>
      <span class="font-mono text-xs font-bold text-token-accent">{rest.length}</span>
    </div>
    <div class="mt-4 flex flex-col gap-3">
      {
        rest.map((post) => (
          <PostListItem
            title={post.data.title}
            description={post.data.description}
            date={formatDate(post.data.pubDate)}
            image={post.data.heroImage}
            href={`${import.meta.env.BASE_URL}post/${post.id}/`}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </div>

  <div id="topics" class="mt-10 scroll-mt-24 border-t-[0.5px] border-token-primary pt-6 sm:mt-14">
    <h2 class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-token-secondary">주제</h2>
    <div class="flex flex-wrap gap-2">
      {
        topics.map((group) => (
          <a
            href={`/tags/${group.slug}/`}
            data-astro-prefetch="tap"
            class="press surface flex items-center gap-2 rounded-full py-2 pr-3 pl-4 text-sm font-semibold text-token-primary"
          >
            {group.name}
            <span class="font-mono text-xs font-bold text-token-accent">{group.posts.length}</span>
          </a>
        ))
      }
    </div>
  </div>

  {
    otherTags.length > 0 && (
      <div class="mt-10 border-t-[0.5px] border-token-primary pt-6 sm:mt-14">
        {/* 글이 한 편뿐인 태그. 눌러서 볼 수는 있지만 색인에서는 빠진다. */}
        <h2 class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-token-secondary">그 외 태그</h2>
        <div class="flex flex-wrap gap-1.5">
          {otherTags.map((group) => (
            <a
              href={`/tags/${group.slug}/`}
              data-astro-prefetch="tap"
              class="press rounded-full border border-token-primary px-2.5 py-1 font-mono text-[11px] text-token-secondary transition-colors hover:border-token-accent hover:text-token-link"
            >
              #{group.name}
            </a>
          ))}
        </div>
      </div>
    )
  }
</SiteLayout>
