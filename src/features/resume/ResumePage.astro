---
import CareerIntroduction from './CareerIntroduction.astro';
import CareerOverview from './CareerOverview.astro';
import ProjectTimeline from './ProjectTimeline.astro';
import ResumeFooter from './ResumeFooter.astro';
import ResumeHeader from './ResumeHeader.astro';
import type { ResumeViewModel } from './resume';

interface Props {
  resume: ResumeViewModel;
}

const { resume } = Astro.props;
---

<article class="resume-page">
  <ResumeHeader />
  <CareerIntroduction />
  <CareerOverview />
  <ProjectTimeline
    groups={resume.featuredGroups}
    otherProjects={resume.otherProjects}
    projectCount={resume.projectCount}
    otherCount={resume.otherCount}
    yearsLabel={resume.projectYearsLabel}
  />
  <ResumeFooter lastUpdated={resume.lastUpdated} />
</article>

<style>
  .resume-page {
    width: 100%;
    max-width: 55rem;
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
    --resume-rule: var(--color-border-secondary);
    --diff-delete-bg: #ffebe9;
    --diff-delete-gutter: #ffd7d5;
    --diff-delete-text: #82071e;
    --diff-add-bg: #dafbe1;
    --diff-add-gutter: #aceebb;
    --diff-add-text: #116329;
  }

  :global(.dark) .resume-page {
    --diff-delete-bg: #3f1d1d;
    --diff-delete-gutter: #602020;
    --diff-delete-text: #ffb3ad;
    --diff-add-bg: #1b3a2a;
    --diff-add-gutter: #235d38;
    --diff-add-text: #7ee2a8;
  }

  @media (max-width: 680px) {
    .resume-page {
      padding-top: 2.5rem;
    }
  }

  @media print {
    :global(html) {
      color-scheme: light;
      font-size: 10.5pt;
    }

    /* body가 flex 컨테이너이면 main이 flex 아이템이 되어,
       Chrome이 페이지 경계에서 내용을 흘리지 못하고 잘라낸다.
       인쇄에서는 일반 블록 레이아웃으로 되돌린다. */
    :global(body),
    :global(html.dark body) {
      display: block !important;
      min-height: 0 !important;
      background: white !important;
      color: #0a0c10 !important;
    }

    :global(body::before),
    :global(body > header),
    :global(body > footer),
    :global(#reading-progress) {
      display: none !important;
    }

    :global(main) {
      display: block !important;
      flex: none !important;
      overflow: visible !important;
      max-width: none !important;
      padding: 10mm 15mm !important;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    .resume-page {
      --color-text-primary: #0a0c10;
      --color-text-secondary: #3f454e;
      --color-text-date: #707782;
      --color-accent: #006fff;
      --color-border-secondary: #d8dde5;
      --surface-bg: #ffffff;
      --surface-border: #d8dde5;
      --surface-shadow: none;
      --diff-delete-bg: #ffebe9;
      --diff-delete-gutter: #ffd7d5;
      --diff-delete-text: #82071e;
      --diff-add-bg: #dafbe1;
      --diff-add-gutter: #aceebb;
      --diff-add-text: #116329;
      display: block;
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    @page {
      size: A4;
      /* 브라우저가 페이지 여백에 자동으로 넣는 날짜·제목·URL을 제거한다.
         실제 문서 여백은 main의 print padding으로 유지한다. */
      margin: 0;
    }
  }
</style>
