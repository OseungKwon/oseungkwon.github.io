---
import type { ResumeProject, ResumeProjectGroup } from './resume';
import ProjectEntry from './ProjectEntry.astro';
import ProjectYearGroup from './ProjectYearGroup.astro';
import './ProjectTimeline.css';

interface Props {
  groups: ResumeProjectGroup[];
  otherProjects: ResumeProject[];
  projectCount: number;
  otherCount: number;
  yearsLabel: string;
}

const { groups, otherProjects, projectCount, otherCount, yearsLabel } =
  Astro.props;
---

<resume-project-timeline>
  <section class="projects-section" aria-labelledby="projects-title">
    <div class="section-title">
      <div class="section-heading">
        <h2 id="projects-title">패스오더 주요 프로젝트</h2>
        <span class="section-meta">{projectCount}개 · {yearsLabel}</span>
      </div>

      <button class="project-expand-all" type="button" aria-controls="project-list" aria-expanded="false" data-project-expand-all data-print-hidden>
        <span data-project-expand-label>전체 펼치기</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="m4 6 4 4 4-4"></path>
        </svg>
      </button>
    </div>

    <div id="project-list">
      <div class="project-year-list">
        {groups.map((group) => <ProjectYearGroup group={group} />)}
      </div>

      {
        otherCount > 0 && (
          <section class="project-other" aria-labelledby="project-other-title">
            <header class="project-other-heading">
              <h3 id="project-other-title">그 외 프로젝트</h3>
              <span>{otherCount}개</span>
            </header>

            <div class="project-other-stack">
              {otherProjects.map((project) => (
                <ProjectEntry project={project} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </section>
</resume-project-timeline>

<script src="./project-timeline.ts"></script>
