---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="resume-meta-row">
  <dt>{label}</dt>
  <dd><slot /></dd>
</div>

<style>
  .resume-meta-row {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }

  dt {
    font-size: 0.8125rem;
    font-weight: 720;
    line-height: 1.5;
    color: var(--color-text-date);
  }

  dd {
    min-width: 0;
  }

  @media print {
    .resume-meta-row {
      grid-template-columns: 13mm minmax(0, 1fr);
      gap: 3mm;
    }

    dt {
      font-size: 7.5pt;
    }
  }
</style>
