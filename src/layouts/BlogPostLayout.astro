---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PostBackButton from '../components/blog/PostBackButton.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SiteLayout from './SiteLayout.astro';
import { getTagLinks } from '../utils/tags';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const categoryLabels = { book: 'Book', tech: 'Tech' } as const;
const category = categoryLabels[post.data.category];
const dateLabel = post.data.pubDate.toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const tagLinks = await getTagLinks(post);
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage?.src}
  imageWidth={post.data.heroImage?.width}
  imageHeight={post.data.heroImage?.height}
  article
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  tags={post.data.tags}
  breadcrumbs={[{ name: post.data.title, href: `/post/${post.id}/` }]}
  container="wide"
  readingProgress
>
  <div class="mx-auto mt-6 flex max-w-4xl gap-10 sm:mt-10 xl:max-w-6xl">
    <article class="surface post-sheet min-w-0 flex-1 rounded-3xl px-5 py-8 sm:px-10 sm:py-12">
      <PostBackButton />

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-token-accent-soft px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-token-link">
          {category}
        </span>
        <span class="font-mono text-[13px] text-token-date">{dateLabel}</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold leading-[1.15] tracking-tight text-token-primary break-keep break-words sm:text-[42px]" style="scroll-margin-top: 4rem;">
        {post.data.title}
      </h1>

      {
        post.data.heroImage && (
          <div class="mt-8 overflow-hidden rounded-2xl">
            <Image
              src={post.data.heroImage}
              alt={post.data.title}
              widths={[768, 1152, 1536]}
              sizes="(min-width: 768px) 768px, 100vw"
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="high"
              class="w-full object-cover"
            />
          </div>
        )
      }

      <div class="prose prose-lg mt-8 max-w-none">
        <slot />
      </div>

      {
        tagLinks.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-1.5 border-t border-token-primary pt-6">
            {tagLinks.map(({ name, href }) =>
              // 아카이브가 열린 태그만 링크로 둔다. 글 한 편뿐인 태그는 갈 곳이 없다.
              href ? (
                <a href={href} class="press rounded-full border border-token-primary px-2.5 py-1 font-mono text-[11px] text-token-secondary transition-colors hover:border-token-accent hover:text-token-link">
                  #{name}
                </a>
              ) : (
                <span class="rounded-full border border-token-primary px-2.5 py-1 font-mono text-[11px] text-token-secondary">#{name}</span>
              ),
            )}
          </div>
        )
      }

      <RelatedPosts post={post} />
    </article>

    <TableOfContents />
  </div>
</SiteLayout>

<style>
  @media (max-width: 639px) {
    .post-sheet {
      /* main px-4(1rem) 상쇄 → 좌우 풀블리드 */
      margin-inline: -1rem;
      /* main pb-6(1.5rem) 상쇄 → 푸터와 맞닿음 */
      margin-block-end: -1.5rem;
      border-radius: 0;
      border-inline-width: 0;
      border-block-end-width: 0;
      box-shadow: none;
    }
  }
</style>
