---
import CompactHeader from '../components/site/CompactHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  noindex?: boolean;
}

const { noindex = false } = Astro.props;
---

<BaseLayout
  title="경력기술서 · 권오승"
  description="프론트엔드 개발자 권오승의 경력기술서. 패스오더에서 진행한 서비스 개발, 백오피스, 개발 플랫폼과 웹 인프라 프로젝트를 정리했습니다."
  image="/og-resume.png"
  imageWidth={1200}
  imageHeight={630}
  profile
  noindex={noindex}
  bodyClass="no-backdrop"
>
  <CompactHeader />
  <main class="mx-auto w-full max-w-6xl flex-1 px-4 pt-4 pb-6 sm:px-6 lg:px-8">
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>
